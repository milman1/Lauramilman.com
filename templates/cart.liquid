<div class="cart-page">
  <div class="cart-page__inner">

    <h1 class="cart-page__title">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}

      <div class="cart-empty">
        <p class="cart-empty__message">{{ 'sections.cart.empty' | t }}</p>
        <a href="/collections/all" class="btn btn--primary" style="margin-top:32px;">
          {{ 'sections.cart.continue_shopping' | t }}
        </a>
      </div>

    {%- else -%}

      <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">

        <div class="cart-layout">

          <div class="cart-items">

            <div class="cart-items__header">
              <span>Product</span>
              <span>Price</span>
              <span>Quantity</span>
              <span>Total</span>
            </div>

            {%- assign seen_ring_groups = '' -%}
            {%- assign incomplete_ring = false -%}
            {%- for item in cart.items -%}
              {%- assign ring_group = item.properties._lm_ring_id -%}
              {%- if ring_group != blank -%}
                {%- unless seen_ring_groups contains ring_group -%}
                  {%- assign group_total = 0 -%}
                  {%- assign group_count = 0 -%}
                  {%- assign group_quantities_valid = true -%}
                  {%- assign group_setting = 0 -%}
                  {%- assign group_bands = 0 -%}
                  {%- assign group_diamond = 0 -%}
                  {%- for part in cart.items -%}
                    {%- if part.properties._lm_ring_id == ring_group -%}
                      {%- assign group_total = group_total | plus: part.final_line_price -%}
                      {%- assign group_count = group_count | plus: 1 -%}
                      {%- if part.quantity != 1 -%}{%- assign group_quantities_valid = false -%}{%- endif -%}
                      {%- if part.product.tags contains 'ring-setting' -%}{%- assign group_setting = group_setting | plus: 1 -%}{%- endif -%}
                      {%- if part.product.type == 'Lab-Grown Diamond' or part.product.type == 'Natural Diamond' -%}{%- assign group_diamond = group_diamond | plus: 1 -%}{%- endif -%}
                      {%- if part.properties._lm_band_handle == part.product.handle -%}{%- assign group_bands = group_bands | plus: 1 -%}{%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign expected_count = group_bands | plus: 2 -%}
                  {%- unless group_count == expected_count and group_bands <= 2 and group_quantities_valid and group_setting == 1 and group_diamond == 1 -%}{%- assign incomplete_ring = true -%}{%- endunless -%}
                  <div class="cart-ring-group" style="padding:18px 0;border-top:1px solid #ddd5c5;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap">
                    <div><strong>{{ 'ring_flow.ring_group' | t }}</strong><br><a href="{{ routes.root_url }}pages/ring-builder?setting={{ item.properties._lm_setting_handle | url_encode }}&amp;diamond={{ item.properties._lm_diamond_handle | url_encode }}&amp;edit_group={{ ring_group | url_encode }}">{{ 'ring_flow.edit_ring' | t }}</a></div>
                    <span>{{ group_total | money }}</span>
                  </div>
                  {%- assign seen_ring_groups = seen_ring_groups | append: ring_group | append: ',' -%}
                {%- endunless -%}
              {%- endif -%}
              <div class="cart-item" data-key="{{ item.key }}"{% if ring_group != blank %} data-ring-group="{{ ring_group | escape }}"{% endif %}>

                <div class="cart-item__image-wrap">
                  {%- if item.image -%}
                    <a href="{{ item.url }}">
                      <img src="{{ item.image | image_url: width: 200 }}"
                           alt="{{ item.image.alt | escape }}"
                           width="100" height="100"
                           loading="lazy">
                    </a>
                  {%- endif -%}
                  <div class="cart-item__meta">
                    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                    {%- if item.properties['Size check'] != blank -%}
                      <p class="cart-item__variant">{{ 'ring_flow.size_pending' | t }}</p>
                    {%- elsif item.product.has_only_default_variant == false -%}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {%- endif -%}
                    {%- if ring_group != blank -%}
                      <dl class="cart-item__properties" style="font-size:12px;margin:10px 0;overflow-wrap:anywhere">
                        {%- for property in item.properties -%}
                          {%- assign first_character = property.first | slice: 0 -%}
                          {%- if property.last != blank and first_character != '_' -%}
                            <div><dt style="display:inline">{{ property.first | escape }}: </dt><dd style="display:inline;margin:0">{{ property.last | escape }}</dd></div>
                          {%- endif -%}
                        {%- endfor -%}
                      </dl>
                    {%- endif -%}
                    <button type="button"
                            class="cart-item__remove"
                            data-remove-key="{{ item.key }}"
                            aria-label="Remove {{ item.product.title }}">
                      {% if ring_group != blank %}{{ 'ring_flow.remove_ring' | t }}{% else %}Remove{% endif %}
                    </button>
                  </div>
                </div>

                <div class="cart-item__price">
                  {%- if item.original_price != item.final_price -%}
                    <s class="cart-item__compare-price">{{ item.original_price | money }}</s>
                  {%- endif -%}
                  <span>{{ item.final_price | money }}</span>
                </div>

                <div class="cart-item__qty">
                  {%- if ring_group != blank -%}
                    <input type="hidden" name="updates[]" value="1"><span style="font-size:12px">1</span>
                  {%- else -%}
                  <button type="button" class="cart-qty__btn" data-qty-change="{{ item.key }}" data-delta="-1" aria-label="Decrease quantity">−</button>
                  <input type="number"
                         name="updates[]"
                         value="{{ item.quantity }}"
                         min="0"
                         class="cart-qty__input"
                         data-qty-input="{{ item.key }}"
                         aria-label="Quantity for {{ item.product.title }}">
                  <button type="button" class="cart-qty__btn" data-qty-change="{{ item.key }}" data-delta="1" aria-label="Increase quantity">+</button>
                  {%- endif -%}
                </div>

                <div class="cart-item__line-total">
                  {{ item.final_line_price | money }}
                </div>

              </div>
            {%- endfor -%}

          </div>

          <aside class="cart-summary">

            <h2 class="cart-summary__title">Order Summary</h2>

            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <div class="cart-summary__row">
                <span>Subtotal</span>
                <span>{{ cart.original_total_price | money }}</span>
              </div>
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-summary__row cart-summary__row--discount">
                  <span>{{ discount.title }}</span>
                  <span>−{{ discount.total_allocated_amount | money }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}

            <div class="cart-summary__row cart-summary__row--total">
              <span>{{ 'sections.cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }} {{ cart.currency.iso_code }}</span>
            </div>

            <p class="cart-summary__tax-note">
              {%- if shop.taxes_included -%}
                Tax included. Shipping calculated at checkout.
              {%- else -%}
                Shipping and taxes calculated at checkout.
              {%- endif -%}
            </p>

            {% if incomplete_ring %}<p role="alert">{{ 'ring_flow.incomplete_ring' | t }}</p>{% endif %}
            <p data-cart-error role="alert" hidden>{{ 'ring_flow.cart_update_failed' | t }}</p>
            <button {% if incomplete_ring %}disabled data-incomplete-ring{% endif %} type="submit" name="checkout" class="btn btn--primary cart-summary__checkout-btn">
              {{ 'sections.cart.checkout' | t }}
            </button>

            <a href="/collections/all" class="cart-summary__continue-link">
              {{ 'sections.cart.continue_shopping' | t }}
            </a>

          </aside>

        </div>

      </form>

    {%- endif -%}

  </div>
</div>

<script type="application/json" data-ring-cart-config>{"root":{{ routes.root_url | json }}}</script>
<script src="{{ 'ring-builder-cart.js' | asset_url }}" defer="defer"></script>
