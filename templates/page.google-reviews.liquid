{%- comment -%}
  Google Reviews — SociableKit embed migrated from the Shopify page body
  (handle: google-reviews) so it deploys through git. The widget keeps the
  live, unedited reviews. Its colors are pulled into the homepage palette
  by assets/lmny-home.css.
{%- endcomment -%}
{{ 'lmny-home.css' | asset_url | stylesheet_tag }}

<section class="lmh lmh-reviews" aria-labelledby="GoogleReviewsTitle">
  <header class="lmh-reviews__head">
    <div>
      <p class="lmh-eyebrow">Google reviews · shown unedited</p>
      <h1 class="lmh-h2" id="GoogleReviewsTitle">Google Reviews</h1>
      <p class="lmh-lede">These reviews were written by clients and published on Google. The store does not edit them and does not add a rating of its own.</p>
      <p class="lmh-reviews__links">
        <a href="/collections/lab-grown-diamond-jewelry">Lab-Grown Jewelry</a>
        <a href="/collections/david-webb">David Webb</a>
        <a href="/pages/private-clients">Private Clients</a>
      </p>
    </div>
  </header>

  <div class="lmh-reviews__widget">
    <div class="sk-ww-google-reviews" data-embed-id="25717519"></div>
    <script src="https://widgets.sociablekit.com/google-reviews/widget.js" defer></script>
    {% render 'google-reviews-theme' %}
  </div>
</section>
