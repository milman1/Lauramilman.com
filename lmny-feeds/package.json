{
  "name": "lmny-feeds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Belgium Dia feed → Shopify catalog sync for Laura Milman New York. Optional Supabase stones dual-write prepares moving diamonds off Shopify products.",
  "scripts": {
    "sync": "tsx src/sync.ts",
    "sync:dry": "tsx src/sync.ts --dry-run",
    "sync:backvault": "tsx src/backvault/sync.ts",
    "sync:backvault:dry": "tsx src/backvault/sync.ts --dry-run",
    "seed:stones": "tsx scripts/seed-stones-from-shopify.ts",
    "confirm:lab-unpublished": "tsx scripts/confirm-lab-unpublished.ts",
    "backfill:lab-pricing": "tsx scripts/backfill-lab-pricing.ts",
    "backfill:watch-pricing": "tsx scripts/backfill-watch-pricing.ts",
    "backfill:ebay-watch-specifics": "tsx scripts/backfill-ebay-watch-specifics.ts",
    "backfill:ebay-preowned-features": "tsx scripts/fix-ebay-preowned-features.ts",
    "repair:source-watch-conditions": "tsx scripts/repair-source-watch-conditions.ts",
    "plan:royalchain-products": "tsx scripts/generate-royalchain-product-plan.ts",
    "plan:royalchain-activation": "tsx scripts/royalchain-activation-plan.ts",
    "validate:royalchain-input": "tsx scripts/validate-royalchain-input.ts",
    "upload:royalchain-media": "tsx scripts/upload-royalchain-generated-media.ts",
    "validate:jewelry-csv": "tsx scripts/validate-jewelry-csv.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.55.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  }
}
