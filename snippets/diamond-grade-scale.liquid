{%- comment -%}
  One grade scale (clarity / colour / cut) for the diamond filter.

  Shopify returns facet values ordered by count, which is meaningless on a
  grade scale, so `order` supplies the gemological sequence worst → best and
  values are rendered against it. Anything the feed produced that isn't in the
  sequence is appended, so an unexpected grade is still selectable.

  Every grade is a real checkbox bound to the published facet param; the
  "and better" behaviour is layered on top in JS, so the filter still works
  with JS off — it just selects one grade at a time.

  Accepts: filter, order (array, worst → best), title, tip
{%- endcomment -%}

<div class="lm-dfilter__group">
  <span class="lm-dfilter__label">
    {{ title }}
    <button type="button" class="lm-dfilter__info" aria-label="About {{ title | downcase }}" data-tip="{{ tip | escape }}">i</button>
  </span>

  <div class="lm-scale__row" data-scale>
    {%- for grade in order -%}
      {%- for value in filter.values -%}
        {%- if value.label == grade -%}
          <label class="lm-grade{% if value.active %} is-in-range{% endif %}" data-grade="{{ value.label | escape }}">
            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}>
            <span class="lm-grade__label">{{ value.label }}</span>
            <span class="lm-grade__count">{{ value.count }}</span>
          </label>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}

    {%- for value in filter.values -%}
      {%- unless order contains value.label -%}
        <label class="lm-grade{% if value.active %} is-in-range{% endif %}" data-grade="{{ value.label | escape }}">
          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}>
          <span class="lm-grade__label">{{ value.label }}</span>
          <span class="lm-grade__count">{{ value.count }}</span>
        </label>
      {%- endunless -%}
    {%- endfor -%}
  </div>

  <p class="lm-scale__hint" data-scale-hint>All grades</p>
</div>
