{%- comment -%}
  One grade scale (clarity / colour / cut) for the diamond filter.

  Rendered as a grade picker, not a floor slider. Shoppers can select VS2
  only — or any set of grades — instead of "VS2 and better". Each grade is
  a real checkbox bound to its published facet param.

  Shopify returns facet values ordered by count, which is meaningless here, so
  `order` supplies the gemological sequence worst → best. Grades the feed
  produced that aren't in the sequence are appended so they stay selectable.

  Each grade is still a real checkbox bound to its published facet param, so
  with JS off the scale degrades to plain multi-select rather than breaking.

  Accepts: filter, order (array, worst → best), title, tip
{%- endcomment -%}

<div class="lm-dfilter__group">
  <span class="lm-dfilter__label">
    {{ title }}
    <button type="button" class="lm-dfilter__info" aria-label="About {{ title | downcase }}" data-tip="{{ tip | escape }}">i</button>
  </span>

  <div class="lm-scale" data-scale>
    <div class="lm-scale__track" aria-hidden="true"><div class="lm-scale__fill" data-scale-fill></div></div>

    <div class="lm-scale__stops" role="group" aria-label="{{ title }}">
      {%- for grade in order -%}
        {%- for value in filter.values -%}
          {%- if value.label == grade -%}
            <label class="lm-scale__stop{% if value.active %} is-in-range{% endif %}" data-grade="{{ value.label | escape }}">
              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}>
              <span class="lm-scale__dot" aria-hidden="true"></span>
              <span class="lm-scale__name">{{ value.label }}</span>
              <span class="lm-scale__count">{{ value.count }}</span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}

      {%- for value in filter.values -%}
        {%- unless order contains value.label -%}
          <label class="lm-scale__stop{% if value.active %} is-in-range{% endif %}" data-grade="{{ value.label | escape }}">
            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}>
            <span class="lm-scale__dot" aria-hidden="true"></span>
            <span class="lm-scale__name">{{ value.label }}</span>
            <span class="lm-scale__count">{{ value.count }}</span>
          </label>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>

  <p class="lm-scale__hint" data-scale-hint>Any {{ title | downcase }}</p>
</div>
