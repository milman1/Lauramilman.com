{%- comment -%}
  Storefront chat is Shopify Inbox (Online store chat app embed).
  This snippet does not render a second bubble. It loads the Inbox bridge
  so product buttons (Ask / Direct message / Make an offer) open Inbox,
  and lifts the embed above the mobile sticky add-to-cart bar.
{%- endcomment -%}

<script src="{{ 'inbox-chat.js' | asset_url }}"></script>

<style>
  @media (max-width: 768px) {
    body.has-pdp-sticky inbox-online-store-chat#ShopifyChat,
    body.has-pdp-sticky #ShopifyChat {
      bottom: calc(110px + env(safe-area-inset-bottom, 0px)) !important;
    }
  }
</style>
