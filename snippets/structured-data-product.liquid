{% doc %}
Renders Product and BreadcrumbList JSON-LD for a product detail page.

Offers carry free insured US shipping and the return policy that matches the
store's refund policy: jewelry 14 days unworn, watches exchange only. Loose
diamonds get no return policy here, because specially sourced stones can be
final sale. additionalProperty lists only facts stored in metafields, so
nothing is parsed or inferred from the title.

@param {product} product - Product represented by the current page.
@param {variant} current_variant - Selected or first available variant.
@param {string} [collection_title] - Optional parent collection title.
@param {string} [collection_url] - Optional parent collection URL.

@example
{% render 'structured-data-product', product: product, current_variant: product.selected_or_first_available_variant %}
{% enddoc %}

{%- liquid
  assign schema_brand = product.metafields.custom.brand.value | default: product.vendor | default: shop.name | replace: 'Jacob & Company', 'Jacob & Co.' | replace: 'Jacob and Company', 'Jacob & Co.'
  if schema_brand == 'Peaceful Diamonds' or schema_brand == "Laura's Gems" or schema_brand == 'Milman New York'
    assign schema_brand = 'Laura Milman New York'
  endif
  assign schema_name = product.title | replace: 'Jacob & Company', 'Jacob & Co.' | replace: 'Jacob and Company', 'Jacob & Co.'
  assign schema_condition = product.metafields.custom.condition.value | downcase
  capture is_vintage
    render 'product-is-vintage', product: product
  endcapture
  capture schema_is_watch
    render 'product-is-watch', product: product
  endcapture
  assign schema_is_loose = false
  if product.type == 'Natural Diamond' or product.type == 'Lab-Grown Diamond'
    assign schema_is_loose = true
  endif
  assign item_condition = 'https://schema.org/NewCondition'
  if is_vintage == 'true' or schema_condition contains 'pre-owned' or schema_condition contains 'preowned' or schema_condition contains 'used'
    assign item_condition = 'https://schema.org/UsedCondition'
  endif
  assign schema_material = product.metafields.custom.metal.value | default: product.metafields.custom.metal_type.value
  assign schema_currency = cart.currency.iso_code | default: shop.currency
  assign schema_mpn = product.metafields.global['MPN'].value | default: ''
  if schema_mpn == '' and schema_is_watch == 'true'
    assign schema_mpn = product.metafields.custom.reference.value | default: ''
  endif

  assign prop_defs = 'model:Model,reference:Reference,year:Year,diamond_shape:Diamond shape,carat_weight:Carat weight,case_size:Case size,metal:Metal,dial:Dial,bezel:Bezel,bracelet:Bracelet,color:Color,clarity:Clarity,cut:Cut,condition:Condition,condition_grade:Condition grade,setting_style:Setting style,length:Length,box:Box,papers:Papers' | split: ','
  assign feed_defs = 'lab:Grading lab,cert_number:Certificate number,polish:Polish,symmetry:Symmetry,fluorescence:Fluorescence,measurements:Measurements' | split: ','
-%}

{%- capture schema_shipping -%}
  "shippingDetails": {
    "@type": "OfferShippingDetails",
    "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": {{ schema_currency | json }} },
    "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" }
  }
{%- endcapture -%}

{%- capture schema_returns -%}
  {%- if schema_is_watch == 'true' -%}
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "US",
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
    }
  {%- elsif schema_is_loose == false -%}
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "US",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 14,
      "returnMethod": "https://schema.org/ReturnByMail"
    }
  {%- endif -%}
{%- endcapture -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ canonical_url | append: '#product' | json }},
  "name": {{ schema_name | json }},
  "description": {{ product.description | strip_html | strip | truncate: 500 | json }},
  "url": {{ canonical_url | json }},
  "image": [
    {%- for image in product.images limit: 10 -%}
      {{ image | image_url: width: 1200 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "brand": {
    "@type": "Brand",
    "name": {{ schema_brand | json }}
  },
  "sku": {{ current_variant.sku | json }},
  "category": {{ product.type | json }},
  "itemCondition": {{ item_condition | json }},
  "offers": [
    {%- for variant in product.variants limit: 50 -%}
      {
        "@type": "Offer",
        "url": {{ shop.url | append: variant.url | json }},
        {%- if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
        {%- if product.variants.size > 1 %}"name": {{ schema_name | append: ' – ' | append: variant.title | json }},{% endif %}
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ schema_currency | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": {{ item_condition | json }},
        "seller": { "@id": {{ shop.url | append: '/#organization' | json }} },
        {{ schema_shipping }}
        {%- if schema_returns != blank -%},{{ schema_returns }}{%- endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- if schema_material != blank -%}
    ,"material": {{ schema_material | json }}
  {%- endif -%}
  {%- if schema_mpn != '' -%}
    ,"mpn": {{ schema_mpn | json }}
  {%- endif -%}
  {%- assign prop_written = false -%}
  {%- capture schema_props -%}
    {%- for def in prop_defs -%}
      {%- assign def_parts = def | split: ':' -%}
      {%- assign prop_value = product.metafields.custom[def_parts[0]].value | strip -%}
      {%- if prop_value != blank and prop_value != '—' and prop_value != '-' -%}
        {%- if prop_written %},{% endif -%}
        { "@type": "PropertyValue", "name": {{ def_parts[1] | json }}, "value": {{ prop_value | json }} }
        {%- assign prop_written = true -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if schema_is_loose -%}
      {%- for def in feed_defs -%}
        {%- assign def_parts = def | split: ':' -%}
        {%- assign prop_value = product.metafields.lmny_feed[def_parts[0]].value | strip -%}
        {%- if prop_value != blank and prop_value != 'UNCERTIFIED' and prop_value != '—' and prop_value != '-' -%}
          {%- if prop_written %},{% endif -%}
          { "@type": "PropertyValue", "name": {{ def_parts[1] | json }}, "value": {{ prop_value | json }} }
          {%- assign prop_written = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}
  {%- if prop_written -%}
    ,"additionalProperty": [{{ schema_props }}]
  {%- endif -%}
}
</script>

{%- comment -%}
  VideoObject for the product video, so Google can show a video thumbnail in
  search. A video stored on the product wins; otherwise the supplier video an
  estate piece plays by link (backvault_feed.video). Written only when a
  thumbnail and a file URL are both known, which Google requires.
{%- endcomment -%}
{%- liquid
  assign vo_content = ''
  assign vo_thumb = ''
  assign vo_ms = 0
  assign vo_uploaded = product.published_at | default: product.created_at
  assign vo_native = product.media | where: 'media_type', 'video' | first
  if vo_native
    for vo_source in vo_native.sources
      if vo_source.format == 'mp4'
        assign vo_content = vo_source.url
        break
      endif
    endfor
    if vo_native.preview_image
      assign vo_thumb = vo_native.preview_image | image_url: width: 1200 | prepend: 'https:'
    endif
    assign vo_ms = vo_native.duration | default: 0
  else
    assign vo_feed = product.metafields.backvault_feed.video.value
    if vo_feed.sources.size > 0
      for vo_source in vo_feed.sources
        if vo_source.type == 'video/mp4'
          assign vo_content = vo_source.url
          break
        endif
      endfor
      if vo_feed.poster != blank
        assign vo_thumb = vo_feed.poster
      elsif product.featured_image
        assign vo_thumb = product.featured_image | image_url: width: 1200 | prepend: 'https:'
      endif
      assign vo_ms = vo_feed.durationMs | default: 0
      assign vo_checked = product.metafields.backvault_feed.video_checked_at.value
      if vo_checked != blank
        assign vo_uploaded = vo_checked
      endif
    endif
  endif
  # Shopify writes stored-media URLs protocol-relative ("//host/…"); Google
  # needs absolute ones.
  if vo_content != blank and vo_content contains '//'
    assign vo_lead = vo_content | slice: 0, 2
    if vo_lead == '//'
      assign vo_content = vo_content | prepend: 'https:'
    endif
  endif
  assign vo_seconds = vo_ms | divided_by: 1000 | floor
  assign vo_description = product.description | strip_html | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&#39;', "'" | replace: '&quot;', '"' | strip_newlines | strip | truncate: 300
  if vo_description == blank
    assign vo_description = schema_name | append: ' — Laura Milman New York'
  endif
-%}
{%- if vo_content != blank and vo_thumb != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": {{ schema_name | append: ' — video' | json }},
  "description": {{ vo_description | json }},
  "thumbnailUrl": [{{ vo_thumb | json }}],
  "uploadDate": {{ vo_uploaded | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
  "contentUrl": {{ vo_content | json }}
  {%- if vo_seconds > 0 %},
  "duration": {{ 'PT' | append: vo_seconds | append: 'S' | json }}
  {%- endif %}
}
</script>
{%- endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | append: routes.root_url | json }}
    }
    {%- if collection_title != blank and collection_url != blank -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection_title | json }},
        "item": {{ shop.url | append: collection_url | json }}
      }
    {%- endif -%}
    ,{
      "@type": "ListItem",
      "position": {% if collection_title != blank and collection_url != blank %}3{% else %}2{% endif %},
      "name": {{ schema_name | json }},
      "item": {{ canonical_url | json }}
    }
  ]
}
</script>
