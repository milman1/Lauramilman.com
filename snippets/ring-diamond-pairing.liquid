{%- comment -%}
  Ring page → loose diamonds that fit it.
  Rendered by sections/main-product.liquid on engagement rings whose
  center-stone shape is stated (custom.diamond_shape or a shape tag).

  Without a chosen diamond: links to natural and lab-grown loose diamonds
  of the same shape (the collections' native shape filter).
  With one (?diamond=<handle> from a diamond page, remembered for the
  visit): shows it beside the ring with a "Request this pairing" chat.

  Checkout: rings are priced with their own center stone, so buying the
  ring with the shopper's diamond needs a setting-only price. Those live on
  one hidden product (section setting "Setting-only product"), one variant
  per ring, SKU "SET-<ring handle>", or "SET-<ring handle>-<option value>"
  when the price differs by a ring option such as 14K / 18K. Labor to set
  the stone is included in that price. When a ring has an available
  setting variant, the panel shows setting + diamond = total and adds both
  to the cart; otherwise the pairing stays a quote request.
  A product tagged ring-setting is itself sold without a center stone, so
  its own selected variant is the setting.

  Accepts:
  - product: the ring
  - is_watch: 'true' for watches
  - setting_product: the hidden setting-only product (optional)
  - builder: true on the ring-builder template. The panel then lists matching
    diamonds from the stone search API on the page (builder_api_base,
    builder_api_key), each with the ring total, and keeps the setting and
    chosen diamond in sessionStorage lmBuilder for the "Your ring" bar and the
    builder diamond search (collection template suffix builder_view).
{%- endcomment -%}

{%- capture is_er -%}{% render 'is-engagement-ring', product: product %}{%- endcapture -%}
{%- capture ring_shape -%}{% render 'center-stone-shape', product: product %}{%- endcapture -%}
{%- assign ring_shape = ring_shape | strip -%}

{%- if is_er == 'true' and ring_shape != '' and is_watch != 'true' and product.tags contains 'ring-setting' -%}
  {%- liquid
    assign ring_title = product.title | replace: 'Jacob & Company', 'Jacob & Co.'
    assign ring_image = ''
    if product.featured_image
      assign ring_image = product.featured_image | image_url: width: 240
    endif
    assign shape_l = ring_shape | downcase
    assign shape_q = ring_shape | url_encode

    # Setting-only variants for this ring, matched by SKU.
    assign sku_base = 'SET-' | append: product.handle | downcase
    assign sku_prefix = sku_base | append: '-'
    assign setting_json = ''
    assign is_setting = false
    if product.tags contains 'ring-setting'
      assign is_setting = true
      for v in product.variants
        if v.available
          capture setting_json
            echo setting_json
            unless setting_json == ''
              echo ','
            endunless
            echo '{"id":'
            echo v.id
            echo ',"self":true,"price":'
            echo v.price
            echo '}'
          endcapture
        endif
      endfor
    elsif setting_product != blank
      for v in setting_product.variants
        assign v_sku = v.sku | downcase
        assign v_head = v_sku | slice: 0, sku_prefix.size
        assign v_match = false
        if v_sku == sku_base or v_head == sku_prefix
          assign v_match = v.available
        endif
        if v_match
          capture setting_json
            echo setting_json
            unless setting_json == ''
              echo ','
            endunless
            echo '{"id":'
            echo v.id
            echo ',"sku":'
            echo v_sku | json
            echo ',"price":'
            echo v.price
            echo '}'
          endcapture
        endif
      endfor
    endif

    # Ring option names, to record the shopper's choices (size, metal) on the order.
    assign option_names = product.options | json

    assign builder_on = false
    if builder and is_setting and builder_api_base != blank
      assign builder_on = true
    endif
    assign builder_view = builder_view | default: 'ring-builder' | handleize
    assign search_extra = ''
    if builder_on
      assign search_extra = '&view=' | append: builder_view | append: '&ring=' | append: product.handle
    endif
  -%}
  <div
    class="pdp-pair"
    id="RingPairing"
    data-pair
    data-ring-shape="{{ ring_shape }}"
    data-ring-handle="{{ product.handle }}"
    data-ring-title="{{ ring_title | escape }}"
    data-ring-url="{{ shop.url }}{{ product.url }}"
    data-ring-image="{{ ring_image | escape }}"
    data-currency="{{ cart.currency.iso_code | default: 'USD' }}"
    data-setting-base="{{ sku_base | escape }}"
    data-option-names="{{ option_names | escape }}"
    {%- if builder_on %}
    data-builder="true"
    data-builder-view="{{ builder_view }}"
    data-api-base="{{ builder_api_base | escape }}"
    data-api-key="{{ builder_api_key | escape }}"
    {%- endif %}
  >
    <script type="application/json" data-pair-settings>[{{ setting_json }}]</script>
    <p class="pdp-inquire__label">Choose your own diamond</p>

    <div data-pair-browse>
      {%- if is_setting -%}
        {%- assign center_phrase = shape_l | append: '-cut' -%}
        {%- if product.title contains 'Elongated Cushion' -%}
          {%- assign center_phrase = 'elongated cushion' -%}
        {%- endif -%}
        <p class="pdp-pair__text">This setting is sold without a center stone. It takes {{ center_phrase }} center stones. Pick the {{ shape_l }} diamond you want and we will set it for you. Measurements are checked against the head before the ring is made.</p>
      {%- else -%}
        <p class="pdp-pair__text">This setting takes {{ shape_l }}-cut center stones. Pick the {{ shape_l }} diamond you want and we will set it for you.</p>
      {%- endif -%}
      <p class="pdp-pair__warn" data-pair-mismatch hidden></p>
      {%- if builder_on -%}
        <div class="rbc" data-rbc>
          <div class="rbc__tabs" role="group" aria-label="Diamond origin">
            <button type="button" class="rbc__tab is-active" data-rbc-kind="lab" aria-pressed="true">Lab-grown</button>
            <button type="button" class="rbc__tab" data-rbc-kind="natural" aria-pressed="false">Natural</button>
          </div>
          <div class="rbc__bands" role="group" aria-label="Carat">
            <button type="button" class="rbc__band is-active" data-rbc-band="" aria-pressed="true">Any carat</button>
            <button type="button" class="rbc__band" data-rbc-band="0.3-0.99" aria-pressed="false">Under 1 ct</button>
            <button type="button" class="rbc__band" data-rbc-band="1-1.49" aria-pressed="false">1–1.49 ct</button>
            <button type="button" class="rbc__band" data-rbc-band="1.5-1.99" aria-pressed="false">1.5–1.99 ct</button>
            <button type="button" class="rbc__band" data-rbc-band="2-2.99" aria-pressed="false">2–2.99 ct</button>
            <button type="button" class="rbc__band" data-rbc-band="3-" aria-pressed="false">3 ct +</button>
          </div>
          <p class="rbc__status" data-rbc-status role="status">Loading {{ shape_l }} diamonds…</p>
          <ul class="rbc__list" role="list" data-rbc-list></ul>
        </div>
      {%- endif -%}
      <div class="pdp-inquire__actions">
        {%- if is_setting and builder_on == false and product.tags contains 'ring-setting' -%}
          <a class="pdp-inquire__btn" href="/pages/ring-builder?setting={{ product.handle | url_encode }}">Choose a {{ shape_l }} diamond in the ring builder</a>
        {%- endif -%}
        <a class="pdp-inquire__btn{% if is_setting and builder_on == false and product.tags contains 'ring-setting' %} pdp-inquire__btn--ghost{% endif %}" href="/collections/lab-grown-diamonds?shape={{ shape_q }}{{ search_extra }}" data-rbc-search>{% if builder_on %}All {{ shape_l }} lab-grown diamonds{% else %}{{ ring_shape }} lab-grown diamonds{% endif %}</a>
        <a class="pdp-inquire__btn pdp-inquire__btn--ghost" href="/collections/natural-diamonds?shape={{ shape_q }}{{ search_extra }}" data-rbc-search>{% if builder_on %}All {{ shape_l }} natural diamonds{% else %}{{ ring_shape }} natural diamonds{% endif %}</a>
      </div>
    </div>

    <div data-pair-chosen hidden>
      <a class="pdp-pair__stone" href="#" data-pair-stone-link>
        <img src="" alt="" width="64" height="64" loading="lazy" data-pair-stone-img>
        <span class="pdp-pair__stone-text">
          <span class="pdp-pair__stone-title" data-pair-stone-title></span>
          <span class="pdp-pair__stone-price" data-pair-stone-price></span>
        </span>
      </a>
      <div class="pdp-pair__sum" data-pair-sum hidden>
        <div class="pdp-pair__row"><span>Setting, without center stone</span><span data-pair-setting-price></span></div>
        <div class="pdp-pair__row"><span>Your diamond</span><span data-pair-diamond-price></span></div>
        <div class="pdp-pair__row"><span>Setting your diamond</span><span>Included</span></div>
        <div class="pdp-pair__row pdp-pair__row--total"><span>Total</span><span data-pair-total></span></div>
      </div>
      <p class="pdp-pair__text" data-pair-buy-note hidden>We set your diamond by hand and confirm every detail with you before your ring is made.</p>
      {%- if is_setting -%}
        <p class="pdp-pair__text" data-pair-quote-note>This setting is sold without a center stone. Request the pairing and we will confirm availability and every detail before anything is made.</p>
      {%- else -%}
        <p class="pdp-pair__text" data-pair-quote-note>The ring price above includes our own center stone. We will quote this setting with your diamond and confirm every detail before anything is made.</p>
      {%- endif -%}
      <p class="pdp-pair__warn" data-pair-error role="alert" hidden></p>
      <div class="pdp-inquire__actions">
        <button type="button" class="pdp-inquire__btn" data-pair-buy hidden>Add ring with this diamond</button>
        <button
          type="button"
          class="pdp-inquire__btn js-open-product-chat"
          data-chat-intent="pair"
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          data-product-title="{{ ring_title | escape }}"
          data-product-url="{{ shop.url }}{{ product.url }}"
          data-product-image="{{ ring_image | escape }}"
          data-pair-title=""
          data-pair-url=""
          data-pair-request
        >
          Request this pairing
        </button>
        <button type="button" class="pdp-inquire__btn pdp-inquire__btn--ghost" data-pair-clear>Choose a different diamond</button>
      </div>
    </div>
  </div>

  <style>
    .pdp-pair {
      margin: 1.25rem 0 0;
      padding-top: 1.15rem;
      border-top: 1px solid var(--rule-light, #DDD5C5);
    }
    .pdp-pair__text,
    .pdp-pair__warn {
      margin: 0 0 0.85rem;
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.82rem;
      line-height: 1.7;
      color: var(--text-muted, #8A8070);
    }
    .pdp-pair__warn { color: var(--wine, #4A1428); }
    .pdp-pair [hidden] { display: none !important; }
    .pdp-pair__stone {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin: 0 0 0.85rem;
      padding: 0.75rem;
      border: 1px solid var(--gold, #C9A050);
      border-radius: var(--radius-md, 8px);
      background: var(--warm-white, #FDFAF6);
      color: var(--text-dark, #2C1810);
      text-decoration: none;
    }
    .pdp-pair__stone img {
      width: 64px;
      height: 64px;
      flex: none;
      object-fit: cover;
      border-radius: var(--radius-sm, 4px);
      background: var(--cream, #FAF6F0);
    }
    .pdp-pair__stone-text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
    .pdp-pair__stone-title {
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.85rem;
      font-weight: 500;
      line-height: 1.4;
    }
    .pdp-pair__stone-price {
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.8rem;
      color: var(--gold-dark, #A88340);
    }
    .pdp-pair__sum {
      margin: 0 0 0.85rem;
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.85rem;
      color: var(--text-dark, #2C1810);
    }
    .pdp-pair__row {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.35rem 0;
      border-bottom: 1px solid var(--border-light, #E8E2D8);
    }
    .pdp-pair__row span:last-child { white-space: nowrap; }
    .pdp-pair__row--total { font-weight: 600; border-bottom: 0; padding-top: 0.6rem; }
    .rbc { margin: 0 0 1rem; font-family: var(--font-body, 'Montserrat', sans-serif); }
    .rbc__tabs { display: flex; gap: 0.25rem; border-bottom: 1px solid var(--border-light, #E8E2D8); margin-bottom: 0.75rem; }
    .rbc__tab {
      min-height: 44px; padding: 0 1rem; border: 0; border-bottom: 2px solid transparent; background: none;
      font: inherit; font-size: 0.8rem; letter-spacing: 0.04em; color: var(--text-muted-dark, #6B6152); cursor: pointer;
    }
    .rbc__tab.is-active { border-bottom-color: var(--text-dark, #2C1810); color: var(--text-dark, #2C1810); font-weight: 600; }
    .rbc__bands { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; }
    .rbc__band {
      min-height: 40px; padding: 0 0.8rem; border: 1px solid var(--rule-light, #DDD5C5); border-radius: var(--radius-sm, 4px);
      background: #fff; font: inherit; font-size: 0.75rem; color: var(--text-dark, #2C1810); cursor: pointer;
    }
    .rbc__band:hover { border-color: var(--gold, #C9A050); }
    .rbc__band.is-active { border-color: var(--text-dark, #2C1810); box-shadow: inset 0 0 0 1px var(--text-dark, #2C1810); font-weight: 600; }
    .rbc__status { margin: 0 0 0.6rem; font-size: 0.78rem; color: var(--text-muted-dark, #6B6152); }
    .rbc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .rbc__item {
      display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; grid-template-areas: "img text prices" "img text choose";
      gap: 0.25rem 0.85rem; align-items: center; padding: 0.6rem 0.75rem;
      border: 1px solid var(--border-light, #E8E2D8); border-radius: var(--radius-md, 8px); background: #fff;
    }
    @media (min-width: 600px) {
      .rbc__item { grid-template-columns: 56px minmax(0, 1fr) auto auto; grid-template-areas: "img text prices choose"; }
    }
    .rbc__img { grid-area: img; width: 56px; height: 56px; object-fit: cover; border-radius: var(--radius-sm, 4px); background: var(--cream, #FAF6F0); }
    .rbc__text { grid-area: text; display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
    .rbc__title { font-size: 0.85rem; font-weight: 600; color: var(--text-dark, #2C1810); text-decoration: none; }
    .rbc__title:hover { text-decoration: underline; }
    .rbc__meta { font-size: 0.74rem; color: var(--text-muted-dark, #6B6152); }
    .rbc__prices { grid-area: prices; display: flex; flex-direction: column; align-items: flex-end; gap: 0.1rem; font-size: 0.8rem; white-space: nowrap; }
    .rbc__ring { font-weight: 600; color: var(--text-dark, #2C1810); }
    .rbc__choose {
      grid-area: choose; justify-self: end; min-height: 44px; padding: 0 1.1rem; border: 1px solid var(--text-dark, #2C1810);
      border-radius: 999px; background: var(--text-dark, #2C1810); color: var(--warm-white, #FDFAF6);
      font: inherit; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer;
    }
    .rbc__choose:hover { background: #4a2c1f; }
    .rbc__choose:disabled { opacity: 0.6; cursor: wait; }
  </style>

  <script>
    (function () {
      var root = document.querySelector('[data-pair]');
      if (!root) return;
      var SHAPES = ['Round', 'Princess', 'Cushion', 'Emerald', 'Oval', 'Radiant', 'Asscher', 'Marquise', 'Heart', 'Pear'];
      var DIAMOND_TYPES = ['Natural Diamond', 'Lab-Grown Diamond'];
      var HANDLE = /^[a-z0-9][a-z0-9-]{0,99}$/;
      var ringShape = root.getAttribute('data-ring-shape');
      var browse = root.querySelector('[data-pair-browse]');
      var chosen = root.querySelector('[data-pair-chosen]');
      var mismatch = root.querySelector('[data-pair-mismatch]');
      var request = root.querySelector('[data-pair-request]');
      var buy = root.querySelector('[data-pair-buy]');
      var pairError = root.querySelector('[data-pair-error]');
      var ringForm = document.querySelector('form[data-product-form]');
      var settings = [];
      try { settings = JSON.parse(root.querySelector('[data-pair-settings]').textContent) || []; } catch (e) {}
      var optionNames = [];
      try { optionNames = JSON.parse(root.getAttribute('data-option-names')) || []; } catch (e) {}
      var stone = null;

      function store(key, value) {
        try {
          if (value == null) sessionStorage.removeItem(key);
          else sessionStorage.setItem(key, JSON.stringify(value));
        } catch (e) {}
      }
      function read(key) {
        try { return JSON.parse(sessionStorage.getItem(key) || 'null'); } catch (e) { return null; }
      }

      // Let a diamond page offer "set it in the ring you were viewing".
      store('lmPairRing', {
        handle: root.getAttribute('data-ring-handle'),
        title: root.getAttribute('data-ring-title'),
        shape: ringShape
      });

      function shapeOf(title) {
        for (var i = 0; i < SHAPES.length; i++) {
          if (new RegExp('\\b' + SHAPES[i] + '\\b', 'i').test(title)) return SHAPES[i];
        }
        return '';
      }

      function money(cents) {
        try {
          return new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: root.getAttribute('data-currency') || 'USD',
            maximumFractionDigits: 0
          }).format(cents / 100);
        } catch (e) {
          return '$' + Math.round(cents / 100).toLocaleString('en-US');
        }
      }

      var builderOn = root.getAttribute('data-builder') === 'true';
      var ringHandle = root.getAttribute('data-ring-handle');

      // Ring builder: the setting (with the chosen size/metal variant) and the
      // diamond, kept for the visit so the "Your ring" bar and the builder
      // diamond search can show them. diamond undefined keeps the stored one
      // when it still fits this ring's shape.
      function saveBuilder(diamond) {
        if (!builderOn) return;
        var prev = read('lmBuilder') || {};
        if (diamond === undefined) {
          diamond = prev.diamond && prev.ring && prev.ring.shape === ringShape ? prev.diamond : null;
        }
        var setting = settingVariant();
        store('lmBuilder', {
          ring: {
            handle: ringHandle,
            title: root.getAttribute('data-ring-title'),
            shape: ringShape,
            image: root.getAttribute('data-ring-image'),
            path: '/products/' + ringHandle + '?view=' + encodeURIComponent(root.getAttribute('data-builder-view') || 'ring-builder'),
            variant: setting ? setting.id : null,
            options: ringChoices().map(function (c) { return /size/i.test(c.name) ? 'Size ' + c.value : c.value; }).join(' · '),
            price: setting ? setting.price : null
          },
          diamond: diamond || null
        });
        try { document.dispatchEvent(new CustomEvent('lm:builder-change')); } catch (e) {}
      }

      function showBrowse(note) {
        chosen.hidden = true;
        browse.hidden = false;
        mismatch.hidden = !note;
        mismatch.textContent = note || '';
      }

      // The ring options the shopper picked (size, metal), from the variant select.
      function ringChoices() {
        var sel = ringForm && ringForm.querySelector('select[name="id"]');
        var opt = sel && sel.options[sel.selectedIndex];
        var values = [];
        try { values = JSON.parse((opt && opt.getAttribute('data-options')) || '[]'); } catch (e) {}
        var out = [];
        values.forEach(function (v, i) {
          var name = optionNames[i] || '';
          if (!v || v === 'Default Title' || /carat/i.test(name)) return;
          out.push({ name: name, value: v });
        });
        return out;
      }

      // SET-<handle>-<option value> wins over SET-<handle> when it matches a choice.
      function settingVariant() {
        // A setting product sells its own selected variant.
        if (settings.length && settings[0].self) {
          var sel = ringForm && ringForm.querySelector('select[name="id"]');
          var current = sel ? String(sel.value) : '';
          for (var i = 0; i < settings.length; i++) {
            if (String(settings[i].id) === current) return settings[i];
          }
          return null;
        }
        var base = root.getAttribute('data-setting-base');
        var picked = ringChoices().map(function (c) { return String(c.value).toLowerCase().replace(/\s+/g, '-'); });
        var exact = null;
        var specific = null;
        settings.forEach(function (v) {
          if (v.sku === base) exact = v;
          else if (picked.some(function (val) { return v.sku === base + '-' + val; })) specific = v;
        });
        return specific || exact;
      }

      function renderSum() {
        var setting = stone && settingVariant();
        var canBuy = !!(setting && stone.variants && stone.variants[0]);
        root.querySelector('[data-pair-sum]').hidden = !canBuy;
        root.querySelector('[data-pair-buy-note]').hidden = !canBuy;
        root.querySelector('[data-pair-quote-note]').hidden = canBuy;
        buy.hidden = !canBuy;
        request.classList.toggle('pdp-inquire__btn--ghost', canBuy);
        if (!canBuy) return;
        root.querySelector('[data-pair-setting-price]').textContent = money(setting.price);
        root.querySelector('[data-pair-diamond-price]').textContent = money(stone.price);
        root.querySelector('[data-pair-total]').textContent = money(setting.price + stone.price);
      }

      function showChosen(p) {
        stone = p;
        var url = window.location.origin + '/products/' + p.handle;
        var img = root.querySelector('[data-pair-stone-img]');
        root.querySelector('[data-pair-stone-link]').href = '/products/' + p.handle;
        root.querySelector('[data-pair-stone-title]').textContent = p.title;
        root.querySelector('[data-pair-stone-price]').textContent = money(p.price);
        if (p.featured_image) {
          img.src = p.featured_image;
          img.alt = p.title;
        } else {
          img.hidden = true;
        }
        request.setAttribute('data-pair-title', p.title);
        request.setAttribute('data-pair-url', url);
        browse.hidden = true;
        chosen.hidden = false;
        renderSum();
        saveBuilder({ handle: p.handle, title: p.title, price: p.price, image: p.featured_image || '' });
      }

      function refresh() {
        renderSum();
        if (!builderOn) return;
        renderStones();
        updateSearchLinks();
        saveBuilder();
      }

      if (ringForm) {
        ringForm.addEventListener('click', function (e) {
          if (e.target.closest('[data-option-group]')) setTimeout(refresh, 0);
        });
      }

      buy.addEventListener('click', function () {
        var setting = settingVariant();
        if (!stone || !setting) return;
        var ringTitle = root.getAttribute('data-ring-title');
        // Engraving and any other properties the shopper added on the ring form.
        var props = (ringForm && typeof window.formLineProperties === 'function') ? window.formLineProperties(ringForm) : {};
        props.Ring = ringTitle;
        props.Diamond = stone.title;
        ringChoices().forEach(function (c) { if (c.name) props[c.name] = c.value; });
        buy.disabled = true;
        pairError.hidden = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            items: [
              { id: setting.id, quantity: 1, properties: props },
              { id: stone.variants[0].id, quantity: 1, properties: { 'Set in': ringTitle } }
            ]
          })
        })
          .then(function (res) {
            return res.json().then(function (data) {
              if (!res.ok || data.status) throw new Error(data.description || 'cart');
              window.location.href = '/cart';
            });
          })
          .catch(function () {
            buy.disabled = false;
            pairError.textContent = 'We could not add this pairing to your cart. Please try again, or request it below.';
            pairError.hidden = false;
          });
      });

      // fromUser: the shopper just picked this stone (link or chooser), so a
      // stone that does not fit gets an explanation instead of silence.
      function loadStone(handle, fromUser, done) {
        return fetch('/products/' + handle + '.js', { headers: { Accept: 'application/json' } })
          .then(function (res) { return res.ok ? res.json() : null; })
          .then(function (p) {
            if (!p || DIAMOND_TYPES.indexOf(p.type) === -1) {
              store('lmPairDiamond', null);
              saveBuilder(null);
              if (fromUser) showBrowse('That diamond is no longer available. Choose another below.');
              return false;
            }
            var stoneShape = shapeOf(p.title);
            if (stoneShape !== ringShape) {
              // A remembered stone that doesn't fit this ring is left quietly;
              // one the shopper just sent here gets an explanation.
              if (fromUser) {
                showBrowse('The diamond you chose is ' + (stoneShape ? stoneShape.toLowerCase() + '-cut' : 'a different shape') + '. This setting takes ' + ringShape.toLowerCase() + '-cut center stones.');
              }
              return false;
            }
            if (!p.available) {
              store('lmPairDiamond', null);
              saveBuilder(null);
              if (fromUser) showBrowse('That diamond is no longer available. Choose another below.');
              return false;
            }
            store('lmPairDiamond', { handle: p.handle });
            showChosen(p);
            return true;
          })
          .catch(function () { return false; });
      }

      /* ── Ring builder: matching diamonds listed on the page ── */
      var rbc = builderOn ? root.querySelector('[data-rbc]') : null;
      var rbcState = { kind: 'lab', band: '', stones: [], total: 0, req: 0 };

      function stoneHandle(stone) {
        var ref = String(stone.stock_ref || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
        return (stone.kind === 'natural' ? 'nd-' : 'lg-') + ref;
      }

      function updateSearchLinks() {
        var setting = settingVariant();
        root.querySelectorAll('[data-rbc-search]').forEach(function (a) {
          var u = new URL(a.getAttribute('href'), window.location.origin);
          if (setting) u.searchParams.set('variant', setting.id);
          else u.searchParams.delete('variant');
          a.setAttribute('href', u.pathname + u.search);
        });
      }

      function renderStones() {
        if (!rbc) return;
        var list = rbc.querySelector('[data-rbc-list]');
        var status = rbc.querySelector('[data-rbc-status]');
        var setting = settingVariant();
        var shapeL = ringShape.toLowerCase();
        var noun = rbcState.kind === 'natural' ? 'natural' : 'lab-grown';
        list.textContent = '';
        if (rbcState.error) {
          status.textContent = 'Diamonds could not load. Use the search links below.';
          return;
        }
        if (!rbcState.stones.length) {
          status.textContent = rbcState.loading ? 'Loading ' + shapeL + ' diamonds…' : 'No ' + noun + ' ' + shapeL + ' diamonds in this carat range. Try another range.';
          return;
        }
        status.textContent = rbcState.total.toLocaleString('en-US') + ' ' + noun + ' ' + shapeL + ' diamonds fit this setting. Lowest prices first.' + (setting ? '' : ' Choose a size to see ring totals.');
        rbcState.stones.slice(0, 8).forEach(function (stone) {
          var handle = stoneHandle(stone);
          var cents = Math.round(Number(stone.retail_usd) * 100);
          var title = Number(stone.carat).toFixed(2) + ' ct ' + (stone.shape || ringShape);
          var li = document.createElement('li');
          li.className = 'rbc__item';
          var img = document.createElement('img');
          img.className = 'rbc__img';
          img.width = 56;
          img.height = 56;
          img.loading = 'lazy';
          img.alt = '';
          if (stone.image_urls && stone.image_urls[0]) img.src = stone.image_urls[0];
          li.appendChild(img);
          var text = document.createElement('span');
          text.className = 'rbc__text';
          var link = document.createElement('a');
          link.className = 'rbc__title';
          link.href = '/products/' + handle;
          link.textContent = title;
          var meta = document.createElement('span');
          meta.className = 'rbc__meta';
          meta.textContent = [stone.color, stone.clarity, stone.cut, stone.lab].filter(Boolean).join(' · ');
          text.appendChild(link);
          text.appendChild(meta);
          li.appendChild(text);
          var prices = document.createElement('span');
          prices.className = 'rbc__prices';
          var price = document.createElement('span');
          price.textContent = 'Diamond ' + money(cents);
          prices.appendChild(price);
          if (setting) {
            var ring = document.createElement('span');
            ring.className = 'rbc__ring';
            ring.textContent = 'Ring ' + money(cents + setting.price);
            prices.appendChild(ring);
          }
          li.appendChild(prices);
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'rbc__choose';
          btn.setAttribute('data-rbc-choose', handle);
          btn.setAttribute('aria-label', 'Choose the ' + title + ', ' + meta.textContent);
          btn.textContent = 'Choose';
          li.appendChild(btn);
          list.appendChild(li);
        });
      }

      function loadStones() {
        if (!rbc) return;
        var base = (root.getAttribute('data-api-base') || '').replace(/\/+$/, '');
        var key = root.getAttribute('data-api-key') || '';
        var params = new URLSearchParams({ kind: rbcState.kind, shapes: ringShape, sort: 'price_asc', per_page: '12', page: '1' });
        var band = rbcState.band.split('-');
        if (band[0]) params.set('min_carat', band[0]);
        if (band[1]) params.set('max_carat', band[1]);
        var headers = { Accept: 'application/json' };
        if (key) { headers.apikey = key; headers.Authorization = 'Bearer ' + key; }
        var req = ++rbcState.req;
        rbcState.loading = true;
        rbcState.error = false;
        rbcState.stones = [];
        renderStones();
        fetch(base + '?' + params.toString(), { headers: headers })
          .then(function (res) { return res.json().then(function (data) { if (!res.ok) throw new Error('api'); return data; }); })
          .then(function (data) {
            if (req !== rbcState.req) return;
            rbcState.stones = data.stones || [];
            rbcState.total = data.total || rbcState.stones.length;
          })
          .catch(function () { if (req === rbcState.req) rbcState.error = true; })
          .then(function () {
            if (req !== rbcState.req) return;
            rbcState.loading = false;
            renderStones();
          });
      }

      if (rbc) {
        rbc.addEventListener('click', function (e) {
          var kindBtn = e.target.closest('[data-rbc-kind]');
          var bandBtn = e.target.closest('[data-rbc-band]');
          var chooseBtn = e.target.closest('[data-rbc-choose]');
          if (kindBtn || bandBtn) {
            var attr = kindBtn ? 'data-rbc-kind' : 'data-rbc-band';
            var btn = kindBtn || bandBtn;
            rbc.querySelectorAll('[' + attr + ']').forEach(function (b) {
              var on = b === btn;
              b.classList.toggle('is-active', on);
              b.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            if (kindBtn) rbcState.kind = btn.getAttribute(attr);
            else rbcState.band = btn.getAttribute(attr);
            loadStones();
            return;
          }
          if (chooseBtn) {
            var handle = chooseBtn.getAttribute('data-rbc-choose');
            if (!HANDLE.test(handle)) return;
            chooseBtn.disabled = true;
            chooseBtn.textContent = '…';
            loadStone(handle, true).then(function (ok) {
              chooseBtn.disabled = false;
              chooseBtn.textContent = 'Choose';
              if (ok) root.querySelector('[data-pair-stone-link]').focus();
            });
          }
        });
        updateSearchLinks();
        loadStones();
      }
      saveBuilder();

      var fromUrl = new URLSearchParams(window.location.search).get('diamond');
      var remembered = read('lmPairDiamond');
      var handle = (fromUrl || (remembered && remembered.handle) || '').toLowerCase();
      if (HANDLE.test(handle)) loadStone(handle, !!fromUrl);

      root.querySelector('[data-pair-clear]').addEventListener('click', function () {
        store('lmPairDiamond', null);
        saveBuilder(null);
        stone = null;
        if (fromUrl && window.history && window.history.replaceState) {
          var u = new URL(window.location.href);
          u.searchParams.delete('diamond');
          window.history.replaceState(null, '', u.toString());
        }
        showBrowse('');
      });
    })();
  </script>
{%- endif -%}
