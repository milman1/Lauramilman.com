{defaultcss}

<!--
  Laura Milman New York brand styles for the Marketplace Connect (Codisto)
  eBay description template. Tokens mirror config/settings_data.json
  (espresso #1E1109, wine #4A1428, gold #C9A050, cream #FAF6F0, warm white
  #FDFAF6, text #2C1810, muted #8A8070, rule #DDD5C5). eBay allows inline
  <style>; no external stylesheets, no JavaScript, no @import.
-->
<style>
  #ebay-description.lm-ebay { background: #FDFAF6; color: #2C1810; font-family: Georgia, "Times New Roman", serif; font-size: 16px; line-height: 1.6; }
  #ebay-description.lm-ebay .container { max-width: 960px; margin: 0 auto; padding: 0 16px; }
  #ebay-description.lm-ebay a { color: #4A1428; }
  #ebay-description.lm-ebay a:hover { color: #C9A050; }

  #ebay-description .lm-announce { background: #1E1109; color: #E2C27A; text-align: center; font-family: Helvetica, Arial, sans-serif; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; padding: 10px 16px; }

  #ebay-description .lm-header { background: #1E1109; border-bottom: 3px solid #C9A050; padding: 28px 16px 24px; text-align: center; }
  #ebay-description .lm-header__inner { max-width: 960px; margin: 0 auto; }
  #ebay-description .lm-header__crest { max-width: 140px; height: auto; margin-bottom: 10px; }
  #ebay-description .lm-wordmark { font-family: Georgia, "Times New Roman", serif; font-size: 30px; letter-spacing: 0.08em; text-transform: uppercase; color: #FAF6F0; }
  #ebay-description .lm-wordmark span { color: #C9A050; }
  #ebay-description .lm-header__tag { color: #A9A090; font-family: Helvetica, Arial, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; margin: 8px 0 0; }

  #ebay-description .lm-card { background: #FFFFFF; border: 1px solid #DDD5C5; border-top: 3px solid #C9A050; padding: 28px; margin: 24px 0; }
  #ebay-description .lm-card h2, #ebay-description .lm-card h3 { font-family: Georgia, "Times New Roman", serif; font-weight: normal; color: #1E1109; }
  #ebay-description .lm-card h2 { font-size: 26px; margin: 0 0 12px; }
  #ebay-description .lm-card h3, #ebay-description .lm-card h3.icon { font-size: 18px; color: #4A1428; margin: 16px 0 6px; }
  #ebay-description .lm-card h4 { font-family: Georgia, "Times New Roman", serif; font-weight: normal; font-size: 15px; color: #2C1810; }

  #ebay-description .lm-eyebrow { color: #C9A050; font-family: Helvetica, Arial, sans-serif; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; margin: 0 0 6px; }
  #ebay-description .lm-title { font-size: 28px; line-height: 1.25; color: #1E1109; margin: 0 0 12px; }
  #ebay-description .lm-guarantee { color: #4A2018; font-style: italic; border-left: 3px solid #C9A050; padding-left: 14px; margin: 12px 0 20px; }
  #ebay-description .lm-description { color: #2C1810; }
  #ebay-description .lm-description p { margin: 0 0 12px; }
  #ebay-description .lm-hero { max-width: 100%; height: auto; border: 1px solid #DDD5C5; background: #FAF6F0; padding: 6px; }
  #ebay-description .lm-rule { border: 0; border-top: 1px solid #DDD5C5; margin: 20px 0; }
  #ebay-description .image-row img { border: 1px solid #DDD5C5; background: #FAF6F0; padding: 4px; }

  #ebay-description .lm-btn, #ebay-description .lm-btn:visited { display: inline-block; background: #1E1109; color: #FAF6F0 !important; border: 1px solid #1E1109; font-family: Helvetica, Arial, sans-serif; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; padding: 14px 26px; border-radius: 0; text-shadow: none; box-shadow: none; }
  #ebay-description .lm-btn:hover { background: #4A1428; border-color: #4A1428; color: #FAF6F0 !important; }
  #ebay-description .lm-btn--ghost, #ebay-description .lm-btn--ghost:visited { background: transparent; color: #1E1109 !important; border-color: #C9A050; }
  #ebay-description .lm-btn--ghost:hover { background: #F0DFB0; color: #1E1109 !important; }

  #ebay-description .lm-trust { display: table; width: 100%; border: 1px solid #DDD5C5; background: #FAF6F0; margin: 0 0 8px; }
  #ebay-description .lm-trust__item { display: table-cell; text-align: center; padding: 14px 8px; font-family: Helvetica, Arial, sans-serif; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #4A2018; border-right: 1px solid #DDD5C5; }
  #ebay-description .lm-trust__item:last-child { border-right: 0; }

  #ebay-description .quote { background: #FAF6F0; border: 1px solid #DDD5C5; padding: 14px 16px; margin: 10px 0; }
  #ebay-description .quote p { margin: 0 0 8px; }
  #ebay-description .price strong { color: #1E1109; }
  #ebay-description .muted { color: #8A8070; }

  #ebay-description .tabs .tab label { font-family: Helvetica, Arial, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #4A2018; background: #FAF6F0; border: 1px solid #DDD5C5; border-bottom: 0; }
  #ebay-description .tabs .tab input:checked + label { background: #FFFFFF; color: #1E1109; border-top: 3px solid #C9A050; }
  #ebay-description .tabs .content { background: #FFFFFF; border: 1px solid #DDD5C5; color: #2C1810; }

  #ebay-description .lm-footer { background: #1E1109; border-top: 3px solid #C9A050; color: #FAF6F0; text-align: center; padding: 28px 16px; margin-top: 24px; }
  #ebay-description .lm-wordmark--footer { font-size: 22px; }
  #ebay-description .lm-footer__tag { color: #A9A090; font-family: Helvetica, Arial, sans-serif; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; margin: 6px 0 12px; }
  #ebay-description .lm-footer .logo { max-width: 120px; height: auto; opacity: 0.9; }
  #ebay-description .lm-codisto { padding: 8px 0 16px; font-family: Helvetica, Arial, sans-serif; font-size: 11px; }

  @media (max-width: 640px) {
    #ebay-description .lm-card { padding: 18px; }
    #ebay-description .lm-title { font-size: 22px; }
    #ebay-description .lm-trust, #ebay-description .lm-trust__item { display: block; border-right: 0; border-bottom: 1px solid #DDD5C5; }
    #ebay-description .lm-trust__item:last-child { border-bottom: 0; }
  }
</style>

<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

<div id="ebay-description" class="nojs lm-ebay">
	<div class="lm-announce">Authenticity guaranteed · Complimentary insured shipping · Authenticated in New York</div>

	<div class="lm-header">
		<div class="lm-header__inner">
			<img class="lm-header__crest" src="{CDNUrl}/images/logo.png?width=280&amp;nostretch&amp;etag={LogoEtag}" alt="Laura Milman New York" />
			<div class="lm-wordmark">Laura <span>Milman</span></div>
			<p class="lm-header__tag">New York · Fine jewelry · Authenticated timepieces</p>
		</div>
	</div>

	<div class="container">
		<div class="block lm-card">
			<div class="row">
				<div class="span12">
					<p class="lm-eyebrow">Laura Milman New York</p>
					<h2 class="lm-title">{Title}</h2>
					<p class="lm-guarantee">Authenticated and hand-inspected in New York. Thirty years in the Diamond District taught us the difference between a piece that's bought and a piece that's kept.</p>
				</div>
			</div>
			<div class="row">
				<div class="span12 lm-description">
					<!--startcodistodescription - DO NOT REMOVE-->
					{include field="EbayDescription"}
					<!--endcodistodescription - DO NOT REMOVE-->
				</div>
			</div>
			<div class="row">
				<div class="span12 text-center">
					<a href="#img1">
						<img class="lm-hero" src="{DefaultProductImage}&amp;width=720" alt="{Title}" />
					</a>
					<a href="#_" class="lightbox" id="img1">
						<div class="close-img">&times;</div>
						<img src="{DefaultProductImage}&amp;width=800" alt="{Title}" />
					</a>

					{for images}
						<a href="#_" class="lightbox" id="img{position+1}">
							<div class="close-img">&times;</div>
							<img src="{images.Source}&amp;width=800&amp;height=600" alt="{Title}" />
						</a>
					{/for}

					<div class="clearfix"></div>
					{if count(images) > 1}<hr class="lm-rule" />{/if}
					{for images step=4}
						<div class="row image-row text-center">
							{for Images count=4 start={position}}
								<div class="span2"><a class="image fancybox" href="#img{position+1}"><img src="{images.Source}&amp;width=200&amp;height=200" alt="{Title}" /></a></div>
							{/for}
						</div>
					{/for}
					<br />
				</div>
			</div>
			<div class="row">
				<div class="span5 buy-now">
				{if !MultiVariant}
					<a href="https://offer.{EbaySiteURL}/ws/eBayISAPI.dll?BinConfirm&amp;quantity=1&amp;fb=1&amp;item={EbayItemID}" target="_blank" class="btn btn-large btn-primary lm-btn">Purchase this piece</a>
				{/if}
				</div>
			</div>
		</div>
	</div>

	<div class="container">
		<div class="lm-trust">
			<div class="lm-trust__item">Authenticity guaranteed</div>
			<div class="lm-trust__item">Complimentary insured shipping</div>
			<div class="lm-trust__item">Watches: exchanges only</div>
			<div class="lm-trust__item">Specialists in New York</div>
		</div>
	</div>

	{if overviewhtml}
	<div class="container">
	<div class="block lm-card">
		<div class="row">
			<div class="span12">
				<p class="lm-eyebrow">The piece</p>
				<h2>Overview</h2>
			</div>
		</div>
		<div class="row">
			<div class="span7">
				{include field="overviewhtml"}
			</div>
			<div class="span5">
				<div class="quote">
					<p><a href="https://contact.{EbaySiteURL}/ws/eBayISAPI.dll?FindAnswers&frm=284&requested={EbayUserID}&iid={EbayItemID}" target="_blank">Ask our New York specialists</a> for measurements, provenance, or a closer look at this piece.</p>
				</div>
				{for overview}
					<img src="{CDNUrl}{src}" alt="" />
				{/for}
			</div>
		</div>
	</div>
	</div>
	{/if}

	{if productspecshtml}
	<div class="container">
		<div class="block lm-card">
			<div class="row">
				<div class="span12">
					<p class="lm-eyebrow">Details</p>
					<h2>Specifications</h2>
				</div>
			</div>
			<div class="row">
				<div class="span6">
					{include field="productspecshtml"}
				</div>
				<div class="span6">
				{for specimage step=2}
				<div class="row">
					{for specimage count=2 start={position}}
						<div class="span3">
							<a class="fancybox image" href="{CDNUrl}{specimage.src}"><img src="{CDNUrl}{specimage.src}" alt="" /></a>
						</div>
					{/for}
				</div>
				{/for}
				</div>
			</div>
		</div>
	</div>
	{/if}

	<div class="container">
		<div class="block lm-card">
			<div class="row">
				<div class="span12">
					<p class="lm-eyebrow">Buying with us</p>
					<h2>Shipping {if ShippingDomesticServiceType = "CalculatedMerchant" AND ShippingQuoteSupported}calculator{else if ShippingDomesticServiceType = "CalculatedEbay" OR ShippingRateTable}info{else}&amp; payment{/if}</h2>
				</div>
			</div>
			<div class="row">
				<div class="span4">
					{if ShippingDomesticServiceType = "CalculatedMerchant" AND ShippingQuoteSupported}
					<div class="quote">
						<a class="postage-quote" href="https://codisto.com/cart/quote/?merchanttoken={MerchantToken}&amp;emptycart=1&amp;sku={ProductCode}" target="codisto!freightquote"><strong>Request a shipping quote</strong></a>
					</div>
					{else}
					<div class="quote">
					<p>Open the Shipping &amp; Payments tab above this description for rates and delivery times. Pieces ship insured from New York.</p>
					</div>
					{/if}

					<div class="quote {if ShippingDomesticServiceType = "CalculatedMerchant" AND !ShippingQuoteSupported}hide{/if}">
					<p class="price">
					<strong>
						{if !ShippingRateTable}
							{if FlatShippingRate = 0 AND ShippingDomesticServiceType = "Flat"}
								Complimentary {if LocalPickupFirstOption}local pickup{else}insured shipping{/if}
							{else if ShippingDomesticServiceType = "Flat"}
								Shipping:
								<span class="freightprice">
									{if ShippingDomesticServiceType = "Flat"}
										{format FlatShippingRate, EbayCurrency} <small>(domestic)</small>
									{/if}
								</span>
							{/if}
						{/if}
					</strong>
					</p>

					<div class="text-center">
					{if ShippingDomesticServiceType = "Flat" AND !ShippingRateTable}
						{if (ShippingDomesticServiceType = "Flat" AND ShippingDomesticService2) OR (ShippingInternationalServiceType = "Flat" AND ShippingInternationalService1)}
						<span class="seemoreflat"><a href="#freightservices">See shipping options</a></span>
						<div id="freightservices" class="moreservicesflat">
							<div class="moreservicesflatcontent">
								{if ShippingDomesticServiceType = "Flat"}
									{if ShippingDomesticService1}{ShippingDomesticService1} - <strong>{format ShippingDomesticCost1, EbayCurrency}</strong>{/if}
									{if ShippingDomesticService2}<hr/>{ShippingDomesticService2} - <strong>{format ShippingDomesticCost2, EbayCurrency}</strong>{/if}
									{if ShippingDomesticService3}<hr/>{ShippingDomesticService3} - <strong>{format ShippingDomesticCost3, EbayCurrency}</strong>{/if}
									{if ShippingDomesticService4}<hr/>{ShippingDomesticService4} - <strong>{format ShippingDomesticCost4, EbayCurrency}</strong>{/if}
								{/if}
								{if ShippingInternationalServiceType = "Flat"}
									{if ShippingInternationalService1}<hr/>{ShippingInternationalService1} - <strong>{format ShippingInternationalCost1, EbayCurrency}</strong>{/if}
									{if ShippingInternationalService2}<hr/>{ShippingInternationalService2} - <strong>{format ShippingInternationalCost2, EbayCurrency}</strong>{/if}
									{if ShippingInternationalService3}<hr/>{ShippingInternationalService3} - <strong>{format ShippingInternationalCost3, EbayCurrency}</strong>{/if}
									{if ShippingInternationalService4}<hr/>{ShippingInternationalService4} - <strong>{format ShippingInternationalCost4, EbayCurrency}</strong>{/if}
									{if ShippingInternationalService5}<hr/>{ShippingInternationalService5} - <strong>{format ShippingInternationalCost5, EbayCurrency}</strong>{/if}
								{/if}
							</div>
						</div>
						{/if}
					{/if}

					{if ShippingDomesticServiceType = "CalculatedEbay" OR ShippingRateTable}
						<p>Open the Shipping &amp; Payments tab above this description for calculated rates.</p>
					{/if}
					</div>

					</div>

					<h3 class="icon">Delivery notes</h3>

					{if PickupOption}
						<p><strong>In-person pickup</strong></p>
						<p>This piece can be collected in New York after purchase on eBay.</p>
						<ol>
							<li>Complete the purchase on eBay</li>
							<li><a href="https://contact.{EbaySiteURL}/ws/eBayISAPI.dll?FindAnswers&frm=284&requested={EbayUserID}&iid={EbayItemID}" title="Ask seller a question" target="_blank">Message us</a> to arrange a time</li>
						</ol>
					{else}
						<p>This piece ships insured from New York. In-person pickup is not offered on this listing.</p>
					{/if}

				</div>
				<div class="span4">
					<h3 class="icon">Payment</h3>
					<br/>

					{if SiteID = 0 OR SiteID = 100}
						<p>Payment is due when you choose Buy It Now or check out through the cart.</p>
						<p>We accept U.S. PayPal accounts, major credit and debit cards, and Google Pay.</p>
						<p>Sales tax is collected where we have nexus, based on the shipment destination.</p>
						<p>Thank you for buying from Laura Milman New York on eBay.</p>
					{else}
						<p>Payment is due when you choose Buy It Now or check out through the cart.</p>
						<p>We accept major credit cards, Google Pay, PayPal, and Apple Pay (on mobile and the eBay app).</p>
						<p>Thank you for buying from Laura Milman New York on eBay.</p>
					{/if}

					{if ShippingDomesticServiceType = "CalculatedMerchant"}
						<p>eBay adds freight at checkout after you commit to purchase. If checkout stalls, use your browser Back button and try Pay Now again.</p>
					{/if}

					{if MoneyOrderAccepted}
						<h3 class="icon">Paying by money order</h3>
						<p>Add shipping to the item total and send the amount to the address we provide after purchase.</p>
					{/if}

					{if DirectDepositAccepted}
						<h3 class="icon">Paying by direct deposit</h3>
						<p>Add shipping to the item total and send the amount to the address we provide after purchase.</p>
					{/if}

				</div>
				<div class="span4">
					<h3 class="icon">The Laura Milman standard</h3>
					{if AdditionalInfo}
					<p>{AdditionalInfo}</p>
					{else}
					<p>Every piece is examined in New York before it is listed. Hallmarks, serial numbers, and construction are checked against each house's conventions. Ask us anything about this listing — our specialists will answer.</p>
					{/if}
					<p><a target="_blank" href="https://contact.{EbaySiteURL}/ws/eBayISAPI.dll?FindAnswers&frm=284&requested={EbayUserID}&iid={EbayItemID}" class="btn btn-info btn-large lm-btn lm-btn--ghost">Ask a specialist</a></p>
				</div>
			</div>
		</div>
	</div>

	{if SuggestedProducts}
		<div class="container">
			<div class="block lm-card" id="you_like">
				<div class="row">
					<div class="span12">
						<p class="lm-eyebrow">From the maison</p>
						<h2>You may also like</h2>
					</div>
				</div>
				<div class="row">
					{for SuggestedProducts}
						<div class="span3">
							<div class="imagecenter">
								<a target="_blank" href="https://cgi.{EbaySiteURL}/{EbayItemID}"><img src="{Source}&amp;width=170&amp;height=170" alt="{Name}" /></a>
							</div>
							<h4><a target="_blank" href="https://cgi.{EbaySiteURL}/{EbayItemID}">{Name}</a></h4>
						</div>
					{/for}
				</div>
			</div>
		</div>
	{/if}

	<div class="container">
	<div class="tabs">

		<div class="tab">
			<input type="radio" id="tab-1" name="tab-group-1" checked>
			<label for="tab-1" style="margin-left: 2px;">Contact</label>

			<div class="content">
				<div class="row">
					 <div class="span6">
						 <p>Message our New York specialists with questions about this piece, measurements, or shipping. We answer through eBay.</p>
						 <p><a target="_blank" href="https://contact.{EbaySiteURL}/ws/eBayISAPI.dll?FindAnswers&frm=284&requested={EbayUserID}&iid={EbayItemID}" class="btn btn-primary btn-large lm-btn">Ask a specialist</a></p>
					 </div>
					 <div class="span6">
						 {if MerchantName != "<to be set>"}<p>&copy; {MerchantName}</p>{/if}
						 <p>Laura Milman New York — designed in New York, examined in the Diamond District.</p>
					 </div>
				</div>
			</div>
		</div>

		<div class="tab">
			<input type="radio" id="tab-2" name="tab-group-1">
			<label for="tab-2">Shipping</label>

			<div class="content">
				 <p>
						 {if ShippingDomesticServiceType = "CalculatedEbay" OR ShippingRateTable != 0}
							 Open the Shipping &amp; Payments tab above this description for rates. Pieces ship insured from New York.
						 {else}
							 {if FlatShippingRate = 0 AND ShippingDomesticServiceType = "Flat"}
									 Complimentary insured shipping on this piece
							 {else if ShippingDomesticServiceType = "Flat"}
									 Domestic shipping is a flat {format ShippingDomesticCost1, EbayCurrency}
							 {else if ShippingDomesticServiceType = "CalculatedMerchant"}
									 Use the shipping quote above to calculate delivery.
							 {else}
									 Shipping is calculated on eBay. Open the Shipping &amp; Payments tab above this description.
							 {/if}
						 {/if}
				 </p>
			 </div>
		</div>

		{if WarrantyHTML}
		<div class="tab">
			<input type="radio" id="tab-3" name="tab-group-1">
			<label for="tab-3">Warranty</label>

			<div class="content">
				{include field="WarrantyHTML"}
			</div>
		</div>
		{/if}

		<div class="tab">
			<input type="radio" id="tab-4" name="tab-group-1">
			<label for="tab-4">Payment</label>

			<div class="content">
			<p>Accepted payment methods</p>
			{if SiteID = 0 OR SiteID = 100}
				<p>Payment is due when you choose Buy It Now or check out through the cart.</p>
				<p>We accept U.S. PayPal accounts, major credit and debit cards, and Google Pay.</p>
				<p>Sales tax is collected where we have nexus, based on the shipment destination.</p>
				<p>Thank you for buying from Laura Milman New York on eBay.</p>
			{else}
				<p>Payment is due when you choose Buy It Now or check out through the cart.</p>
				<p>We accept major credit cards, Google Pay, PayPal, and Apple Pay (on mobile and the eBay app).</p>
				<p>Thank you for buying from Laura Milman New York on eBay.</p>
			{/if}
			</div>
		</div>

		<div class="tab">
		  <input type="radio" id="tab-5" name="tab-group-1">
		  <label for="tab-5">Returns</label>

		  <div class="content">
				{if ReturnsAccepted}
					<p>Returns are accepted on this listing.</p>
					<p>Items must be returned within
					{if ReturnsWithin = "Days_3"}
						3 days
					{else if ReturnsWithin = "Days_7"}
						7 days
					{else if ReturnsWithin = "Days_10"}
						10 days
					{else if ReturnsWithin = "Days_14"}
						14 days
					{else if ReturnsWithin = "Days_30"}
						30 days
					{else if ReturnsWithin = "Days_60"}
						60 days
					{/if} of the sale ending.</p>
				{else}
					<p>Returns are <strong>not</strong> accepted on this listing. Timepieces on Laura Milman New York are typically exchanges only; this listing follows the eBay return policy shown here.</p>
				{/if}

				<p>{if EbayShippingCostPaidByOption = "Buyer"}Buyer{else}Seller{/if} pays return shipping.</p>

				{if EbayReturnPolicyDescription}
					<br />
					<strong>Additional information</strong>
					<div>{EbayReturnPolicyDescription}</div>
				{/if}
		   </div>
	   </div>

	</div>
	</div>

	<div class="container" id="footer">
		<div class="lm-footer">
			<div class="lm-wordmark lm-wordmark--footer">Laura <span>Milman</span></div>
			<p class="lm-footer__tag">New York · Authenticated jewelry &amp; timepieces</p>
			<img class="logo" src="{CDNUrl}/images/logo.png?width=160&amp;nostretch&amp;etag={LogoEtag}" alt="Laura Milman New York" />
		</div>
		<div class="pull-right logo lm-codisto">
