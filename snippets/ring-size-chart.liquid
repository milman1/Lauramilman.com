{%- comment -%}
  US ring sizes with inside diameter and circumference. One table for the
  Ring Size Guide page and the product-page size dialog.

  Accepts:
  - class: CSS class for the <table>
{%- endcomment -%}
<table class="{{ class }}">
  <thead>
    <tr>
      <th scope="col">US Size</th>
      <th scope="col">Diameter (mm)</th>
      <th scope="col">Circumference (mm)</th>
    </tr>
  </thead>
  <tbody>
    {%- assign size_rows = '4|14.9|46.8,4.5|15.3|48.0,5|15.7|49.3,5.5|16.1|50.6,6|16.5|51.9,6.5|16.9|53.1,7|17.3|54.4,7.5|17.7|55.7,8|18.1|57.0,8.5|18.5|58.3,9|19.0|59.5,9.5|19.4|60.8,10|19.8|62.1,10.5|20.2|63.4,11|20.6|64.6,11.5|21.0|65.9,12|21.4|67.2,12.5|21.8|68.5,13|22.2|69.7' | split: ',' -%}
    {%- for row in size_rows -%}
      {%- assign cells = row | split: '|' -%}
      <tr>
        <td>{{ cells[0] }}</td>
        <td>{{ cells[1] }}</td>
        <td>{{ cells[2] }}</td>
      </tr>
    {%- endfor -%}
  </tbody>
</table>
