{%- assign size_rows = size_data | split: '||' -%}

{%- if chart_view == 'sizer' -%}
  <figure class="lm-sizer">
    <div class="lm-sizer__rule" aria-hidden="true"><span class="lm-sizer__rule-bar"></span></div>
    <figcaption class="lm-sizer__caption">50 mm. After printing, this bar must measure 50 millimeters on a ruler.</figcaption>
    <ul class="lm-sizer__grid">
      {%- for row in size_rows -%}
        {%- assign cells = row | strip | split: '|' -%}
        {%- if cells.size == 9 -%}
          {%- unless cells[0] contains '.25' or cells[0] contains '.75' -%}
            <li class="lm-sizer__item">
              <span class="lm-sizer__disk" style="width: {{ cells[1] }}mm; height: {{ cells[1] }}mm" aria-hidden="true"></span>
              <span class="lm-sizer__label">{{ cells[0] }}</span>
            </li>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </figure>
{%- elsif chart_view == 'convert' -%}
  <table class="{{ class }}">
    <caption class="sr-only">US ring sizes converted to UK, French, German, Japanese, and Italian sizes</caption>
    <thead>
      <tr>
        <th scope="col">US</th>
        <th scope="col">Diameter (mm)</th>
        <th scope="col">Circumference (mm)</th>
        <th scope="col">Circumference (in)</th>
        <th scope="col" title="United Kingdom, Australia, Ireland, New Zealand, and South Africa">UK</th>
        <th scope="col" title="France. This column is the inside circumference in millimeters, rounded.">France</th>
        <th scope="col" title="Germany, Russia, and Ukraine">Germany</th>
        <th scope="col" title="Japan, China, and India">Japan</th>
        <th scope="col" title="Italy, Spain, the Netherlands, and Switzerland">Italy</th>
      </tr>
    </thead>
    <tbody>
      {%- for row in size_rows -%}
        {%- assign cells = row | strip | split: '|' -%}
        {%- if cells.size == 9 -%}
          <tr>
            {%- for cell in cells -%}
              <td>{{ cell }}</td>
            {%- endfor -%}
          </tr>
        {%- endif -%}
      {%- endfor -%}
    </tbody>
  </table>
{%- else -%}
  <table class="{{ class }}">
    <caption class="sr-only">US ring sizes with inside diameter and circumference</caption>
    <thead>
      <tr>
        <th scope="col">US Size</th>
        <th scope="col">Diameter (mm)</th>
        <th scope="col">Circumference (mm)</th>
      </tr>
    </thead>
    <tbody>
      {%- for row in size_rows -%}
        {%- assign cells = row | strip | split: '|' -%}
        {%- if cells.size == 9 -%}
          {%- unless cells[0] contains '.25' or cells[0] contains '.75' -%}
            <tr>
              <td>{{ cells[0] }}</td>
              <td>{{ cells[1] }}</td>
              <td>{{ cells[2] }}</td>
            </tr>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </tbody>
  </table>
{%- endif -%}
