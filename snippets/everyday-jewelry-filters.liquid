{% doc %}
Renders additional controls for the Everyday Jewelry collection.
@example
{% render 'everyday-jewelry-filters' %}
{% enddoc %}

<div class="refine__group refine__group--jewelry" data-refine-group data-jewelry-filters data-everyday-group="type">
  <button type="button" class="refine__group-head" aria-expanded="true">
    <span class="refine__group-label">{{ 'everyday_filters.type' | t }}</span>
    <svg class="refine__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
  </button>
  <div class="refine__group-body">
    <ul class="refine__checks">
      {%- assign everyday_options = 'Rings::rings||Necklaces::necklaces||Bracelets::bracelets' | split: '||' -%}
      {%- for item in everyday_options -%}
        {%- assign parts = item | split: '::' -%}
        {%- assign label_key = 'everyday_filters.' | append: parts[1] -%}
        <li>
          <label class="refine-check js-client-filter">
            <input type="checkbox" name="jewelry_type" value="{{ parts[0] | escape }}" data-client-filter="type" data-everyday-filter="type">
            <span class="refine-check__box" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
            <span class="refine-check__label">{{ label_key | t }}</span>
            <span class="refine-check__count" data-everyday-count></span>
          </label>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

