{%- comment -%}
  Product-page concierge. Ask and Direct message open Shopify chat with
  this product pinned beside it on every product. Make an offer opens a
  short form that posts through Shopify's contact form, so the offer
  reaches the store's email with the piece attached. That form is only
  for loose natural diamonds, maison / vintage / estate pieces, and
  watches. Lab-grown loose diamonds and other jewelry do not get it.
  Loose lab-grown diamonds get "Ask about this stone" instead of the chat
  "Ask" pill: a short question form through the same contact form, so the
  stone and the shopper's email reach the store's inbox. It makes no
  promise to keep the stone for the shopper and does not take offers.
  Shopify chat is now an AI agent in a cross-origin iframe the theme
  cannot type into, so offers never depend on it. Hold is intentionally
  not rendered.
{%- endcomment -%}
{%- liquid
  assign product_image = ''
  if product.featured_image
    assign product_image = product.featured_image | image_url: width: 240
  endif
  assign display_title = product.title | replace: 'Jacob & Company', 'Jacob & Co.' | replace: 'Jacob and Company', 'Jacob & Co.'
  assign offer_id = 'PdpOffer-' | append: product.id
  assign ask_id = 'PdpAsk-' | append: product.id
  assign type_l = product.type | downcase | strip
-%}
{%- capture is_watch -%}{% render 'product-is-watch', product: product %}{%- endcapture -%}
{%- capture is_vintage -%}{% render 'product-is-vintage', product: product %}{%- endcapture -%}
{%- liquid
  assign is_watch = is_watch | strip
  assign is_vintage = is_vintage | strip
  assign offer_ok = false
  if type_l == 'natural diamond' or is_watch == 'true' or is_vintage == 'true'
    assign offer_ok = true
  endif
  assign ask_form_ok = false
  if type_l == 'lab-grown diamond'
    assign offer_ok = false
    assign ask_form_ok = true
  endif
-%}

<div class="pdp-inquire" id="PdpInquire">
  <p class="pdp-inquire__label">Questions about this piece?</p>
  <div class="pdp-inquire__actions">
    {%- if ask_form_ok -%}
      <button
        type="button"
        class="pdp-inquire__btn js-open-offer"
        aria-expanded="false"
        aria-controls="{{ ask_id }}"
      >
        Ask about this stone
      </button>
    {%- else -%}
      <button
        type="button"
        class="pdp-inquire__btn js-open-product-chat"
        data-chat-intent="ask"
        data-product-id="{{ product.id }}"
        data-product-handle="{{ product.handle }}"
        data-product-title="{{ display_title | escape }}"
        data-product-url="{{ shop.url }}{{ product.url }}"
        data-product-image="{{ product_image | escape }}"
      >
        Ask about this piece
      </button>
    {%- endif -%}
    {%- if offer_ok -%}
      <button
        type="button"
        class="pdp-inquire__btn pdp-inquire__btn--ghost js-open-offer"
        aria-expanded="false"
        aria-controls="{{ offer_id }}"
      >
        Make an offer
      </button>
    {%- endif -%}
    <button
      type="button"
      class="pdp-inquire__btn pdp-inquire__btn--ghost js-open-product-chat"
      data-chat-intent="message"
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle }}"
      data-product-title="{{ display_title | escape }}"
      data-product-url="{{ shop.url }}{{ product.url }}"
      data-product-image="{{ product_image | escape }}"
    >
      Direct message
    </button>
  </div>

  {%- if offer_ok -%}
  <div class="pdp-offer" id="{{ offer_id }}" hidden>
    {%- form 'contact', id: 'PdpOfferForm', class: 'pdp-offer__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="pdp-offer__status" role="status" data-offer-result>
          Thank you — your offer was sent. We will reply by email.
        </p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="pdp-offer__status pdp-offer__status--error" role="alert" data-offer-result>
            Your offer did not send. Please check your email address and try again.
          </p>
        {%- endif -%}
        <p class="pdp-offer__intro">
          Name your price for <strong>{{ display_title }}</strong>. We review every offer and reply by email.
        </p>

        <input type="hidden" name="contact[request_type]" value="Offer">
        <input type="hidden" name="contact[product]" value="{{ display_title | escape }}">
        <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
        <input type="hidden" name="contact[listed_price]" value="{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros | strip_html | escape }}">
        {%- unless product.has_only_default_variant -%}
          <input type="hidden" name="contact[option]" value="{{ product.selected_or_first_available_variant.title | escape }}" data-offer-variant>
        {%- endunless -%}

        <div class="pdp-offer__row">
          <div class="pdp-offer__field">
            <label for="{{ offer_id }}-amount">Your offer (USD)</label>
            <input type="text" id="{{ offer_id }}-amount" name="contact[offer]" inputmode="decimal" autocomplete="off" placeholder="$" required>
          </div>
          <div class="pdp-offer__field">
            <label for="{{ offer_id }}-name">Name</label>
            <input type="text" id="{{ offer_id }}-name" name="contact[name]" autocomplete="name" value="{{ customer.name | escape }}" required>
          </div>
        </div>
        <div class="pdp-offer__row">
          <div class="pdp-offer__field">
            <label for="{{ offer_id }}-email">Email</label>
            <input type="email" id="{{ offer_id }}-email" name="contact[email]" autocomplete="email" value="{{ customer.email | escape }}" required>
          </div>
          <div class="pdp-offer__field">
            <label for="{{ offer_id }}-phone">Phone (optional)</label>
            <input type="tel" id="{{ offer_id }}-phone" name="contact[phone]" autocomplete="tel">
          </div>
        </div>
        <div class="pdp-offer__field">
          <label for="{{ offer_id }}-note">Note (optional)</label>
          <textarea id="{{ offer_id }}-note" name="contact[body]" rows="2"></textarea>
        </div>
        <button type="submit" class="pdp-inquire__btn pdp-offer__submit">Send offer</button>
      {%- endif -%}
    {%- endform -%}
  </div>
  {%- endif -%}

  {%- if ask_form_ok -%}
  <div class="pdp-offer" id="{{ ask_id }}" hidden>
    {%- form 'contact', id: 'PdpAskForm', class: 'pdp-offer__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="pdp-offer__status" role="status" data-offer-result>
          Thank you — your question was sent. We will reply by email.
        </p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="pdp-offer__status pdp-offer__status--error" role="alert" data-offer-result>
            Your question did not send. Please check your email address and try again.
          </p>
        {%- endif -%}
        <p class="pdp-offer__intro">
          Ask us anything about <strong>{{ display_title }}</strong>: the certificate, how it looks, setting it in a ring, or whether it is still available. We reply by email.
        </p>

        <input type="hidden" name="contact[request_type]" value="Stone question">
        <input type="hidden" name="contact[product]" value="{{ display_title | escape }}">
        <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
        <input type="hidden" name="contact[stock_number]" value="{{ product.metafields.lmny_feed.stock_ref | escape }}">
        <input type="hidden" name="contact[listed_price]" value="{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros | strip_html | escape }}">

        <div class="pdp-offer__row">
          <div class="pdp-offer__field">
            <label for="{{ ask_id }}-name">Name</label>
            <input type="text" id="{{ ask_id }}-name" name="contact[name]" autocomplete="name" value="{{ customer.name | escape }}" required>
          </div>
          <div class="pdp-offer__field">
            <label for="{{ ask_id }}-email">Email</label>
            <input type="email" id="{{ ask_id }}-email" name="contact[email]" autocomplete="email" value="{{ customer.email | escape }}" required>
          </div>
        </div>
        <div class="pdp-offer__field">
          <label for="{{ ask_id }}-phone">Phone (optional)</label>
          <input type="tel" id="{{ ask_id }}-phone" name="contact[phone]" autocomplete="tel">
        </div>
        <div class="pdp-offer__field">
          <label for="{{ ask_id }}-question">Your question</label>
          <textarea id="{{ ask_id }}-question" name="contact[body]" rows="3" required></textarea>
        </div>
        <button type="submit" class="pdp-inquire__btn pdp-offer__submit">Send question</button>
      {%- endif -%}
    {%- endform -%}
  </div>
  {%- endif -%}
</div>

<style>
  .pdp-inquire {
    margin: 1.25rem 0 0;
    padding-top: 1.15rem;
    border-top: 1px solid var(--rule-light, #DDD5C5);
  }
  .pdp-inquire__label {
    margin: 0 0 0.75rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted, #8A8070);
  }
  .pdp-inquire__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .pdp-inquire__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.05rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cream, #FAF6F0);
    background: var(--espresso, #1E1109);
    border: 1px solid var(--espresso, #1E1109);
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
  }
  .pdp-inquire__btn--ghost {
    background: transparent;
    color: var(--text-dark, #2C1810);
    border-color: var(--border-medium, #CFC7B8);
  }
  .pdp-inquire__btn:hover,
  .pdp-inquire__btn--ghost:hover {
    border-color: var(--gold, #C9A050);
    color: var(--gold-dark, #A88340);
    background: rgba(201, 160, 80, 0.08);
  }
  .pdp-offer {
    margin-top: 0.9rem;
  }
  .pdp-offer[hidden] {
    display: none;
  }
  .pdp-offer__intro,
  .pdp-offer__status {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-dark, #2C1810);
  }
  .pdp-offer__status--error {
    color: #9B2C2C;
  }
  .pdp-offer__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .pdp-offer__field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.6rem;
  }
  .pdp-offer__field label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted, #8A8070);
  }
  .pdp-offer__field input,
  .pdp-offer__field textarea {
    width: 100%;
    padding: 0.6rem 0.7rem;
    font: inherit;
    font-size: 16px;
    color: var(--text-dark, #2C1810);
    background: #fff;
    border: 1px solid var(--border-medium, #CFC7B8);
    border-radius: var(--radius-sm, 4px);
  }
  .pdp-offer__field input:focus,
  .pdp-offer__field textarea:focus {
    outline: 2px solid var(--gold, #C9A050);
    outline-offset: 1px;
  }
  @media (max-width: 480px) {
    .pdp-offer__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  .dpdp--navy .pdp-inquire__btn {
    background: var(--wine, #4A1428);
    border-color: var(--wine, #4A1428);
    color: #fff;
  }
  .dpdp--navy .pdp-inquire__btn--ghost {
    background: transparent;
    color: var(--wine, #4A1428);
    border-color: rgba(74, 20, 40, 0.35);
  }
  .dpdp--navy .pdp-inquire__btn:hover,
  .dpdp--navy .pdp-inquire__btn--ghost:hover {
    border-color: var(--gold, #C9A050);
    color: var(--wine, #4A1428);
    background: rgba(201, 160, 80, 0.1);
  }
</style>

<script>
  (function () {
    function payloadFrom(btn) {
      return {
        productTitle: btn.getAttribute('data-product-title') || '',
        productUrl: btn.getAttribute('data-product-url') || window.location.href,
        productId: btn.getAttribute('data-product-id') || '',
        productHandle: btn.getAttribute('data-product-handle') || '',
        productImage: btn.getAttribute('data-product-image') || '',
        intent: btn.getAttribute('data-chat-intent') || 'ask'
      };
    }
    function openChat(btn) {
      var payload = payloadFrom(btn);
      function go() {
        if (window.lmChat && typeof window.lmChat.open === 'function') {
          window.lmChat.open(payload);
          return true;
        }
        return false;
      }
      if (go()) return;
      var tries = 0;
      var wait = setInterval(function () {
        tries += 1;
        if (go() || tries >= 40) clearInterval(wait);
      }, 100);
    }
    function setOfferOpen(toggle, panel, open) {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    document.querySelectorAll('.js-open-offer').forEach(function (toggle) {
      var panel = document.getElementById(toggle.getAttribute('aria-controls'));
      if (!panel) return;
      if (panel.querySelector('[data-offer-result]')) {
        setOfferOpen(toggle, panel, true);
        panel.scrollIntoView({ block: 'center' });
      }
      toggle.addEventListener('click', function (event) {
        event.preventDefault();
        var open = panel.hidden;
        setOfferOpen(toggle, panel, open);
        if (open) {
          var first = panel.querySelector('input[name="contact[offer]"], input[name="contact[name]"]');
          if (first) first.focus();
        }
      });
      var form = panel.querySelector('form');
      var variantField = panel.querySelector('[data-offer-variant]');
      if (form && variantField) {
        form.addEventListener('submit', function () {
          var picked = document.querySelector('form[data-product-form] select[name="id"] option:checked');
          var options = picked && picked.getAttribute('data-options');
          if (!options) return;
          try {
            variantField.value = JSON.parse(options).join(' / ');
          } catch (err) {}
        });
      }
    });
    document.querySelectorAll('.js-open-product-chat').forEach(function (btn) {
      btn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        openChat(btn);
      });
    });
  })();
</script>
