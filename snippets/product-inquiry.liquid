{%- comment -%}
  Product-page concierge: ask about this piece, book a call, or email directly.
  Renders after add-to-cart. The ask form uses Shopify's contact form so
  inquiries arrive in Admin → Inbox with the product URL attached.
{%- endcomment -%}

{%- liquid
  assign inquire_email = shop.email | default: 'hello@lauramilman.com'
  assign mail_subject = 'Question about ' | append: product.title
  assign mail_body = 'I have a question about this piece:' | append: '%0A' | append: shop.url | append: product.url
-%}

<div class="pdp-inquire">
  <p class="pdp-inquire__label">Questions about this piece?</p>
  <div class="pdp-inquire__actions">
    <button type="button" class="pdp-inquire__btn" id="PdpAskOpen" aria-haspopup="dialog" aria-controls="PdpAskModal">
      Ask about this piece
    </button>
    <a class="pdp-inquire__btn pdp-inquire__btn--ghost" href="/pages/private-clients">Book a call</a>
    <a class="pdp-inquire__btn pdp-inquire__btn--ghost" href="mailto:{{ inquire_email }}?subject={{ mail_subject | url_encode }}&body={{ mail_body }}">
      Direct message
    </a>
  </div>
</div>

<div class="pdp-ask" id="PdpAskModal" hidden role="dialog" aria-modal="true" aria-labelledby="PdpAskTitle">
  <div class="pdp-ask__backdrop" data-ask-close></div>
  <div class="pdp-ask__panel">
    <button type="button" class="pdp-ask__close" data-ask-close aria-label="Close">&times;</button>
    <p class="pdp-ask__eyebrow">Private Client Desk</p>
    <h2 class="pdp-ask__title" id="PdpAskTitle">Ask about this piece</h2>
    <p class="pdp-ask__product">{{ product.title }}</p>

    {%- form 'contact', id: 'PdpAskForm', class: 'pdp-ask__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="pdp-ask__success" role="status">Thank you — we’ll reply within one business day.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="pdp-ask__error" role="alert">Please check your details and try again.</p>
      {%- endif -%}

      <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
      <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">

      <label for="PdpAskName">Name</label>
      <input id="PdpAskName" type="text" name="contact[name]" autocomplete="name" required>

      <label for="PdpAskEmail">Email</label>
      <input id="PdpAskEmail" type="email" name="contact[email]" autocomplete="email" required>

      <label for="PdpAskPhone">Phone <span>(optional)</span></label>
      <input id="PdpAskPhone" type="tel" name="contact[phone]" autocomplete="tel">

      <label for="PdpAskBody">Your question</label>
      <textarea id="PdpAskBody" name="contact[body]" rows="4" required>I'd like to know more about {{ product.title }} — {{ shop.url }}{{ product.url }}</textarea>

      <button type="submit" class="pdp-inquire__btn pdp-inquire__btn--submit">Send message</button>
    {%- endform -%}
  </div>
</div>

<style>
  .pdp-inquire {
    margin: 1.25rem 0 0;
    padding-top: 1.15rem;
    border-top: 1px solid var(--rule-light, #DDD5C5);
  }
  .pdp-inquire__label {
    margin: 0 0 0.75rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted, #8A8070);
  }
  .pdp-inquire__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .pdp-inquire__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.05rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cream, #FAF6F0);
    background: var(--espresso, #1E1109);
    border: 1px solid var(--espresso, #1E1109);
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
  }
  .pdp-inquire__btn--ghost {
    background: transparent;
    color: var(--text-dark, #2C1810);
    border-color: var(--border-medium, #CFC7B8);
  }
  .pdp-inquire__btn:hover,
  .pdp-inquire__btn--ghost:hover {
    border-color: var(--gold, #C9A050);
    color: var(--gold-dark, #A88340);
    background: rgba(201, 160, 80, 0.08);
  }
  .pdp-inquire__btn--submit {
    width: 100%;
    margin-top: 0.4rem;
  }

  .pdp-ask[hidden] { display: none !important; }
  .pdp-ask {
    position: fixed;
    inset: 0;
    z-index: 12000;
  }
  .pdp-ask__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(30, 17, 9, 0.55);
  }
  .pdp-ask__panel {
    position: relative;
    z-index: 1;
    width: min(480px, calc(100% - 2rem));
    margin: 8vh auto 0;
    padding: 2rem 1.6rem 1.6rem;
    background: var(--warm-white, #FDFAF6);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(30, 17, 9, 0.25);
  }
  .pdp-ask__close {
    position: absolute;
    top: 0.7rem;
    right: 0.9rem;
    border: 0;
    background: none;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--text-muted, #8A8070);
    cursor: pointer;
  }
  .pdp-ask__eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold, #C9A050);
  }
  .pdp-ask__title {
    margin: 0 0 0.35rem;
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1.7rem;
    font-weight: 400;
    color: var(--text-dark, #2C1810);
  }
  .pdp-ask__product {
    margin: 0 0 1.1rem;
    font-size: 0.85rem;
    color: var(--text-muted, #8A8070);
  }
  .pdp-ask__form label {
    display: block;
    margin: 0.7rem 0 0.3rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pdp-ask__form label span { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--text-muted, #8A8070); }
  .pdp-ask__form input,
  .pdp-ask__form textarea {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border-medium, #CFC7B8);
    border-radius: 4px;
    background: #fff;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.9rem;
  }
  .pdp-ask__success { color: #2F5D3A; background: rgba(47,93,58,.08); padding: .75rem; border-radius: 4px; }
  .pdp-ask__error { color: var(--wine, #4A1428); background: rgba(74,20,40,.07); padding: .75rem; border-radius: 4px; }
</style>

<script>
  (function () {
    var modal = document.getElementById('PdpAskModal');
    var openBtn = document.getElementById('PdpAskOpen');
    if (!modal || !openBtn) return;
    function open() {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      var field = document.getElementById('PdpAskName');
      if (field) field.focus();
    }
    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }
    openBtn.addEventListener('click', open);
    modal.querySelectorAll('[data-ask-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
    if (modal.querySelector('.pdp-ask__success')) open();
  })();
</script>
