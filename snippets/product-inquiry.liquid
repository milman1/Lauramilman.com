{%- comment -%}
  Product-page concierge. Same actions on every product. Each one opens
  Shopify chat with this piece in context. Add to cart stays on the form.
{%- endcomment -%}

<div class="pdp-inquire">
  <p class="pdp-inquire__label">Questions about this piece?</p>
  <div class="pdp-inquire__actions">
    <button
      type="button"
      class="pdp-inquire__btn js-open-product-chat"
      data-chat-intent="offer"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ shop.url }}{{ product.url }}"
    >
      Make an offer
    </button>
    <button
      type="button"
      class="pdp-inquire__btn pdp-inquire__btn--ghost js-open-product-chat"
      data-chat-intent="ask"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ shop.url }}{{ product.url }}"
    >
      Ask about this piece
    </button>
    <button
      type="button"
      class="pdp-inquire__btn pdp-inquire__btn--ghost js-open-product-chat"
      data-chat-intent="viewing"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ shop.url }}{{ product.url }}"
    >
      Private viewing
    </button>
  </div>
</div>

<style>
  .pdp-inquire {
    margin: 1.25rem 0 0;
    padding-top: 1.15rem;
    border-top: 1px solid var(--rule-light, #DDD5C5);
  }
  .pdp-inquire__label {
    margin: 0 0 0.75rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted, #8A8070);
  }
  .pdp-inquire__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .pdp-inquire__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.05rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cream, #FAF6F0);
    background: var(--espresso, #1E1109);
    border: 1px solid var(--espresso, #1E1109);
    border-radius: var(--radius-sm, 4px);
    cursor: pointer;
  }
  .pdp-inquire__btn--ghost {
    background: transparent;
    color: var(--text-dark, #2C1810);
    border-color: var(--border-medium, #CFC7B8);
  }
  .pdp-inquire__btn:hover,
  .pdp-inquire__btn--ghost:hover {
    border-color: var(--gold, #C9A050);
    color: var(--gold-dark, #A88340);
    background: rgba(201, 160, 80, 0.08);
  }
  .dpdp--navy .pdp-inquire__btn {
    background: var(--navy, #1A1F3A);
    border-color: var(--navy, #1A1F3A);
    color: #fff;
  }
  .dpdp--navy .pdp-inquire__btn--ghost {
    background: transparent;
    color: var(--navy, #1A1F3A);
    border-color: rgba(26, 31, 58, 0.35);
  }
  .dpdp--navy .pdp-inquire__btn:hover,
  .dpdp--navy .pdp-inquire__btn--ghost:hover {
    border-color: var(--pd-blue, #5B7FBD);
    color: var(--pd-blue, #5B7FBD);
    background: rgba(91, 127, 189, 0.08);
  }
</style>
