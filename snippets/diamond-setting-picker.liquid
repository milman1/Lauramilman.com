{% doc %}
  Matching available settings for a loose diamond, linked to the existing ring builder.
  @param {product} product - The selected loose diamond.
  @param {number} [max] - Maximum featured settings, default four.
{% enddoc %}
{%- capture stone_shape -%}{% render 'center-stone-shape', product: product %}{%- endcapture -%}
{%- liquid
  assign stone_shape = stone_shape | strip
  assign stone_price = product.selected_or_first_available_variant.price
  assign max = max | default: 4
  assign setting_collection = collections['ring-settings']
  assign matches = 0
-%}
{%- if stone_shape != blank and product.available -%}
  {%- capture cards -%}
    {%- for ring in setting_collection.products limit: 50 -%}
      {%- if matches < max and ring.available and ring.tags contains 'ring-setting' -%}
        {%- capture ring_shape -%}{% render 'center-stone-shape', product: ring %}{%- endcapture -%}
        {%- assign ring_shape = ring_shape | strip -%}
        {%- if ring_shape == stone_shape -%}
          {%- assign matches = matches | plus: 1 -%}
          {%- assign setting_prices = ring.variants | where: 'available', true | map: 'price' | uniq | sort -%}
          {%- assign setting_price = setting_prices | first -%}
          {%- assign setting_money = setting_price | money_without_trailing_zeros -%}
          {%- assign total_money = setting_price | plus: stone_price | money_without_trailing_zeros -%}
          <li class="dsp__card">
            <a class="dsp__link" href="{{ routes.root_url }}pages/ring-builder?setting={{ ring.handle | url_encode }}&amp;diamond={{ product.handle | url_encode }}">
              <span class="dsp__media">
                {%- if ring.featured_image -%}
                  <img src="{{ ring.featured_image | image_url: width: 600 }}"
                    srcset="{{ ring.featured_image | image_url: width: 320 }} 320w, {{ ring.featured_image | image_url: width: 600 }} 600w"
                    sizes="(max-width: 600px) 44vw, (max-width: 900px) 42vw, 280px"
                    alt="{{ ring.featured_image.alt | default: ring.title | escape }}"
                    width="600" height="600" loading="lazy">
                {%- endif -%}
              </span>
              <span class="dsp__name">{{ ring.title | remove: ' Engagement Ring Setting' | remove: ' Ring Setting' | remove: ' Engagement Ring' | escape }}</span>
              <span class="dsp__price">{% if setting_prices.size > 1 %}{{ 'diamond_purchase.setting_from' | t: price: setting_money }}{% else %}{{ 'diamond_purchase.setting_price' | t: price: setting_money }}{% endif %}</span>
              <span class="dsp__total">{% if setting_prices.size > 1 %}{{ 'diamond_purchase.total_from' | t: price: total_money }}{% else %}{{ 'diamond_purchase.total_price' | t: price: total_money }}{% endif %}</span>
              <span class="dsp__cta">{{ 'diamond_purchase.view_setting' | t }} →</span>
            </a>
          </li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if matches > 0 -%}
    <section class="dsp" aria-labelledby="DspHeading-{{ product.id }}" data-dsp data-stone-shape="{{ stone_shape | escape }}" data-stone-handle="{{ product.handle | escape }}">
      <div class="dsp__head">
        <p class="dsp__eyebrow">{{ 'diamond_purchase.make_ring' | t }}</p>
        <h2 class="dsp__heading" id="DspHeading-{{ product.id }}">{{ 'diamond_purchase.find_setting' | t }}</h2>
      </div>
      <ul class="dsp__row" role="list">{{ cards }}</ul>
      <p class="dsp__note">{{ 'diamond_purchase.setting_note' | t }}</p>
      <a class="dsp__all" href="{{ routes.root_url }}pages/ring-builder?diamond={{ product.handle | url_encode }}">{{ 'diamond_purchase.all_settings' | t }} →</a>
    </section>
  {%- endif -%}
  <style>
    .dsp {
      margin: 0;
      padding: 1rem 1rem 1.1rem;
      border: 1px solid var(--gold, #C9A050);
      border-radius: var(--radius-md, 8px);
      background: var(--warm-white, #FDFAF6);
    }
    .dsp [hidden] { display: none !important; }
    .dsp__eyebrow {
      margin: 0;
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--gold-dark, #A88340);
    }
    .dsp__heading {
      margin: 0.2rem 0 0.85rem;
      font-family: var(--font-heading, 'Cormorant Garamond', serif);
      font-size: 1.4rem;
      font-weight: 500;
      color: var(--text-dark, #2C1810);
    }
    .dsp__row {
      list-style: none;
      margin: 0;
      padding: 0 0 0.35rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.75rem;

    }
    .dsp__card { scroll-snap-align: start; }
    .dsp__link {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      height: 100%;
      color: var(--text-dark, #2C1810);
      text-decoration: none;
    }
    .dsp__media {
      display: block;
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: var(--radius-sm, 4px);
      background: var(--cream, #FAF6F0);
      border: 1px solid var(--border-light, #E8E2D8);
    }
    .dsp__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
    .dsp__link:hover .dsp__media img { transform: scale(1.04); }
    .dsp__link:hover .dsp__media { border-color: var(--gold, #C9A050); }
    .dsp__name {
      margin-top: 0.2rem;
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.75rem;
      line-height: 1.4;
    }
    .dsp__price,
    .dsp__total {
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.72rem;
      color: var(--text-muted, #8A8070);
    }
    .dsp__total { font-weight: 600; color: var(--gold-dark, #A88340); }
    .dsp__note {
      margin: 0.6rem 0 0;
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.76rem;
      line-height: 1.6;
      color: var(--text-muted, #8A8070);
    }
    .dsp__all {
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--gold-dark, #A88340);
    }
    .dsp__all { display: inline-block; margin-top: 0.5rem; letter-spacing: 0.04em; }
    .dsp__cta { margin-top: auto; padding-top: 0.5rem; font-size: 0.76rem; text-decoration: underline; color: var(--gold-dark, #A88340); }
    @media (max-width: 900px) { .dsp__row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  </style>

{%- endif -%}
