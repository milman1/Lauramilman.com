{% doc %}
  @param {product} product - Product to expose to the ring builder.
{% enddoc %}
{%- capture center_shape -%}{% render 'center-stone-shape', product: product %}{%- endcapture -%}
{%- assign center_shape = center_shape | strip -%}
{%- assign product_collection_handles = product.collections | map: 'handle' -%}
{"handle":{{ product.handle | json }},"title":{{ product.title | json }},"type":{{ product.type | json }},"shape":{{ center_shape | json }},"available":{{ product.available | json }},"band":{% if product.tags contains 'wedding-band' or product_collection_handles contains 'mens-wedding-bands' %}true{% else %}false{% endif %},"setting":{% if product.tags contains 'ring-setting' %}true{% else %}false{% endif %},"url":{{ product.url | json }},"image":{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}""{% endif %},"images":[{% for image in product.images limit: 10 %}{{ image | image_url: width: 1000 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],"options":[{% for option in product.options_with_values %}{"name":{{ option.name | json }},"values":[{% for value in option.values %}{{ value | append: '' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% unless forloop.last %},{% endunless %}{% endfor %}],"variants":[{% for variant in product.variants %}{"id":{{ variant.id | json }},"price":{{ variant.price | json }},"available":{{ variant.available | json }},"options":{{ variant.options | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}],"videos":[{% assign video_emitted = false %}{% for media in product.media %}{% if media.media_type == 'video' %}{% for source in media.sources %}{% if source.mime_type == 'video/mp4' %}{% if video_emitted %},{% endif %}{{ source.url | json }}{% assign video_emitted = true %}{% break %}{% endif %}{% endfor %}{% endif %}{% endfor %}]}
