{%- comment -%}
  Hold / still-available request for watches and vintage.
  Phone is required so the desk can confirm the piece and arrange a viewing.
  Renders nothing on other products.
{%- endcomment -%}
{%- capture is_watch -%}{% render 'product-is-watch', product: product %}{%- endcapture -%}
{%- capture is_vintage -%}{% render 'product-is-vintage', product: product %}{%- endcapture -%}
{%- if is_watch == 'true' or is_vintage == 'true' -%}
{%- liquid
  assign hold_tags = 'hold-request'
  if is_watch == 'true'
    assign hold_tags = hold_tags | append: ',watch-interest'
  endif
  if is_vintage == 'true'
    assign hold_tags = hold_tags | append: ',vintage-interest'
  endif
-%}
<div class="lm-hold" id="LmHold" hidden>
  <div class="lm-hold__backdrop" data-hold-close></div>
  <div class="lm-hold__card" role="dialog" aria-modal="true" aria-labelledby="LmHoldTitle">
    <button type="button" class="lm-hold__close" data-hold-close aria-label="Close">&times;</button>
    <p class="lm-hold__eyebrow">Private desk</p>
    <h2 class="lm-hold__title" id="LmHoldTitle">Hold this piece</h2>
    <p class="lm-hold__copy">
      Watches and estate jewels move. Leave your number — we will confirm this one is still here and call you to set a private viewing.
    </p>

    {%- form 'contact', id: 'LmHoldContact', class: 'lm-hold__form' -%}
      <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
      <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
      <input type="hidden" name="contact[request_type]" value="Hold this piece">
      <input type="hidden" name="contact[interest_tags]" value="{{ hold_tags | escape }}">

      <label class="visually-hidden" for="LmHoldName">Name</label>
      <input id="LmHoldName" type="text" name="contact[name]" placeholder="Your name" autocomplete="name" required>

      <label class="visually-hidden" for="LmHoldPhone">Phone</label>
      <input id="LmHoldPhone" type="tel" name="contact[phone]" placeholder="Phone number" autocomplete="tel" required>

      <label class="visually-hidden" for="LmHoldEmail">Email</label>
      <input id="LmHoldEmail" type="email" name="contact[email]" placeholder="Email" autocomplete="email" required value="{{ customer.email }}">

      <label class="visually-hidden" for="LmHoldNote">Note</label>
      <textarea id="LmHoldNote" name="contact[body]" rows="3" placeholder="Anything we should know — timing, box and papers, a viewing window."></textarea>

      <button type="submit">Ask us to hold it</button>
      <p class="lm-hold__fine">We use this number only to confirm this piece and arrange a viewing. Not a marketing list.</p>
    {%- endform -%}

    {%- form 'customer', id: 'LmHoldCustomer', class: 'lm-hold__customer' -%}
      <input type="hidden" name="contact[tags]" value="{{ hold_tags | escape }}">
      <input type="email" name="contact[email]" id="LmHoldCustomerEmail" value="{{ customer.email }}" autocomplete="email">
      <input type="tel" name="contact[phone]" id="LmHoldCustomerPhone" autocomplete="tel">
    {%- endform -%}

    <p class="lm-hold__success" id="LmHoldSuccess" hidden role="status">
      Received. We will confirm availability and call you to set a viewing.
    </p>
  </div>
</div>

<style>
  .lm-hold[hidden] { display: none !important; }
  .lm-hold {
    position: fixed;
    inset: 0;
    z-index: 12000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .lm-hold__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(30, 17, 9, 0.55);
  }
  .lm-hold__card {
    position: relative;
    z-index: 1;
    width: min(440px, 100%);
    padding: 2.1rem 1.7rem 1.5rem;
    background: var(--warm-white, #FDFAF6);
    border: 1px solid var(--gold, #C9A050);
  }
  .lm-hold__close {
    position: absolute;
    top: 0.55rem;
    right: 0.75rem;
    border: 0;
    background: none;
    font-size: 1.6rem;
    color: var(--text-muted, #8A8070);
    cursor: pointer;
  }
  .lm-hold__eyebrow {
    margin: 0 0 0.45rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-dark, #A88340);
  }
  .lm-hold__title {
    margin: 0 0 0.65rem;
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1.85rem;
    font-weight: 400;
    color: var(--text-dark, #2C1810);
  }
  .lm-hold__copy,
  .lm-hold__fine {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    color: var(--text-wine, #4A2018);
  }
  .lm-hold__copy { margin: 0 0 1.15rem; font-size: 0.9rem; line-height: 1.6; }
  .lm-hold__form { display: flex; flex-direction: column; gap: 0.55rem; }
  .lm-hold__form input,
  .lm-hold__form textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--border-medium, #CFC7B8);
    background: var(--warm-white, #FDFAF6);
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.9rem;
    color: var(--text-dark, #2C1810);
  }
  .lm-hold__form button {
    padding: 0.9rem 1rem;
    border: 0;
    background: var(--espresso, #1E1109);
    color: var(--cream, #FAF6F0);
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .lm-hold__fine { margin: 0.35rem 0 0; font-size: 0.72rem; }
  .lm-hold__success {
    margin: 0.9rem 0 0;
    padding: 0.8rem;
    background: rgba(47, 93, 58, 0.08);
    color: #2F5D3A;
    font-size: 0.88rem;
  }
  .lm-hold__customer {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .lm-hold .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('LmHold');
    if (!root) return;
    var contact = document.getElementById('LmHoldContact');
    var customer = document.getElementById('LmHoldCustomer');
    var success = document.getElementById('LmHoldSuccess');
    var productTitle = {{ product.title | json }};
    var productUrl = {{ shop.url | append: product.url | json }};

    function open() { root.hidden = false; }
    function close() { root.hidden = true; }

    root.querySelectorAll('[data-hold-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    document.querySelectorAll('[data-open-hold]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        open();
      });
    });

    if (!contact) return;
    contact.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = (document.getElementById('LmHoldName') || {}).value || '';
      var phone = (document.getElementById('LmHoldPhone') || {}).value || '';
      var email = (document.getElementById('LmHoldEmail') || {}).value || '';
      var note = (document.getElementById('LmHoldNote') || {}).value || '';
      if (!phone.trim() || !email.trim()) return;

      var body = [
        'HOLD REQUEST',
        'Product: ' + productTitle,
        'URL: ' + productUrl,
        'Name: ' + name,
        'Phone: ' + phone,
        '',
        note || 'Please confirm this piece is still available and call to arrange a private viewing.'
      ].join('\n');
      var bodyField = document.getElementById('LmHoldNote');
      if (bodyField) bodyField.value = body;

      var custEmail = document.getElementById('LmHoldCustomerEmail');
      var custPhone = document.getElementById('LmHoldCustomerPhone');
      if (custEmail) custEmail.value = email;
      if (custPhone) custPhone.value = phone;

      var btn = contact.querySelector('button[type="submit"]');
      if (btn) btn.disabled = true;

      var contactPost = fetch(contact.getAttribute('action') || '/contact', {
        method: 'POST',
        body: new FormData(contact),
        headers: { 'Accept': 'text/html' }
      });
      var customerPost = customer
        ? fetch(customer.getAttribute('action') || '/contact#contact_form', {
            method: 'POST',
            body: new FormData(customer),
            headers: { 'Accept': 'text/html' }
          }).catch(function () {})
        : Promise.resolve();

      Promise.all([contactPost, customerPost]).then(function () {
        contact.hidden = true;
        if (success) success.hidden = false;
      }).catch(function () {
        if (btn) btn.disabled = false;
        alert('We could not send that just now. Call or email hello@lauramilman.com.');
      });
    });
  })();
</script>
{%- endif -%}
