{% doc %}
  Long-form buying guide and FAQ under a collection's product grid.

  Content lives on the collection, not in the theme:
  - custom.guide_html (multi-line text holding HTML): the guide. Use h2/h3, p, ul and links.
  - custom.guide_faq (JSON): [{"question": "...", "answer": "..."}]. Answers may hold links.

  The FAQ is rendered as visible text and the FAQPage JSON-LD is built from the same
  entries, so the markup can never claim an answer the page doesn't show.
  Renders on page 1 only, and nothing at all when both fields are blank.

  @param {collection} collection - The collection being shown
  @param {number} [page_number] - paginate.current_page; the block shows on page 1 only
  @param {boolean} [accordion] - when true, each h2 in the guide becomes a closed
    section the visitor opens, so the page is short and scannable. All of the text
    stays in the page (a closed details element is still in the HTML), and the
    FAQ starts closed too. Without it the guide renders open, as before.

  @example
  {% render 'collection-longform', collection: collection, page_number: paginate.current_page %}
{% enddoc %}

{%- liquid
  assign guide_html = collection.metafields.custom.guide_html.value
  assign guide_faq = collection.metafields.custom.guide_faq.value
  assign faq_count = 0
  for faq in guide_faq
    if faq.question != blank and faq.answer != blank
      assign faq_count = faq_count | plus: 1
    endif
  endfor

  assign show_longform = false
  if guide_html != blank or faq_count > 0
    assign show_longform = true
  endif
  if page_number and page_number > 1
    assign show_longform = false
  endif
-%}

{%- if show_longform -%}
  {%- assign as_accordion = false -%}
  {%- if accordion and guide_html contains '<h2>' -%}
    {%- assign as_accordion = true -%}
  {%- endif -%}
  <section class="lm-longform{% if accordion %} lm-longform--accordion{% endif %}" aria-labelledby="lm-longform-{{ collection.id }}">
    <div class="lm-longform__inner">
      <h2 class="lm-longform__title" id="lm-longform-{{ collection.id }}">About {{ collection.title | escape }}</h2>

      {%- if guide_html != blank -%}
        {%- if as_accordion -%}
          {%- assign guide_parts = guide_html | split: '<h2>' -%}
          {%- assign guide_intro = guide_parts[0] | strip -%}
          {%- if guide_intro != blank -%}
            <div class="lm-longform__body">{{ guide_intro }}</div>
          {%- endif -%}
          <div class="lm-longform__sections">
            {%- for part in guide_parts offset: 1 -%}
              {%- assign pair = part | split: '</h2>' -%}
              {%- assign section_body = part | remove_first: pair[0] | remove_first: '</h2>' -%}
              <details class="lm-longform__sec">
                <summary><h2 class="lm-longform__sec-title">{{ pair[0] }}</h2></summary>
                <div class="lm-longform__body">{{ section_body }}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="lm-longform__body">{{ guide_html }}</div>
        {%- endif -%}
      {%- endif -%}

      {%- if faq_count > 0 -%}
        <div class="lm-longform__faq">
          <h2 class="lm-longform__faq-title">Questions</h2>
          {%- for faq in guide_faq -%}
            {%- if faq.question != blank and faq.answer != blank -%}
              <details class="lm-longform__q"{% if forloop.first and accordion == blank %} open{% endif %}>
                <summary>{{ faq.question | escape }}</summary>
                <div class="lm-longform__a"><p>{{ faq.answer }}</p></div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {%- assign faq_i = 0 -%}
              {%- for faq in guide_faq -%}
                {%- if faq.question != blank and faq.answer != blank -%}
                  {%- assign faq_i = faq_i | plus: 1 -%}
                  {
                    "@type": "Question",
                    "name": {{ faq.question | strip_html | json }},
                    "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | strip_html | json }} }
                  }{%- unless faq_i == faq_count -%},{%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          }
        </script>
      {%- endif -%}
    </div>
  </section>

  <style>
    .lm-longform {
      border-top: 1px solid #DDD5C5;
      margin-top: 3rem;
      padding: 2.75rem 0 0;
    }
    .lm-longform__inner {
      max-width: 46rem;
    }
    .lm-longform__title,
    .lm-longform__faq-title {
      font-family: var(--font-heading, 'Cormorant Garamond', Georgia, serif);
      font-weight: 400;
      font-size: clamp(1.5rem, 3vw, 1.9rem);
      color: var(--text-dark, #2C1810);
      margin: 0 0 1rem;
    }
    .lm-longform__body,
    .lm-longform__a {
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.95rem;
      line-height: 1.8;
      color: #4A3F35;
    }
    .lm-longform__body h2,
    .lm-longform__body h3 {
      font-family: var(--font-heading, 'Cormorant Garamond', Georgia, serif);
      font-weight: 500;
      color: var(--text-dark, #2C1810);
      margin: 1.75rem 0 0.6rem;
    }
    .lm-longform__body h2 { font-size: 1.4rem; }
    .lm-longform__body h3 { font-size: 1.2rem; }
    .lm-longform__body p { margin: 0 0 0.9rem; }
    .lm-longform__body ul { margin: 0 0 1rem; padding-left: 1.2rem; }
    .lm-longform__body li { margin-bottom: 0.4rem; }
    .lm-longform__body a,
    .lm-longform__a a {
      color: var(--text-dark, #2C1810);
      text-underline-offset: 0.2em;
    }
    .lm-longform__sections { margin-top: 1.25rem; }
    .lm-longform__sec { border-bottom: 1px solid #DDD5C5; }
    .lm-longform__sec summary,
    .lm-longform--accordion .lm-longform__q summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 52px;
      padding: 0.5rem 0;
      cursor: pointer;
      list-style: none;
      font-family: var(--font-heading, 'Cormorant Garamond', Georgia, serif);
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--text-dark, #2C1810);
    }
    .lm-longform--accordion .lm-longform__q summary { font-family: var(--font-body, 'Montserrat', sans-serif); font-size: 0.95rem; font-weight: 500; }
    .lm-longform__sec summary::-webkit-details-marker,
    .lm-longform--accordion .lm-longform__q summary::-webkit-details-marker { display: none; }
    .lm-longform__sec summary::after,
    .lm-longform--accordion .lm-longform__q summary::after {
      content: '+';
      flex-shrink: 0;
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 1.4rem;
      font-weight: 300;
      line-height: 1;
      color: #A88340;
    }
    .lm-longform__sec[open] summary::after,
    .lm-longform--accordion .lm-longform__q[open] summary::after { content: '\2212'; }
    .lm-longform__sec summary:focus-visible { outline: 2px solid #C9A050; outline-offset: 3px; }
    .lm-longform__sec-title { margin: 0; font: inherit; color: inherit; }
    .lm-longform__sec .lm-longform__body { padding-bottom: 0.75rem; }
    .lm-longform__sec .lm-longform__body > :first-child { margin-top: 0; }
    .lm-longform--accordion .lm-longform__faq { margin-top: 2rem; }
    .lm-longform--accordion .lm-longform__q { padding: 0; }
    .lm-longform--accordion .lm-longform__q .lm-longform__a { padding-bottom: 0.75rem; }
    .lm-longform__faq { margin-top: 2.25rem; }
    .lm-longform__q {
      border-bottom: 1px solid #DDD5C5;
      padding: 0.9rem 0;
    }
    .lm-longform__q summary {
      cursor: pointer;
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--text-dark, #2C1810);
      list-style-position: outside;
    }
    .lm-longform__q summary:focus-visible {
      outline: 2px solid #C9A050;
      outline-offset: 3px;
    }
    .lm-longform__a p { margin: 0.6rem 0 0; }
  </style>
{%- endif -%}
