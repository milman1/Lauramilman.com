{% comment %}
  Welcome offer popup — email signup for a jewelry-only discount.
  Rendered from layout/theme.liquid. The discount code is created in
  Shopify Admin (see SHOPIFY_SETUP.md). Kept as a snippet so it cannot
  fail as an invalid section type when included from the layout.
  Not rendered on ring-builder templates: it would open mid-choice, nor while
  the offer is paused for a store-wide sale (snippets/welcome-offer-paused.liquid).
{% endcomment %}

{%- comment -%} Paused during a store-wide sale: see snippets/welcome-offer-paused.liquid. {%- endcomment -%}
{%- capture welcome_paused -%}{% render 'welcome-offer-paused' %}{%- endcapture -%}
{%- unless customer.tags contains 'welcome10' or template.suffix contains 'ring-builder' or welcome_paused == 'true' -%}
<div class="lm-welcome" id="LmWelcome" hidden>
  <div class="lm-welcome__backdrop" data-welcome-close></div>
  <div class="lm-welcome__card" role="dialog" aria-modal="true" aria-labelledby="LmWelcomeTitle">
    <button type="button" class="lm-welcome__close" data-welcome-close aria-label="Close">&times;</button>
    <p class="lm-welcome__eyebrow">Private Offer</p>
    <h2 class="lm-welcome__title" id="LmWelcomeTitle">10% off your first jewel</h2>
    <p class="lm-welcome__copy">Join the inner circle for a welcome code — valid on jewelry, not watches.</p>

    {%- form 'customer', id: 'LmWelcomeForm', class: 'lm-welcome__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,welcome10">
      <label class="visually-hidden" for="LmWelcomeEmail">Email</label>
      <input
        id="LmWelcomeEmail"
        type="email"
        name="contact[email]"
        placeholder="Your email address"
        required
        autocomplete="email"
      >
      <button type="submit">Unlock my offer</button>

      {%- if form.posted_successfully? -%}
        <p class="lm-welcome__success" role="status">
          Your code is LMNYWELCOME. Use it at checkout on jewelry.
        </p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="lm-welcome__error">{{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
    <p class="lm-welcome__fine">One use per customer. Jewelry only — timepieces excluded. 14-day returns on jewelry.</p>
  </div>
</div>

{%- comment -%}
  Reopen tab: after a visitor closes the popup, a slim tab on the left edge
  brings the offer back, so closing it does not lose the 10%. Left edge, mid
  screen, to stay clear of the chat button (bottom right) and the full-width
  add-to-cart and diamond bars on mobile product pages. Its own × hides it for
  the rest of the visit (sessionStorage); it returns on the next visit.
{%- endcomment -%}
<div class="lm-welcome-tab" id="LmWelcomeTab" hidden>
  <button type="button" class="lm-welcome-tab__open" data-welcome-open aria-haspopup="dialog">10% off</button>
  <button type="button" class="lm-welcome-tab__hide" data-welcome-tab-hide aria-label="Hide the 10% off offer">&times;</button>
</div>

<style>
  .lm-welcome[hidden] { display: none !important; }
  .lm-welcome {
    position: fixed;
    inset: 0;
    z-index: 13000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .lm-welcome__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(30, 17, 9, 0.55);
  }
  .lm-welcome__card {
    position: relative;
    z-index: 1;
    width: min(440px, 100%);
    padding: 2.4rem 1.8rem 1.7rem;
    background: var(--warm-white, #FDFAF6);
    border: 1px solid var(--gold, #C9A050);
    text-align: center;
  }
  .lm-welcome__close {
    position: absolute;
    top: 0.6rem;
    right: 0.8rem;
    border: 0;
    background: none;
    font-size: 1.6rem;
    color: var(--text-muted, #8A8070);
    cursor: pointer;
  }
  .lm-welcome__eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-dark, #A88340);
  }
  .lm-welcome__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 2rem;
    font-weight: 400;
    color: var(--text-dark, #2C1810);
  }
  .lm-welcome__copy,
  .lm-welcome__fine {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    color: var(--text-wine, #4A2018);
  }
  .lm-welcome__copy { margin: 0 0 1.3rem; font-size: 0.92rem; line-height: 1.6; }
  .lm-welcome__form { display: flex; flex-direction: column; gap: 0.6rem; }
  .lm-welcome__form input {
    padding: 0.85rem 1rem;
    border: 1px solid var(--border-medium, #CFC7B8);
    font-family: var(--font-body, 'Montserrat', sans-serif);
    color: var(--text-dark, #2C1810);
  }
  .lm-welcome__form button {
    padding: 0.9rem 1rem;
    border: 0;
    background: var(--espresso, #1E1109);
    color: var(--cream, #FAF6F0);
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .lm-welcome__success {
    margin: 0.75rem 0 0;
    padding: 0.8rem;
    background: rgba(47, 93, 58, 0.08);
    color: #2F5D3A;
    font-size: 0.88rem;
  }
  .lm-welcome__fine { margin: 0.9rem 0 0; font-size: 0.72rem; }
  .lm-welcome-tab[hidden] { display: none !important; }
  .lm-welcome-tab {
    position: fixed;
    left: 0;
    top: 50%;
    z-index: 950;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateY(-50%);
    background: var(--espresso, #1E1109);
    border: 1px solid var(--gold, #C9A050);
    border-left: 0;
    box-shadow: 0 4px 14px rgba(30, 17, 9, 0.18);
  }
  .lm-welcome-tab__open {
    padding: 0.9rem 0.5rem;
    border: 0;
    background: none;
    color: var(--cream, #FAF6F0);
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    cursor: pointer;
  }
  .lm-welcome-tab__hide {
    width: 100%;
    padding: 0.25rem 0 0.4rem;
    border: 0;
    border-top: 1px solid rgba(201, 160, 80, 0.4);
    background: none;
    color: var(--gold, #C9A050);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .lm-welcome-tab button:focus-visible { outline: 2px solid var(--gold, #C9A050); outline-offset: -3px; }
  .lm-welcome .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('LmWelcome');
    if (!root) return;
    var key = 'lmny-welcome-dismissed';
    var joinedKey = 'lmny-welcome-joined';
    var tabKey = 'lmny-welcome-tab-hidden';
    var tab = document.getElementById('LmWelcomeTab');
    var success = !!root.querySelector('.lm-welcome__success');
    function get(store, k) { try { return store.getItem(k); } catch (e) { return null; } }
    function set(store, k) { try { store.setItem(k, '1'); } catch (e) {} }
    // The tab shows only after the popup was closed, never next to it, and
    // never once this browser has signed up or hidden it for this visit.
    function showTab(show) {
      if (!tab) return;
      tab.hidden = !(show && !get(localStorage, joinedKey) && !get(sessionStorage, tabKey));
    }
    function open() { root.hidden = false; showTab(false); }
    function close() {
      root.hidden = true;
      set(localStorage, key);
      showTab(true);
    }
    root.querySelectorAll('[data-welcome-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    if (tab) {
      tab.querySelector('[data-welcome-tab-hide]').addEventListener('click', function () {
        set(sessionStorage, tabKey);
        showTab(false);
      });
    }
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !root.hidden) close();
    });
    // A "sign up for 10% off" link on a product page opens the same popup,
    // even after the visitor dismissed the automatic one.
    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-welcome-open]');
      if (!trigger) return;
      event.preventDefault();
      open();
      var email = document.getElementById('LmWelcomeEmail');
      if (email) email.focus();
    });
    if (success) {
      set(localStorage, joinedKey);
      open();
      return;
    }
    if (get(localStorage, key)) {
      showTab(true);
      return;
    }
    var seenKey = 'lmny-welcome-seen';
    try {
      var seen = sessionStorage.getItem(seenKey);
      sessionStorage.setItem(seenKey, '1');
      if (!seen) return;
    } catch (e) {}
    function navOpen() {
      return !!document.querySelector('.header--nav-open, .section-header.menu-open, #header .nav__item.open, #nav [aria-expanded="true"], details.menu-opening');
    }
    function whenNavClosed(done) {
      if (!navOpen()) { done(); return; }
      var watch = document.getElementById('header') || document.body;
      var observer = new MutationObserver(function () {
        if (navOpen()) return;
        observer.disconnect();
        setTimeout(done, 800);
      });
      observer.observe(watch, { attributes: true, subtree: true, attributeFilter: ['class', 'aria-expanded'] });
    }
    setTimeout(function () { whenNavClosed(open); }, 20000);
  })();
</script>
{%- endunless -%}
