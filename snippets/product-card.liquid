{% comment %}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}

  data-* attributes power Peaceful Diamonds–style client filters on jewelry
  collection pages (style / metal / carat). Loose-diamond templates do not
  render this snippet.
{% endcomment %}

{%- liquid
  assign pc_tags = product.tags | join: '|||' | downcase
  assign pc_metal = product.metafields.custom.metal_type.value | default: '' | downcase
  assign pc_carat = product.metafields.custom.carat_weight.value | default: product.metafields.custom.diamond_weight.value | default: ''
-%}

<div
  class="product-card"
  data-tags="{{ pc_tags | escape }}"
  data-title="{{ product.title | escape }}"
  data-title-lower="{{ product.title | downcase | escape }}"
  data-type="{{ product.type | downcase | escape }}"
  data-price-cents="{{ product.price }}"
  data-metal="{{ pc_metal | escape }}"
  data-carat="{{ pc_carat | escape }}"
  data-vendor="{{ product.vendor | downcase | escape }}"
>
  <a href="{{ product.url }}" class="product-card__image-wrapper" aria-label="{{ product.title | escape }}">
    {%- if product.tags contains 'new' or product.tags contains 'new-arrival' -%}
      <span class="product-card__badge product-card__badge--new">New</span>
    {%- elsif product.tags contains 'bestseller' -%}
      <span class="product-card__badge product-card__badge--bestseller">Bestseller</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="product-card__badge product-card__badge--sale">Sale</span>
    {%- endif -%}

    {%- if product.featured_image -%}
      <img
        class="product-card__image product-card__image--primary"
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        loading="lazy"
      >
      {%- if product.images[1] -%}
        <img
          class="product-card__image product-card__image--hover"
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.images[1].alt | default: product.title | escape }}"
          width="{{ product.images[1].width }}"
          height="{{ product.images[1].height }}"
          loading="lazy"
        >
      {%- endif -%}
    {%- else -%}
      <div class="product-card__image product-card__image--placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
      </div>
    {%- endif -%}
  </a>

  <div class="product-card__content">
    {%- render 'lab-grown-tag', product: product -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__price--sale">{{ product.price | money }}</span>
        <s class="product-card__price--compare">{{ product.compare_at_price | money }}</s>
      {%- else -%}
        <span>{{ product.price | money }}</span>
      {%- endif -%}
    </div>

    <div class="product-card__meta">
      {%- if product.vendor != blank -%}
        <span class="product-card__vendor">{{ product.vendor }}</span>
      {%- elsif product.type != blank -%}
        <span class="product-card__type">{{ product.type }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
