{% comment %}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}

  data-* attributes power lab-grown-style client filters on jewelry
  collection pages (style / metal / carat). Loose-diamond templates do not
  render this snippet.
{% endcomment %}

{%- liquid
  assign pc_tags = product.tags | join: '|||' | downcase
  assign pc_metal = product.metafields.custom.metal_type.value | default: '' | downcase
  if product.tags contains 'Diamond Rings'
    assign pc_metal = product.metafields.custom.metal.value | default: product.metafields.custom.metal_type.value | default: '' | downcase
  endif
  assign pc_carat = product.metafields.custom.carat_weight.value | default: product.metafields.custom.diamond_weight.value | default: ''
  assign display_title = product.title | replace: 'Jacob & Company', 'Jacob & Co.' | replace: 'Jacob and Company', 'Jacob & Co.'
  assign display_vendor = product.vendor | replace: 'Jacob & Company', 'Jacob & Co.' | replace: 'Jacob and Company', 'Jacob & Co.'
-%}

{%- capture pc_filter_options -%}
  {%- if collection.handle == 'everyday-jewelry' -%}
    {%- for option in product.options_with_values -%}
      {%- assign option_name = option.name | downcase -%}
      {%- if option_name contains 'metal' or option_name == 'material' -%}
        {{- option.values | join: '|||' -}}|||
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="product-card"
  data-tags="{{ pc_tags | escape }}"
  data-title="{{ display_title | escape }}"
  data-title-lower="{{ display_title | downcase | escape }}"
  data-type="{{ product.type | downcase | escape }}"
  data-price-cents="{{ product.price }}"
  data-metal="{{ pc_metal | escape }}"
  data-carat="{{ pc_carat | escape }}"
  {% if collection.handle == 'everyday-jewelry' %}data-metal-options="{{ pc_filter_options | downcase | escape }}"{% endif %}
  data-vendor="{{ product.vendor | downcase | escape }}"
>
  <a href="{{ product.url }}" class="product-card__image-wrapper" aria-label="{{ display_title | escape }}">
    {%- if product.tags contains 'new' or product.tags contains 'new-arrival' -%}
      <span class="product-card__badge product-card__badge--new">New</span>
    {%- elsif product.tags contains 'bestseller' -%}
      <span class="product-card__badge product-card__badge--bestseller">Bestseller</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="product-card__badge product-card__badge--sale">Sale</span>
    {%- endif -%}

    {%- if product.featured_image -%}
      <img
        class="product-card__image product-card__image--primary"
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: display_title | escape }}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        loading="lazy"
      >
      {%- if product.images[1] -%}
        <img
          class="product-card__image product-card__image--hover"
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.images[1].alt | default: display_title | escape }}"
          width="{{ product.images[1].width }}"
          height="{{ product.images[1].height }}"
          loading="lazy"
        >
      {%- endif -%}
    {%- else -%}
      <div class="product-card__image product-card__image--placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-svg' }}
      </div>
    {%- endif -%}
  </a>

  <div class="product-card__content">
    {%- render 'lab-grown-tag', product: product -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ display_title }}</a>
    </h3>

    <div class="product-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__price--sale">{{ product.price | money }}</span>
        <s class="product-card__price--compare">{{ product.compare_at_price | money }}</s>
      {%- else -%}
        <span>{{ product.price | money }}</span>
      {%- endif -%}
    </div>

    <div class="product-card__meta">
      {%- if product.vendor != blank -%}
        <span class="product-card__vendor">{{ display_vendor }}</span>
      {%- elsif product.type != blank -%}
        <span class="product-card__type">{{ product.type }}</span>
      {%- endif -%}
    </div>
    {%- if show_reserve -%}
      <button
        type="button"
        class="lm-stone-card__reserve"
        data-reserve-stone
        data-reserve-title="{{ display_title | escape }}"
        data-reserve-url="{{ product.url }}"
        data-reserve-stock="{{ product.metafields.lmny_feed.stock_ref.value | default: product.metafields.lmny_feed.cert_number.value | escape }}"
        data-reserve-price="{{ product.price | money_without_trailing_zeros | strip_html | escape }}"
      >Ask about this stone</button>
    {%- endif -%}
  </div>
</div>