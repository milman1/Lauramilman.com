{% doc %}
  Displays the in-person and virtual booking links on product pages.
  @param {string} section_id - The containing section ID.
{% enddoc %}

{%- assign booking_dialog_id = 'PdpBooking-' | append: section_id -%}
<div class="product-appointment-links">
  <a href="https://calendly.com/hello-lauramilman/30min" data-pdp-dialog-trigger aria-haspopup="dialog" aria-controls="{{ booking_dialog_id }}">{{ 'product_appointments.in_person' | t }}</a>
  <a href="https://calendly.com/hello-lauramilman/virtual-meeting" data-pdp-dialog-trigger aria-haspopup="dialog" aria-controls="{{ booking_dialog_id }}">{{ 'product_appointments.virtual' | t }}</a>
</div>

<dialog class="pdp-dialog pdp-dialog--booking" id="{{ booking_dialog_id }}" aria-labelledby="{{ booking_dialog_id }}-title">
  <div class="pdp-dialog__header">
    <h2 id="{{ booking_dialog_id }}-title" data-pdp-dialog-title>{{ 'product_appointments.book_appointment' | t }}</h2>
    <button type="button" class="pdp-dialog__close" data-pdp-dialog-close aria-label="{{ 'accessibility.close' | t }}" autofocus>×</button>
  </div>
  <iframe class="pdp-dialog__booking-frame" data-pdp-booking-frame title="{{ 'product_appointments.book_appointment' | t }}"></iframe>
</dialog>

{% stylesheet %}
  .product-appointment-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-block: 0.75rem;
  }

  .product-appointment-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    border: 1px solid currentColor;
    color: var(--wine, #49172b);
    font-size: 0.875rem;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
  }

  .product-appointment-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product-appointment-links a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
{% endstylesheet %}
