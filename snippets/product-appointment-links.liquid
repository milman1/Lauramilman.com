{% doc %}
  Displays the in-person and virtual booking links on product pages.
{% enddoc %}

<div class="product-appointment-links">
  <a href="https://calendly.com/hello-lauramilman/30min">{{ 'product_appointments.in_person' | t }}</a>
  <a href="https://calendly.com/hello-lauramilman/virtual-meeting">{{ 'product_appointments.virtual' | t }}</a>
</div>

{% stylesheet %}
  .product-appointment-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-block: 0.75rem;
  }

  .product-appointment-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    border: 1px solid currentColor;
    color: var(--wine, #49172b);
    font-size: 0.875rem;
    line-height: 1.35;
    text-align: center;
    text-decoration: none;
  }

  .product-appointment-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product-appointment-links a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
{% endstylesheet %}
