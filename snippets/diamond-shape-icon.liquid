{%- comment -%}
  Diamond Shape SVG Icons
{%- endcomment -%}

{%- liquid
  assign key = shape | downcase | strip
  case key
    when 'trilliant', 'triangle'
      assign key = 'trillion'
    when 'cushion brilliant', 'cushion modified'
      assign key = 'cushion'
    when 'oval step', 'oval step cut', 'oldmine oval'
      assign key = 'oval'
    when 'pear step', 'oldmine pear'
      assign key = 'pear'
    when 'marquise step', 'dutch marquise', 'dutch marquise step'
      assign key = 'marquise'
    when 'hexagonal step'
      assign key = 'hexagonal'
    when 'halfmoon'
      assign key = 'half moon'
    when 'europeancut', 'old european'
      assign key = 'european cut'
    when 'lady heart'
      assign key = 'heart'
    when 'oldmine moval', 'old moval'
      assign key = 'moval'
    when 'tycoon', 'tycoon cut', 'oldmine cushion', 'square cushion stepcut'
      assign key = 'cushion'
    when 'round star', 'round rose cut'
      assign key = 'round'
    when 'oldmine asscher'
      assign key = 'asscher'
    when 'oldmine marquise', 'marquise modified brilli'
      assign key = 'marquise'
    when 'octagonal step cut'
      assign key = 'octagonal'
    when 'oval polygon step cut'
      assign key = 'oval'
    when 'kite step', 'kite step cut'
      assign key = 'kite'
  endcase
-%}
{%- case key -%}
  {%- when 'round' -%}
    <svg class="shape-btn__icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="20" cy="20" r="16" stroke="currentColor" stroke-width="1.5"/>
      <path d="M20 4 L28 20 L20 36 L12 20 Z" stroke="currentColor" stroke-width="1" fill="none"/>
      <circle cx="20" cy="20" r="6" stroke="currentColor" stroke-width="1"/>
    </svg>
  
  {%- when 'princess' -%}
    <svg class="shape-btn__icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="6" y="6" width="28" height="28" stroke="currentColor" stroke-width="1.5"/>
      <path d="M6 6 L20 20 L34 6" stroke="currentColor" stroke-width="1"/>
