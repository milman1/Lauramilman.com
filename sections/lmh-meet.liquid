{%- comment -%}
  "Meet Laura Milman": portrait at left, a heading, one line and a link.
  Stacks on phones.
{%- endcomment -%}
{{ 'lmny-home.css' | asset_url | stylesheet_tag }}

<section class="lmh lmh-meet" aria-labelledby="LmhMeet-{{ section.id }}">
  <div class="lmh-meet__media">
    {%- render 'lmh-img', img: section.settings.image, asset: section.settings.image_asset, alt: section.settings.image_alt, sizes: '(max-width: 749px) 100vw, 50vw' -%}
  </div>
  <div class="lmh-meet__copy">
    <h2 class="lmh-h2" id="LmhMeet-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.link_text != blank -%}
      <a class="lmh-arrow" href="{{ section.settings.link_url | default: '/pages/about' }}">{{ section.settings.link_text | escape }} {% render 'lmh-arrow' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "LM meet Laura",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Portrait", "info": "Use a real photo of Laura." },
    { "type": "text", "id": "image_asset", "label": "Theme asset image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Laura Milman" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Meet Laura Milman" },
    { "type": "text", "id": "text", "label": "Line", "default": "Discover the story behind the jewelry." },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Read Laura's Story" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [{ "name": "LM meet Laura" }]
}
{% endschema %}
