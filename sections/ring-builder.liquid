{%- comment -%}
  Laura Milman New York — Ring Builder

  Three ways in, ordered by what the store can actually fill: complete rings
  first (the deepest book), then a loose natural stone paired with a mount,
  then setting-only pieces.

  Every path is a block, and a block renders only when it resolves to a real
  destination — an explicit CTA link, a collection that still holds products,
  or a fallback link for when that collection runs dry. A path with none of
  those disappears instead of shipping a dead link or an empty collection,
  which is what the earlier two-card version of this page risked.

  Center-stone origin (lab-grown or natural) is a per-product fact and is
  printed on the product page, never claimed here for a whole path.
{%- endcomment -%}

{%- liquid
  assign path_blocks = section.blocks | where: 'type', 'path'
  assign step_blocks = section.blocks | where: 'type', 'step'
-%}

<section class="lm-builder" aria-label="Ring builder">
  <div class="lm-builder__container">

    <header class="lm-builder__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="lm-builder__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.description != blank -%}
        <p class="lm-builder__desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </header>

    {%- if path_blocks.size > 0 -%}
      <div class="lm-builder__paths lm-builder__paths--{{ path_blocks.size }}">
        {%- for block in path_blocks -%}
          {%- liquid
            assign path_collection = block.settings.collection
            assign path_count = 0
            if path_collection != blank
              assign path_count = path_collection.products_count
            endif

            assign path_url = block.settings.cta_url
            if path_url == blank
              if path_count > 0
                assign path_url = path_collection.url
              else
                assign path_url = block.settings.fallback_url
              endif
            endif

            assign count_noun = block.settings.count_noun | default: 'piece'
            assign count_noun_plural = count_noun | append: 's'

            comment
              Liquid has no thousands filter, and the loose-stone books run to
              four and five figures, so "2513 stones" would read as a typo.
            endcomment
            assign count_display = path_count | append: ''
            if path_count >= 1000
              assign count_thousands = path_count | divided_by: 1000
              assign count_remainder = path_count | modulo: 1000 | prepend: '00' | slice: -3, 3
              assign count_display = count_thousands | append: ',' | append: count_remainder
            endif
          -%}

          {%- if path_url != blank -%}
            <article
              class="lm-builder__path{% if block.settings.featured %} lm-builder__path--featured{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.featured and block.settings.badge != blank -%}
                <span class="lm-builder__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}

              <div class="lm-builder__path-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'diamond' -%}
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg>
                  {%- when 'setting' -%}
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="7"/><path d="m9 7 1.5-4h3L15 7"/><path d="M9 7h6"/></svg>
                  {%- else -%}
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="15" r="6.5"/><path d="m8.5 6.5 1.5-3h4l1.5 3"/><path d="m12 3.5-2.2 3 2.2 2.2L14.2 6.5z"/></svg>
                {%- endcase -%}
              </div>

              <h2 class="lm-builder__path-title">{{ block.settings.title | escape }}</h2>

              {%- if path_count > 0 -%}
                <p class="lm-builder__path-count">
                  {{ count_display }} {{ path_count | pluralize: count_noun, count_noun_plural }} available
                </p>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="lm-builder__path-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

              <a
                href="{{ path_url }}"
                class="btn {% if block.settings.featured %}btn--gold{% else %}btn--outline{% endif %} lm-builder__path-cta"
              >
                {{ block.settings.cta_text | default: 'Explore' | escape }}
              </a>

              {%- if block.settings.note != blank -%}
                <p class="lm-builder__path-note">{{ block.settings.note | escape }}</p>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.origin_note != blank -%}
      <p class="lm-builder__origin">{{ section.settings.origin_note | escape }}</p>
    {%- endif -%}

    {%- if step_blocks.size > 0 -%}
      <div class="lm-builder__steps">
        {%- for block in step_blocks -%}
          <div class="lm-builder__step" {{ block.shopify_attributes }}>
            <span class="lm-builder__step-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="lm-builder__step-title">{{ block.settings.title | escape }}</h3>
            <p class="lm-builder__step-text">{{ block.settings.text | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.help_text != blank and section.settings.help_url != blank -%}
      <p class="lm-builder__help">
        <a href="{{ section.settings.help_url }}">{{ section.settings.help_text | escape }}</a>
      </p>
    {%- endif -%}

  </div>
</section>

<style>
  .lm-builder {
    background: var(--warm-white, #FDFAF6);
    padding: 3rem 2rem 5rem;
  }

  .lm-builder__container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .lm-builder__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3.5rem;
  }

  .lm-builder__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    color: var(--text-dark, #2C1810);
    margin: 0.5rem 0 1rem;
  }

  .lm-builder__desc {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--text-muted, #8A8070);
    margin: 0;
  }

  .lm-builder__paths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
    align-items: stretch;
    margin-bottom: 2rem;
  }

  .lm-builder__path {
    position: relative;
    background: var(--cream, #FAF6F0);
    border: 1px solid var(--rule-light, #DDD5C5);
    border-radius: var(--radius-lg, 12px);
    padding: 3rem 2rem 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .lm-builder__path:hover {
    border-color: rgba(201, 160, 80, 0.5);
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  .lm-builder__path--featured {
    border-color: rgba(201, 160, 80, 0.65);
    box-shadow: 0 10px 40px rgba(201, 160, 80, 0.16);
  }

  .lm-builder__badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--espresso, #1E1109);
    background: var(--gold, #C9A050);
    border-radius: 999px;
    padding: 0.4rem 1rem;
  }

  .lm-builder__path-icon {
    color: var(--gold, #C9A050);
    margin-bottom: 1.25rem;
  }

  .lm-builder__path-title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--text-dark, #2C1810);
    margin: 0 0 0.5rem;
  }

  .lm-builder__path-count {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold, #C9A050);
    margin: 0 0 0.85rem;
  }

  .lm-builder__path-text {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1.75;
    color: var(--text-muted, #8A8070);
    margin: 0 0 1.75rem;
    flex: 1;
  }

  .lm-builder__path-cta {
    width: 100%;
  }

  .lm-builder__path-note {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-style: italic;
    color: var(--text-muted, #8A8070);
    margin: 1rem 0 0;
  }

  .lm-builder__origin {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.78rem;
    font-weight: 300;
    line-height: 1.7;
    text-align: center;
    color: var(--text-muted, #8A8070);
    max-width: 620px;
    margin: 0 auto 3.5rem;
  }

  .lm-builder__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-top: 3rem;
    border-top: 1px solid var(--rule-light, #DDD5C5);
  }

  .lm-builder__step {
    text-align: center;
  }

  .lm-builder__step-num {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1.1rem;
    color: var(--gold, #C9A050);
    letter-spacing: 0.1em;
  }

  .lm-builder__step-title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-dark, #2C1810);
    margin: 0.5rem 0;
  }

  .lm-builder__step-text {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.83rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-muted, #8A8070);
    margin: 0;
  }

  .lm-builder__help {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.82rem;
    text-align: center;
    margin: 2.5rem 0 0;
  }

  .lm-builder__help a {
    color: var(--text-dark, #2C1810);
    border-bottom: 1px solid var(--gold, #C9A050);
    padding-bottom: 2px;
  }

  @media (max-width: 900px) {
    .lm-builder__paths {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .lm-builder__steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .lm-builder {
      padding: 2rem 1.25rem 3.5rem;
    }
    .lm-builder__path {
      padding: 2.5rem 1.5rem 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Ring Builder",
  "tag": "section",
  "class": "section-ring-builder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ring Builder"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Build Your Ring"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Three ways to begin. Take a ring that is finished and ready, choose a natural diamond and have it set, or start from a setting you love."
    },
    {
      "type": "textarea",
      "id": "origin_note",
      "label": "Center-stone origin note",
      "info": "Origin is a per-product fact. Each product page states whether its center stone is lab-grown or natural; this line only tells the customer where to look.",
      "default": "Every ring lists its center stone — lab-grown or natural — on its own product page."
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help link text",
      "default": "Not sure where to start? Talk to a specialist."
    },
    {
      "type": "url",
      "id": "help_url",
      "label": "Help link"
    }
  ],
  "blocks": [
    {
      "type": "path",
      "name": "Path",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Start with a Setting"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ring", "label": "Complete ring" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "setting", "label": "Setting" }
          ],
          "default": "ring"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Drives the live count. When this collection has no products, the path uses its fallback link — and hides entirely when there is no fallback."
        },
        {
          "type": "text",
          "id": "count_noun",
          "label": "Count noun",
          "info": "Singular. 'ring' prints '12 rings available'.",
          "default": "piece"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA link override",
          "info": "Leave empty to link to the collection above."
        },
        {
          "type": "url",
          "id": "fallback_url",
          "label": "Fallback link",
          "info": "Used when the collection is empty. Leave empty to hide this path while it has nothing to sell."
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Feature this path",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Shown only on a featured path."
        }
      ]
    },
    {
      "type": "step",
      "name": "How-it-works step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose Your Path"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ring Builder",
      "blocks": [
        {
          "type": "path",
          "settings": {
            "title": "Complete Rings",
            "text": "Finished engagement rings, center stone already set. Choose one, size it, and it ships.",
            "icon": "ring",
            "count_noun": "ring",
            "cta_text": "Shop Engagement Rings",
            "note": "Ready to size and ship",
            "featured": true,
            "badge": "Ready to wear"
          }
        },
        {
          "type": "path",
          "settings": {
            "title": "Build with a Natural Diamond",
            "text": "Choose a natural stone by cut, color, clarity and carat. We pair it with a setting and confirm every detail before anything is made.",
            "icon": "diamond",
            "count_noun": "stone",
            "cta_text": "Source Your Diamond",
            "note": "Guided one-on-one by a diamond specialist"
          }
        },
        {
          "type": "path",
          "settings": {
            "title": "Start with a Setting",
            "text": "Browse solitaires, hidden halos and three-stone mounts priced without a center stone, then choose the diamond that goes in.",
            "icon": "setting",
            "count_noun": "setting",
            "cta_text": "Browse Settings",
            "note": "Priced without center stone"
          }
        },
        { "type": "step", "settings": { "title": "Choose Your Path", "text": "Begin with a finished ring, a diamond, or a setting — whichever you know first." } },
        { "type": "step", "settings": { "title": "Pair & Perfect", "text": "We match stone and setting, and confirm every detail with you before a single thing is made." } },
        { "type": "step", "settings": { "title": "Crafted in Italy", "text": "Your ring is finished by master goldsmiths and delivered fully insured, with papers." } }
      ]
    }
  ]
}
{% endschema %}
