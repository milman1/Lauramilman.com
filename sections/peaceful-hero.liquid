{%- comment -%}
  Peaceful Diamonds collection hero
  Navy + diamond banner with gold/cream type, matching the lab-grown campaign.
  Falls back to the theme asset so the banner renders before a merchant uploads
  a replacement in the theme editor.
{%- endcomment -%}

{%- liquid
  assign hero_image = section.settings.background_image
  assign hero_src = ''
  if hero_image != blank
    assign hero_src = hero_image | image_url: width: 1920
  else
    assign hero_src = 'peaceful-hero-diamonds.jpg' | asset_url
  endif
-%}

<section class="pd-hero" aria-label="{{ section.settings.heading | escape }}">
  <div class="pd-hero__media" aria-hidden="true">
    <img
      class="pd-hero__image"
      src="{{ hero_src }}"
      {% if hero_image != blank %}
        srcset="{{ hero_image | image_url: width: 800 }} 800w,
                {{ hero_image | image_url: width: 1200 }} 1200w,
                {{ hero_image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
      {% endif %}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
    <div class="pd-hero__scrim"></div>
  </div>

  <div class="pd-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pd-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="pd-hero__title">{{ section.settings.heading }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="pd-hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="pd-hero__actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_url | default: '#productsGrid' }}" class="pd-hero__btn pd-hero__btn--solid">
          {{ section.settings.primary_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_url | default: '/collections/lab-grown-rings' }}" class="pd-hero__btn pd-hero__btn--ghost">
          {{ section.settings.secondary_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .pd-hero {
    position: relative;
    min-height: min(78vh, 720px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--navy-deep, #12162B);
    color: #fff;
  }

  .pd-hero__media,
  .pd-hero__image,
  .pd-hero__scrim {
    position: absolute;
    inset: 0;
  }

  .pd-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .pd-hero__scrim {
    background:
      linear-gradient(180deg, rgba(18, 22, 43, 0.55) 0%, rgba(18, 22, 43, 0.28) 42%, rgba(18, 22, 43, 0.72) 100%),
      radial-gradient(ellipse 55% 50% at 50% 40%, rgba(18, 22, 43, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .pd-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 5.5rem 1.5rem 4.5rem;
    max-width: 860px;
  }

  .pd-hero__eyebrow {
    margin: 0 0 1.5rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold, #C9A050);
  }

  .pd-hero__title {
    margin: 0 0 1.1rem;
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 400;
    line-height: 1.12;
    color: #F4E8C9;
  }

  .pd-hero__sub {
    margin: 0 auto 2.25rem;
    max-width: 520px;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
  }

  .pd-hero__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .pd-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 240px;
    padding: 14px 28px;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }

  .pd-hero__btn--solid {
    background: #C4A574;
    color: #1A140C;
    border: 1px solid #C4A574;
  }

  .pd-hero__btn--solid:hover {
    background: #d4b888;
    transform: translateY(-2px);
  }

  .pd-hero__btn--ghost {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.85);
  }

  .pd-hero__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  @media (max-width: 749px) {
    .pd-hero {
      min-height: 70vh;
    }
    .pd-hero__btn {
      min-width: 0;
      width: 100%;
      max-width: 320px;
    }
  }
</style>

{% schema %}
{
  "name": "Peaceful Diamonds hero",
  "tag": "section",
  "class": "section-peaceful-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New York · 30+ Years Experience"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Standard for Lab-Grown Diamonds"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Ethically created. Modern luxury, redefined."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button",
      "default": "Shop Lab-Grown Diamonds"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Explore Our Collections"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. If empty, the theme uses the built-in diamond velvet banner."
    }
  ],
  "presets": [
    {
      "name": "Peaceful Diamonds hero"
    }
  ]
}
{% endschema %}
