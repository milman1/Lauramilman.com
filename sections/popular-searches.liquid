{%- comment -%}
  Laura Milman New York — Popular Searches bar
  Site-wide quick-link strip below the fixed header. Every default link resolves:
  search URLs always exist; collection links use verified live handles.
{%- endcomment -%}

{%- if section.settings.enabled and section.blocks.size > 0 -%}
<div class="popular-searches" role="navigation" aria-label="Popular searches">
  <div class="popular-searches__inner">
    <span class="popular-searches__label">{{ section.settings.label }}</span>
    <div class="popular-searches__links">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank and block.settings.title != blank -%}
          <a href="{{ block.settings.link }}" class="popular-searches__link" {{ block.shopify_attributes }}>{{ block.settings.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .popular-searches {
    background: var(--espresso, #1E1109);
    border-bottom: 1px solid rgba(201, 160, 80, 0.18);
  }

  .popular-searches__inner {
    max-width: var(--container-max, 1400px);
    margin: 0 auto;
    padding: 0.55rem 2rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .popular-searches__inner::-webkit-scrollbar {
    display: none;
  }

  .popular-searches__label {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(250, 246, 240, 0.45);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .popular-searches__links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .popular-searches__link {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgba(250, 246, 240, 0.8);
    text-decoration: none;
    padding: 0.3rem 0.85rem;
    border: 1px solid rgba(250, 246, 240, 0.14);
    border-radius: 100px;
    white-space: nowrap;
    transition: all 0.25s ease;
  }

  .popular-searches__link:hover {
    color: var(--gold-light, #E2C27A);
    border-color: var(--gold, #C9A050);
    background: rgba(201, 160, 80, 0.08);
  }

  @media (max-width: 768px) {
    .popular-searches__inner {
      padding: 0.5rem 1rem;
      gap: 0.75rem;
    }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Popular Searches",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show bar",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Popular Searches"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "title": "Peaceful Diamonds", "link": "/collections/peaceful-diamonds-by-laura-milman-new-york" } },
      { "type": "link", "settings": { "title": "Loose Diamonds", "link": "/collections/natural-diamonds" } },
      { "type": "link", "settings": { "title": "Pre-Owned Cartier", "link": "/collections/cartier" } },
      { "type": "link", "settings": { "title": "Vintage & Estate", "link": "/collections/estate-jewelry" } },
      { "type": "link", "settings": { "title": "Timepieces", "link": "/collections/time-pieces" } },
      { "type": "link", "settings": { "title": "Engagement Rings", "link": "/search?q=engagement+ring&type=product" } },
      { "type": "link", "settings": { "title": "Necklaces", "link": "/search?q=necklace&type=product" } }
    ]
  }
}
{% endschema %}
