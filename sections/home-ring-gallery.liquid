{{ 'lmny-home.css' | asset_url | stylesheet_tag }}
<lmny-ring-gallery class="lmh hrg" id="HomeRingGallery-{{ section.id }}" aria-labelledby="GalleryTitle-{{ section.id }}">
  <header class="hrg__header">
    <h2 class="lmh-h2" id="GalleryTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle | escape }}</p>{%- endif -%}
  </header>
  <nav class="hrg__tabs" aria-label="{{ 'home_ring_gallery.starting_point' | t }}">
    <a class="hrg__tab" id="DiamondTab-{{ section.id }}" href="#DiamondGallery-{{ section.id }}" data-gallery-tab>{{ 'home_ring_gallery.diamond_tab' | t }}</a>
    <a class="hrg__tab" id="RingTab-{{ section.id }}" href="#RingGallery-{{ section.id }}" data-gallery-tab>{{ 'home_ring_gallery.ring_tab' | t }}</a>
    {%- if section.settings.color_image != blank -%}
      <a class="hrg__tab" id="ColorTab-{{ section.id }}" href="#ColorGallery-{{ section.id }}" data-gallery-tab>{{ 'home_ring_gallery.color_tab' | t }}</a>
    {%- endif -%}
  </nav>
  <div class="hrg__panel" id="DiamondGallery-{{ section.id }}" data-gallery-panel>
    <ul class="hrg__track" data-gallery-track>
      {%- for block in section.blocks -%}
        {%- unless block.type == 'diamond' -%}{%- continue -%}{%- endunless -%}
        <li class="hrg__card" {{ block.shopify_attributes }}>
          <a href="{{ routes.collections_url }}/lab-grown-diamonds?shape={{ block.settings.shape | url_encode }}">
            {%- if section.settings.diamond_artwork != blank and block.settings.artwork_x != blank -%}
              {%- render 'home-gallery-artwork', artwork: section.settings.diamond_artwork, x: block.settings.artwork_x, y: 265, crop_width: 250, crop_height: 230, label: block.settings.shape -%}
            {%- else -%}
            <span class="hrg__image hrg__image--diamond">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1254 | image_tag: widths: '320, 480, 640, 960, 1254', sizes: '(min-width: 1440px) 318px, (min-width: 750px) 23vw, 43vw', loading: 'lazy', alt: block.settings.shape }}
              {%- else -%}
                {%- assign icon_shape = block.settings.shape | downcase -%}
                {%- render 'diamond-shape-icon', shape: icon_shape -%}
              {%- endif -%}
            </span>
            {%- endif -%}
            <span class="hrg__name">{{ block.settings.shape | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <div class="hrg__scroll" data-gallery-scroll hidden>
      <button type="button" data-gallery-prev aria-label="{{ 'home_ring_gallery.previous' | t }}">&larr;</button>
      <span class="hrg__progress" aria-hidden="true"><span data-gallery-progress></span></span>
      <button type="button" data-gallery-next aria-label="{{ 'home_ring_gallery.next' | t }}">&rarr;</button>
    </div>
    <div class="hrg__actions">
      <a class="hrg__button hrg__button--primary" href="{{ routes.collections_url }}/lab-grown-diamonds">{{ 'home_ring_gallery.lab_cta' | t }} <span aria-hidden="true">&rarr;</span></a>
      <a class="hrg__button" href="{{ routes.collections_url }}/natural-diamonds">{{ 'home_ring_gallery.natural_cta' | t }} <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
  <div class="hrg__panel" id="RingGallery-{{ section.id }}" data-gallery-panel>
    <ul class="hrg__track" data-gallery-track>
      {%- if section.settings.ring_artwork != blank -%}
        {%- for block in section.blocks -%}
          {%- unless block.type == 'ring_style' -%}{%- continue -%}{%- endunless -%}
          <li class="hrg__card" {{ block.shopify_attributes }}>
            <a href="{{ routes.root_url }}pages/ring-builder?start=setting&amp;shape={{ block.settings.shape | url_encode }}">
              {%- render 'home-gallery-artwork', artwork: section.settings.ring_artwork, x: block.settings.artwork_x, y: 264, crop_width: 250, crop_height: 205, label: block.settings.title -%}
              <span class="hrg__name">{{ block.settings.title | escape }}</span>
              <span class="hrg__card-link">{{ 'home_ring_gallery.browse_settings' | t }} <span aria-hidden="true">&rarr;</span></span>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
      {%- for ring in section.settings.rings -%}
        {%- unless ring.available and ring.featured_image and ring.tags contains 'ring-setting' -%}{%- continue -%}{%- endunless -%}
        {%- capture shape -%}{%- render 'center-stone-shape', product: ring -%}{%- endcapture -%}
        {%- assign shape = shape | strip -%}
        {%- if shape == blank -%}{%- continue -%}{%- endif -%}
        {%- assign short_title = ring.title | split: ' in ' | first | remove: ' Engagement Ring' | remove: ' Setting' -%}
        <li class="hrg__card">
          <a href="{{ routes.root_url }}pages/ring-builder?setting={{ ring.handle | url_encode }}&amp;shape={{ shape | url_encode }}" aria-label="{{ ring.title | escape }}">
            <span class="hrg__image">
              {{ ring.featured_image | image_url: width: 800 | image_tag: widths: '240, 400, 600, 800', sizes: '(min-width: 750px) 23vw, 43vw', loading: 'lazy', alt: ring.title }}
            </span>
            <span class="hrg__name">{{ short_title | escape }}</span>
            <span class="hrg__card-link">{{ 'home_ring_gallery.view_setting' | t }} <span aria-hidden="true">&rarr;</span></span>
          </a>
        </li>
      {%- endfor -%}
      {%- endif -%}
    </ul>
    <div class="hrg__scroll" data-gallery-scroll hidden>
      <button type="button" data-gallery-prev aria-label="{{ 'home_ring_gallery.previous' | t }}">&larr;</button>
      <span class="hrg__progress" aria-hidden="true"><span data-gallery-progress></span></span>
      <button type="button" data-gallery-next aria-label="{{ 'home_ring_gallery.next' | t }}">&rarr;</button>
    </div>
    <p class="hrg__note">{%- if section.settings.ring_artwork != blank -%}{{ 'home_ring_gallery.inspiration_note' | t }} {% endif -%}{{ 'home_ring_gallery.setting_note' | t }}</p>
    <div class="hrg__actions">
      <a class="hrg__button hrg__button--primary" href="{{ routes.root_url }}pages/ring-builder?start=setting">{{ 'home_ring_gallery.settings_cta' | t }} <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
  {%- if section.settings.color_image != blank -%}
    <div class="hrg__panel" id="ColorGallery-{{ section.id }}" data-gallery-panel>
      <ul class="hrg__track hrg__track--color" data-gallery-track>
        <li class="hrg__card">
          <a href="{{ routes.collections_url }}/colored-lab-grown-diamonds">
            <span class="hrg__image hrg__image--diamond">
              {{ section.settings.color_image | image_url: width: 1254 | image_tag: widths: '320, 480, 640, 960, 1254', sizes: '(min-width: 750px) 360px, 90vw', loading: 'lazy', alt: 'Pink oval lab-grown diamond illustration' }}
            </span>
            <span class="hrg__name">{{ 'home_ring_gallery.color_title' | t }}</span>
          </a>
        </li>
      </ul>
      <div class="hrg__actions">
        <a class="hrg__button hrg__button--primary" href="{{ routes.collections_url }}/colored-lab-grown-diamonds">{{ 'home_ring_gallery.color_tab' | t }} <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  {%- endif -%}
</lmny-ring-gallery>

{% stylesheet %}
  .section-home-ring-gallery { container-type: inline-size; }
  .hrg { display: block; padding: clamp(40px, 5vw, 72px) clamp(20px, 4vw, 64px); background: #faf8f4; color: #191919; }
  .hrg__header { text-align: center; }
  .hrg__header .lmh-h2 { color: #191919; font-size: clamp(38px, 4.2cqw, 58px); font-weight: 400; }
  .hrg__header p { margin: 12px 0 0; font-size: 14px; line-height: 1.5; }
  .hrg__tabs { display: flex; justify-content: center; width: fit-content; max-width: 100%; margin: 28px auto; border-bottom: 1px solid #d9d4cc; }
  .hrg__tab { flex: 1; padding: 14px 32px; border-bottom: 2px solid transparent; margin-bottom: -1px; text-align: center; text-decoration: none; font-size: 14px; white-space: nowrap; }
  .hrg__tab[aria-selected="true"] { border-color: #191919; font-weight: 600; }
  .hrg__panel { max-width: 1320px; margin: 0 auto; }
  .hrg__panel[hidden], .hrg__scroll[hidden] { display: none; }
  .hrg:not([data-enhanced]) .hrg__panel + .hrg__panel { margin-top: 40px; }
  .hrg__track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 48px) / 4); gap: 16px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; margin: 0; padding: 0 0 6px; list-style: none; }
  .hrg .hrg__track--color { grid-auto-columns: 100%; max-width: 360px; margin: 0 auto; }
  .hrg__card { min-width: 0; text-align: center; scroll-snap-align: start; }
  .hrg[data-enhanced] .hrg__track { scrollbar-width: none; }
  .hrg[data-enhanced] .hrg__track::-webkit-scrollbar { display: none; }
  .hrg__card > a { display: block; height: 100%; text-decoration: none; }
  .hrg__image { display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1.04; background: #f1eee8; overflow: hidden; }
  .hrg__image img { display: block; width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .hrg__image--diamond { background: var(--lmh-sand); aspect-ratio: 250 / 230; }
  .hrg__image--diamond img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: normal; }
  /* Crop the approved artwork boards without resampling or redrawing the jewelry. */
  .hrg .hrg__image--artwork { position: relative; display: block; aspect-ratio: var(--art-ratio); background: #f1eee8; }
  .hrg .hrg__image--artwork img { position: absolute; width: var(--art-width); max-width: none; height: auto; max-height: none; left: var(--art-left); top: var(--art-top); object-fit: initial; mix-blend-mode: normal; }
  .hrg__image svg { width: 55%; height: auto; }
  .hrg__name { display: block; margin: 18px 8px 0; font-family: var(--lmh-serif); font-size: clamp(20px, 2vw, 26px); line-height: 1.15; }
  .hrg__card-link { display: block; margin: 8px 0 0; font-size: 12px; }
  .hrg__card a:hover .hrg__name { text-decoration: underline; text-underline-offset: 4px; }
  .hrg__actions { display: flex; justify-content: center; gap: 16px; margin-top: 30px; }
  .hrg__button { display: inline-flex; align-items: center; justify-content: center; gap: 20px; min-height: 50px; min-width: 250px; padding: 14px 24px; border: 1px solid var(--lmh-bronze); color: var(--lmh-espresso); background: var(--lmh-cream); text-decoration: none; font-size: 13px; line-height: 1.4; }
  .hrg .hrg__button--primary { background: var(--lmh-gold); border-color: var(--lmh-gold); color: var(--lmh-espresso); }
  .hrg .hrg__button--primary:hover { background: var(--lmh-gold-light); border-color: var(--lmh-gold-light); }
  .hrg__button:hover { box-shadow: inset 0 0 0 1px currentColor; }
  .hrg__note { text-align: center; margin: 28px 0 -12px; font-size: 11px; line-height: 1.5; }
  .hrg__scroll { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 10px; }
  .hrg__scroll button { appearance: none; border: 0; background: transparent; color: inherit; font-size: 22px; width: 44px; height: 44px; cursor: pointer; }
  .hrg__scroll button:disabled { opacity: .3; cursor: default; }
  .hrg__progress { display: block; width: 90px; height: 2px; background: #d9d4cc; }
  .hrg__progress > span { display: block; height: 100%; width: 33.333%; background: #191919; transform: translateX(var(--gallery-progress, 0%)); }
  .hrg a:focus-visible, .hrg button:focus-visible { outline: 2px solid #7a5c22; outline-offset: -2px; }
  @container (max-width: 749px) {
    .hrg { padding: 38px 20px; }
    .hrg__header p { font-size: 12px; }
    .hrg__tabs { width: 100%; margin: 22px auto; }
    .hrg__tab { padding: 14px 6px; font-size: 11px; white-space: normal; line-height: 1.4; min-width: 0; display: flex; align-items: center; justify-content: center; }
    .hrg__track { grid-auto-columns: 44%; gap: 12px; }
    .hrg__image { aspect-ratio: 3 / 4; }
    .hrg__image--diamond { aspect-ratio: 250 / 230; }
    .hrg__name { margin: 14px 0 0; font-size: 20px; }
    .hrg__card-link { font-size: 11px; }
    .hrg__actions { flex-direction: column; gap: 10px; margin-top: 22px; }
    .hrg__button { min-width: 0; width: 100%; }
    .hrg__note { margin-top: 18px; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('lmny-ring-gallery')) {
    customElements.define('lmny-ring-gallery', class extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;
        this.abort = new AbortController();
        const options = { signal: this.abort.signal };
        const tabs = Array.from(this.querySelectorAll('[data-gallery-tab]'));
        const panels = Array.from(this.querySelectorAll('[data-gallery-panel]'));
        this.querySelector('.hrg__tabs').setAttribute('role', 'tablist');
        const select = (index, focus = false) => {
          tabs.forEach((tab, i) => {
            tab.setAttribute('aria-selected', String(i === index));
            tab.tabIndex = i === index ? 0 : -1;
            panels[i].hidden = i !== index;
          });
          if (focus) tabs[index].focus();
          this.updateTracks();
        };
        tabs.forEach((tab, index) => {
          tab.setAttribute('role', 'tab');
          tab.setAttribute('aria-controls', panels[index].id);
          panels[index].setAttribute('role', 'tabpanel');
          panels[index].setAttribute('aria-labelledby', tab.id);
          tab.addEventListener('click', event => { event.preventDefault(); select(index); }, options);
          tab.addEventListener('keydown', event => {
            let next = index;
            if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
            else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = tabs.length - 1;
            else if (event.key !== ' ') return;
            event.preventDefault();
            select(next, true);
          }, options);
        });
        const tracks = panels.map(panel => {
          const track = panel.querySelector('[data-gallery-track]');
          const controls = panel.querySelector('[data-gallery-scroll]');
          if (!controls) return () => {};
          const previous = panel.querySelector('[data-gallery-prev]');
          const next = panel.querySelector('[data-gallery-next]');
          const update = () => {
            if (panel.hidden) return;
            const max = track.scrollWidth - track.clientWidth;
            controls.hidden = max < 2;
            previous.disabled = track.scrollLeft <= 1;
            next.disabled = track.scrollLeft >= max - 1;
            panel.style.setProperty('--gallery-progress', (max > 0 ? Math.min(200, Math.max(0, track.scrollLeft / max * 200)) : 0) + '%');
          };
          const move = direction => {
            const card = track.firstElementChild;
            if (!card) return;
            const step = card.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap);
            track.scrollBy({ left: step * direction, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
          };
          previous.addEventListener('click', () => move(-1), options);
          next.addEventListener('click', () => move(1), options);
          track.addEventListener('scroll', update, { ...options, passive: true });
          return update;
        });
        this.updateTracks = () => tracks.forEach(update => update());
        this.setAttribute('data-enhanced', '');
        select(0);
        this.resizeObserver = new ResizeObserver(this.updateTracks);
        this.resizeObserver.observe(this);
      }
      disconnectedCallback() {
        this.abort?.abort();
        this.resizeObserver?.disconnect();
        this.initialized = false;
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Ring and diamond gallery",
  "class": "section-home-ring-gallery",
  "settings": [
    { "type": "image_picker", "id": "color_image", "label": "Colored lab-grown diamond tile" },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Make it yours."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Start with the stone or the ring."
    },
    {
      "type": "product_list",
      "id": "rings",
      "label": "Featured ring settings",
      "limit": 4,
      "info": "Select available ring-setting products with a confirmed center-stone shape."
    },
    {
      "type": "image_picker",
      "id": "diamond_artwork",
      "label": "Diamond preview artwork",
      "info": "Approved 1536 \u00d7 1024 diamond gallery board."
    },
    {
      "type": "image_picker",
      "id": "ring_artwork",
      "label": "Ring preview artwork",
      "info": "Approved 1536 \u00d7 1024 ring gallery board. Rings are shown as design inspiration."
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "diamond",
      "name": "Diamond shape",
      "settings": [
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "default": "Round",
          "options": [
            {
              "value": "Round",
              "label": "Round"
            },
            {
              "value": "Oval",
              "label": "Oval"
            },
            {
              "value": "Emerald",
              "label": "Emerald"
            },
            {
              "value": "Pear",
              "label": "Pear"
            },
            {
              "value": "Cushion",
              "label": "Cushion"
            },
            {
              "value": "Radiant",
              "label": "Radiant"
            },
            {
              "value": "Princess",
              "label": "Princess"
            },
            {
              "value": "Asscher",
              "label": "Asscher"
            },
            {
              "value": "Marquise",
              "label": "Marquise"
            },
            {
              "value": "Heart",
              "label": "Heart"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Diamond photo"
        },
        {
          "type": "number",
          "id": "artwork_x",
          "label": "Artwork crop left (pixels)",
          "info": "Use 71, 339, 600 or 864 for the approved diamond board."
        }
      ],
      "limit": 4
    },
    {
      "type": "ring_style",
      "name": "Ring inspiration",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Oval solitaire"
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Setting shape",
          "default": "Oval",
          "options": [
            {
              "value": "Oval",
              "label": "Oval"
            },
            {
              "value": "Emerald",
              "label": "Emerald"
            },
            {
              "value": "Round",
              "label": "Round"
            }
          ]
        },
        {
          "type": "number",
          "id": "artwork_x",
          "label": "Artwork crop left (pixels)",
          "default": 71
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ring and diamond gallery",
      "blocks": [
        {
          "type": "diamond",
          "settings": {
            "shape": "Round"
          }
        },
        {
          "type": "diamond",
          "settings": {
            "shape": "Oval"
          }
        },
        {
          "type": "diamond",
          "settings": {
            "shape": "Emerald"
          }
        },
        {
          "type": "diamond",
          "settings": {
            "shape": "Pear"
          }
        }
      ]
    }
  ]
}
{% endschema %}
