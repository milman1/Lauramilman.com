{%- comment -%}
  Laura Milman New York - Header Section
  Dark glass effect header with dropdown mega menus
{%- endcomment -%}

<style>
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  transition: background 0.3s ease, box-shadow 0.3s ease;
  background: rgba(30, 17, 9, 0.98);
  /* theme.css section 5 still sets a light 1px rule, which shows as a pale
     hairline under the dark bar and makes the header 1px taller than the token. */
  border-bottom: none;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.header--scrolled {
  background: rgba(30, 17, 9, 0.98);
  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
}

.header .container {
  /* Nav has 7 top-level labels — use the full bar width instead of the page
     container (1320) so logo / links / icons can breathe. Chains lives inside
     the Jewelry panel rather than adding an eighth top-level label. */
  max-width: none;
  margin: 0 auto;
  padding: 0 clamp(1rem, 2.2vw, 2.5rem);
}

/* --header-height is the single source of truth: body reserves exactly this
   much, so the bar must be exactly this tall. Do not add vertical padding. */
.header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  height: var(--header-height);
}

.header .logo {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.75rem;
  white-space: nowrap;
  flex-shrink: 0;
  font-weight: 500;
  color: #ffffff;
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: opacity 0.3s ease;
  position: relative;
  z-index: 1;
}

.header .logo:hover {
  opacity: 0.8;
}

.header .logo span {
  color: var(--gold-light, #E2C27A);
  font-style: italic;
}

.header .logo img {
  height: 70px;
  max-height: calc(var(--header-height) - 16px);
  width: auto;
  object-fit: contain;
}

.header .nav {
  display: flex;
  align-items: center;
  /* Fluid gap: tight on mid desktops, roomier on wide screens. */
  gap: clamp(0.55rem, 1.05vw, 1.35rem);
  flex: 1 1 auto;
  justify-content: center;
  min-width: 0;
}

.header .nav__link {
  font-size: 0.72rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.5rem 0;
  position: relative;
  transition: color 0.3s ease;
  white-space: nowrap;
}

.header .nav__link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--gold, #C9A050);
  transition: width 0.3s ease;
}

.header .nav__link:hover {
  color: var(--gold-light, #E2C27A);
}

.header .nav__link:hover::after,
.header .nav__link--active::after {
  width: 100%;
}

.header .nav__link--active {
  color: var(--gold-light, #E2C27A);
}

/* Lab-grown nav entry uses the house gold, same as the rest of the bar. */
.header .nav__link--peaceful {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
}

.header .nav__link--peaceful::after {
  background: var(--gold, #C9A050);
}

.header .nav__link--peaceful:hover {
  color: var(--gold-light, #E2C27A);
}

.header .nav__item--peaceful .nav__item-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
}

.header .nav__item--peaceful .nav__item-link::after {
  background: var(--gold, #C9A050);
}

.header .nav__item--peaceful:hover .nav__item-link,
.header .nav__item--peaceful .nav__item-link:hover {
  color: var(--gold-light, #E2C27A);
}

.header .nav__item--peaceful .nav__dropdown-link:hover {
  color: var(--gold-light, #E2C27A);
}

.header .nav__item--peaceful .nav__dropdown-link:hover::before {
  background: var(--gold, #C9A050);
}

.header .nav__peaceful-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--gold, #C9A050);
  box-shadow: 0 0 6px rgba(201, 160, 80, 0.8);
  flex-shrink: 0;
}

.header .nav__icons {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.header .nav__icon {
  color: rgba(255, 255, 255, 0.9);
  transition: color 0.3s ease, transform 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header .nav__icon:hover {
  color: var(--gold-light, #E2C27A);
  transform: translateY(-2px);
}

.header .nav__icon svg {
  width: 22px;
  height: 22px;
}

.header .cart-icon {
  position: relative;
}

.header .cart-count {
  position: absolute;
  top: -8px;
  right: -10px;
  background: var(--gold, #C9A050);
  color: #1E1109;
  font-size: 0.65rem;
  font-weight: 600;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Dropdown Menu */
.header .nav__item {
  position: relative;
}

.header button.nav__item-link {
  background: none;
  border: 0;
  margin: 0;
  font-family: inherit;
  -webkit-appearance: none;
  appearance: none;
}

.header .nav__item-link {
  font-size: 0.72rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.5rem 0;
  position: relative;
  transition: color 0.3s ease;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  cursor: pointer;
  white-space: nowrap;
}

.header .nav__item-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--gold, #C9A050);
  transition: width 0.3s ease;
}

.header .nav__item:hover .nav__item-link,
.header .nav__item-link:hover {
  color: var(--gold-light, #E2C27A);
}

.header .nav__item:hover .nav__item-link::after {
  width: 100%;
}

.header .nav__item-link .dropdown-arrow {
  width: 10px;
  height: 10px;
  transition: transform 0.3s ease;
}

.header .nav__item:hover .dropdown-arrow {
  transform: rotate(180deg);
}

.header .nav__dropdown {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  min-width: 220px;
  background: rgba(30, 17, 9, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(201, 160, 80, 0.15);
  border-radius: 8px;
  padding: 0.75rem 0;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
  z-index: 1001;
  /* Keep every brand visible; do not cap height so Jacob & Co. is not
     clipped below the fold on short laptops. */
  overflow: visible;
}

.header .nav__item:hover .nav__dropdown,
.header .nav__item:focus-within .nav__dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

/* Escape closes a keyboard-opened menu until focus or the pointer leaves it. */
.header .nav__item[data-dismissed] .nav__dropdown {
  opacity: 0;
  visibility: hidden;
}

/* "More" sits at the right edge: anchor its panel right so it stays on screen. */
.header .nav__item--end .nav__dropdown {
  left: auto;
  right: 0;
  transform: translateX(0) translateY(10px);
  white-space: nowrap;
}

.header .nav__item--end:hover .nav__dropdown,
.header .nav__item--end:focus-within .nav__dropdown {
  transform: translateX(0) translateY(0);
}

.header .nav__dropdown-label {
  display: block;
  padding: 0.6rem 1.5rem 0.2rem;
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--gold, #C9A050);
}

.header .nav__dropdown-label ~ .nav__dropdown-label {
  margin-top: 0.4rem;
}

.header .nav__dropdown-link--all {
  margin-top: 0.35rem;
  border-top: 1px solid rgba(201, 160, 80, 0.25);
  font-weight: 600;
}

/* The lab-grown category list is both longer and wider than the two links the
   tier used to carry. Centred under a nav item this close to the right edge it
   ran off a 1280px viewport, so this panel anchors to its right edge instead. */
.header .nav__item--peaceful .nav__dropdown {
  left: auto;
  right: 0;
  transform: translateX(0) translateY(10px);
  white-space: nowrap;
}

.header .nav__item--peaceful:hover .nav__dropdown,
.header .nav__item--peaceful:focus-within .nav__dropdown {
  transform: translateX(0) translateY(0);
}

.header .nav__dropdown-link {
  display: block;
  padding: 0.75rem 1.5rem;
  font-size: 0.85rem;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.85);
  text-decoration: none;
  transition: all 0.2s ease;
  position: relative;
}

.header .nav__dropdown-link::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 0;
  background: var(--gold, #C9A050);
  transition: height 0.2s ease;
}

.header .nav__dropdown-link:hover {
  color: var(--gold-light, #E2C27A);
  background: rgba(201, 160, 80, 0.08);
  padding-left: 1.75rem;
}

.header .nav__dropdown-link:hover::before {
  height: 60%;
}

/* Mobile Toggle */
.header .mobile-toggle {
  display: none;
  flex-direction: column;
  gap: 6px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 12px;
  min-width: 48px;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  z-index: 1003;
  position: relative;
  -webkit-tap-highlight-color: transparent;
}

.header .mobile-toggle span {
  width: 24px;
  height: 2px;
  background: #ffffff;
  transition: all 0.3s ease;
  transform-origin: center;
}

.header .mobile-toggle.active span:nth-child(1) {
  transform: rotate(45deg) translate(6px, 6px);
}

.header .mobile-toggle.active span:nth-child(2) {
  opacity: 0;
  transform: translateX(-10px);
}

.header .mobile-toggle.active span:nth-child(3) {
  transform: rotate(-45deg) translate(6px, -6px);
}

/* Mobile Menu Overlay */
.header .nav-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1001;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.header .nav-overlay.active {
  display: block;
  opacity: 1;
}

/* Desktop nav only when there is room for logo + 7 labels + icons.
   Below this, use the drawer so items never collide with the wordmark. */
@media (max-width: 1199px) {
  .header .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: rgba(30, 17, 9, 0.99);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding-top: 20px;
    gap: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform: translateX(100%);
    opacity: 0;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 2rem;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    z-index: 1002;
    display: flex;
  }

  .header .nav.nav--open {
    transform: translateX(0);
    opacity: 1;
  }

  .header .nav__link {
    font-size: 1.1rem;
    font-weight: 500;
    padding: 1rem 0;
    width: 100%;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    letter-spacing: 0.05em;
  }

  .header .nav__item {
    width: 100%;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .header .nav__item-link {
    font-size: 1.1rem;
    font-weight: 500;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    width: 100%;
    letter-spacing: 0.05em;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
  }

  .header .nav__dropdown {
    position: static;
    transform: none;
    left: auto;
    top: auto;
    width: 100%;
    min-width: 100%;
    margin-top: 0;
    background: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: 0;
    padding: 0;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: max-height 0.15s ease-out, opacity 0.1s ease-out;
  }

  .header .nav__item:hover .nav__dropdown,
  .header .nav__item.open .nav__dropdown {
    position: static;
    transform: none;
    left: auto;
  }

  .header .nav__item--end .nav__dropdown,
  .header .nav__item--end:hover .nav__dropdown {
    position: static;
    right: auto;
    left: auto;
    transform: none;
    white-space: normal;
  }

  /* Undo the desktop right-anchoring for the lab-grown jewelry panel — in the
     drawer it is a static full-width list, and nowrap would scroll it sideways. */
  .header .nav__item--peaceful .nav__dropdown,
  .header .nav__item--peaceful:hover .nav__dropdown {
    position: static;
    right: auto;
    left: auto;
    transform: none;
    white-space: normal;
  }

  .header .nav__item.open .nav__dropdown {
    /* Must be taller than the Timepieces brand list (10 links). The previous
       500px cap clipped Jacob & Co. and Other Brands on tablet/mobile. */
    max-height: 2000px;
    overflow: visible;
    opacity: 1;
    visibility: visible;
    padding: 0.5rem 0 0.75rem 0;
    transition: max-height 0.2s ease-in, opacity 0.1s ease-in;
  }

  .header .nav__item:hover .nav__dropdown,
  .header .nav__item:focus-within .nav__dropdown {
    opacity: 0;
    visibility: hidden;
    max-height: 0;
  }
  .header .nav__item.open:hover .nav__dropdown,
  .header .nav__item.open:focus-within .nav__dropdown {
    opacity: 1;
    visibility: visible;
    max-height: 2000px;
    overflow: visible;
  }

  .header .nav__item:hover .dropdown-arrow {
    transform: none;
  }

  .header .nav__item.open .nav__item-link .dropdown-arrow,
  .header .nav__item.open:hover .dropdown-arrow {
    transform: rotate(180deg);
  }

  .header .nav__dropdown-link {
    text-align: left;
    padding: 0.75rem 0 0.75rem 1rem;
    font-size: 0.95rem;
    font-weight: 400;
    display: block;
    color: rgba(255, 255, 255, 0.65);
    border-left: 2px solid transparent;
    transition: all 0.2s ease;
  }

  .header .nav__dropdown-link:hover,
  .header .nav__dropdown-link:active {
    color: var(--gold-light, #E2C27A);
    border-left-color: var(--gold, #C9A050);
    background: transparent;
    padding-left: 1.25rem;
  }

  .header .nav__dropdown-link::before {
    display: none;
  }

  .header .mobile-toggle {
    display: flex;
  }

  .header .nav__icons {
    position: relative;
    z-index: 1003;
    gap: 0.5rem;
  }

  /* At 1.75rem the wordmark needs ~166px, but the icon row plus the burger
     left only 68-138px on a phone, so it broke onto two lines. */
  .header .logo {
    font-size: 1.3rem;
  }

  .header .nav__icon {
    width: 40px;
    height: 40px;
  }

  .header .nav__icon svg {
    width: 20px;
    height: 20px;
  }

  .header .mobile-toggle {
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
  }

  /* The icon row and burger sit above the drawer (z-index 1003 vs 1002), so
     with the menu open they landed on top of its "Menu" heading and stacked a
     second X next to the drawer's own close button. */
  .header--nav-open .nav__icons,
  .header--nav-open .mobile-toggle {
    visibility: hidden;
    pointer-events: none;
  }

  .header .nav__mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem 0 1.5rem 0;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .header .nav__mobile-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.02em;
  }

  .header .nav__mobile-close {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    padding: 8px;
    margin-right: -8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .header .nav__mobile-close:hover {
    color: var(--gold, #C9A050);
  }
}

@media (max-width: 380px) {
  .header .nav__icon--account {
    display: none;
  }
}

@media (min-width: 1200px) {
  .header .nav__mobile-header {
    display: none;
  }

  .header .nav__link--account {
    display: none;
  }
}

/* Tighter spacing on laptops so the menu clears the logo and icons. */
@media (min-width: 1200px) and (max-width: 1380px) {
  .header .nav {
    gap: 0.5rem;
  }

  .header .nav__link,
  .header .nav__item-link {
    font-size: 0.64rem;
    letter-spacing: 0.04em;
  }

}

/* Short labels on laptops so the logo, menu and icons never collide. The
   full label stays in the accessibility tree; the short one is visual only. */
.header .nav__label-short {
  display: none;
}

@media (min-width: 1200px) and (max-width: 1279px) {
  .header .nav__label-full {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .header .nav__label-short {
    display: inline;
  }
}
/* Each pillar panel lays its groups side by side on desktop, one column per
   group, so a long panel stays inside a laptop viewport. Left-anchored under
   its item; the last pillar anchors right like the old "More" panel. */
@media (min-width: 1200px) {
  .header .nav__dropdown--cols {
    column-count: 3;
    column-gap: 0;
    width: max-content;
    white-space: nowrap;
  }
  .header .nav__dropdown--cols .nav__dropdown-label ~ .nav__dropdown-label {
    break-before: column;
    margin-top: 0;
  }
  .header .nav__item:not(.nav__item--end) > .nav__dropdown--cols {
    left: 0;
    right: auto;
    transform: translateX(0) translateY(10px);
  }
  .header .nav__item:not(.nav__item--end):hover > .nav__dropdown--cols,
  .header .nav__item:not(.nav__item--end):focus-within > .nav__dropdown--cols {
    transform: translateX(0) translateY(0);
  }
}

/* On the narrowest desktops the last pillar sits too far left to anchor right. */
@media (min-width: 1200px) and (max-width: 1279px) {
  .header .nav__item--end > .nav__dropdown--cols {
    left: 0;
    right: auto;
  }
}
</style>

<header class="header {% if section.settings.enable_sticky %}header--sticky{% endif %}" id="header">
  <div class="nav-overlay" id="navOverlay"></div>
  <div class="container">
    <div class="header__inner">
      <a href="{{ routes.root_url }}" class="logo">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="200" height="{{ 200 | divided_by: section.settings.logo.aspect_ratio | round }}">
        {%- else -%}
          Laura <span>Milman</span>
        {%- endif -%}
      </a>

      <nav class="nav" id="nav">
        <div class="nav__mobile-header">
          <span class="nav__mobile-title">Menu</span>
          <button class="nav__mobile-close" id="navClose" aria-label="Close menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        {%- comment -%}
          Four pillars, in the order the homepage walks them: gold for work,
          pre-owned watches with signed jewelry, lab-grown diamonds, natural
          diamonds. Style links use ?type=, which the collection page reads to
          pre-select its style chips; shape links use ?shape=, which the
          diamond search reads the same way. Gold links land on chains until
          the gold-jewelry collection has pieces in it.
        {%- endcomment -%}
        {%- assign gold_all_url = '/collections/chains' -%}
        {%- if collections['gold-jewelry'].products_count > 0 -%}
          {%- assign gold_all_url = '/collections/gold-jewelry' -%}
        {%- endif -%}
        <div class="nav__item">
          <button type="button" aria-expanded="false" class="nav__item-link">
            Gold Jewelry
            <svg class="dropdown-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="nav__dropdown nav__dropdown--cols">
            <span class="nav__dropdown-label">Most popular</span>
            <a href="/collections/chain-necklaces" class="nav__dropdown-link">Chains</a>
            <a href="/collections/chain-bracelets" class="nav__dropdown-link">Chain Bracelets</a>
            <a href="/collections/stackable-rings" class="nav__dropdown-link">Stacking Rings</a>
            <a href="/collections/huggie-earrings" class="nav__dropdown-link">Huggies &amp; Hoops</a>
            <a href="/collections/bangles" class="nav__dropdown-link">Bangles</a>
            <span class="nav__dropdown-label">Chains by style</span>
            <a href="/collections/chains?type=Cuban" class="nav__dropdown-link">Cuban</a>
            <a href="/collections/chains?type=Rope" class="nav__dropdown-link">Rope</a>
            <a href="/collections/chains?type=Paperclip" class="nav__dropdown-link">Paperclip</a>
