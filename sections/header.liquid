{%- comment -%}
  Laura Milman New York - Header
  Built from the approved preview: an espresso announcement line, then a
  cream bar with appointment links at left, the centered wordmark and the
  icons at right, and the four pillars on a second row. Each pillar opens a
  full-width panel. Below 1200px the bar is burger / wordmark / icons and
  the pillars live in a full-screen cream drawer.

  The header is fixed. The announcement line slides up once the page
  scrolls, so only the bar stays on screen. --header-height is the visible
  bar; the body reserves the bar plus the announcement line.
{%- endcomment -%}

<style>
:root {
  --lmhh-announce: {% if section.settings.announce_text != blank %}40px{% else %}0px{% endif %};
  --header-height: 112px;
}
@media (max-width: 1199px) {
  :root {
    --lmhh-announce: {% if section.settings.announce_text != blank %}36px{% else %}0px{% endif %};
    --header-height: 60px;
  }
}
body { padding-top: calc(var(--header-height) + var(--lmhh-announce)) !important; }

.header {
  --lmhh-cream: #FAF6F0;
  --lmhh-ivory: #FDFAF6;
  --lmhh-line: #DDD5C5;
  --lmhh-espresso: #1E1109;
  --lmhh-ink: #2C1810;
  --lmhh-body: #4A3D30;
  --lmhh-muted: #6B6152;
  --lmhh-bronze: #7A5C22;
  --lmhh-gold: #C9A050;
  --lmhh-gold-light: #E2C27A;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: var(--lmhh-cream);
  border-bottom: 1px solid var(--lmhh-line);
  font-family: Montserrat, 'Helvetica Neue', Helvetica, sans-serif;
  color: var(--lmhh-ink);
  transition: top 0.3s ease, box-shadow 0.3s ease;
}
.header--scrolled {
  top: calc(-1 * var(--lmhh-announce));
  box-shadow: 0 6px 24px rgba(30, 17, 9, 0.08);
}
/* theme.css blurs the scrolled bar; a filter would trap the fixed drawer. */
.header, .header--scrolled { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
.header--nav-open { top: 0; }
.header a { color: inherit; }

/* ---------- announcement line ---------- */
.lmhh__announce {
  height: var(--lmhh-announce);
  background: var(--lmhh-espresso);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  padding: 0 16px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--lmhh-cream);
  white-space: nowrap;
  overflow: hidden;
}
.lmhh__announce a {
  color: var(--lmhh-gold-light) !important;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.lmhh__announce-dot { width: 4px; height: 4px; background: var(--lmhh-gold); transform: rotate(45deg); flex-shrink: 0; }
.lmhh__announce-short { display: none; }

/* ---------- bar ---------- */
.lmhh__bar {
  height: 64px;
  padding: 0 clamp(16px, 4.44vw, 64px);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
}
.lmhh__util {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.lmhh__util a { text-decoration: none; white-space: nowrap; }
.lmhh__util a:hover { color: var(--lmhh-bronze); }

.lmhh__logo {
  justify-self: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  text-decoration: none;
  white-space: nowrap;
}
.lmhh__word {
  font-family: 'Cormorant Garamond', Garamond, 'Times New Roman', serif;
  font-size: 31px;
  font-weight: 500;
  line-height: 1;
  color: var(--lmhh-espresso);
}
.lmhh__word em { font-style: italic; color: var(--lmhh-bronze); }
.lmhh__city {
  font-size: 8.5px;
  font-weight: 600;
  letter-spacing: 0.42em;
  padding-left: 0.42em;
  text-transform: uppercase;
  color: var(--lmhh-muted);
}

.header .nav__icons {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 8px;
}
.header .nav__icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  color: var(--lmhh-ink);
  transition: color 0.2s ease;
}
.header .nav__icon:hover { color: var(--lmhh-bronze); }
.header .nav__icon svg { width: 18px; height: 18px; }
.header .cart-icon { position: relative; }
.header .cart-count {
  position: absolute;
  top: 4px;
  right: 2px;
  min-width: 17px;
  height: 17px;
  padding: 0 4px;
  border-radius: 999px;
  background: var(--lmhh-gold);
  color: var(--lmhh-espresso);
  font-size: 10px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header .mobile-toggle {
  display: none;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  color: var(--lmhh-ink);
  -webkit-tap-highlight-color: transparent;
}

/* ---------- pillars ---------- */
.header .nav {
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(24px, 3.05vw, 44px);
}
.header .nav__item { position: static; }
.header .nav__item-link {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 7px;
  background: none;
  border: 0;
  border-bottom: 2px solid transparent;
  padding: 2px 0 0;
  margin: 0;
  font-family: inherit;
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--lmhh-ink);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  -webkit-appearance: none;
  appearance: none;
}
.header .nav__item-link .dropdown-arrow { width: 9px; height: 6px; transition: transform 0.2s ease; }
.header .nav__item:hover > .nav__item-link,
.header .nav__item:focus-within > .nav__item-link,
.header .nav__item-link[aria-expanded="true"] {
  color: var(--lmhh-bronze);
  border-bottom-color: var(--lmhh-gold);
  font-weight: 600;
}
.header .nav__item:hover .dropdown-arrow { transform: rotate(180deg); }
.header .nav__link--account,
.header .lmhh__mextra,
.header .lmhh__mnote,
.header .lmhh__msearch,
.header .nav__mobile-header { display: none; }

/* ---------- full-width panel ---------- */
.header .nav__dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  padding: 44px clamp(24px, 8.33vw, 120px);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr)) 1.25fr 300px;
  gap: 40px;
  background: var(--lmhh-ivory);
  border-top: 1px solid var(--lmhh-line);
  border-bottom: 1px solid var(--lmhh-line);
  box-shadow: 0 24px 40px rgba(30, 17, 9, 0.14);
  opacity: 0;
  visibility: hidden;
  transform: translateY(6px);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  z-index: 1001;
}
.header .nav__item:hover .nav__dropdown,
.header .nav__item:focus-within .nav__dropdown {
  opacity: 1;
  visibility: visible;
  transform: none;
}
.header .nav__item[data-dismissed] > .nav__dropdown { opacity: 0; visibility: hidden; }

.header .nav__group { display: flex; flex-direction: column; gap: 13px; font-size: 14px; min-width: 0; }
.header .nav__dropdown-label {
  margin-bottom: 4px;
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--lmhh-bronze);
}
.header .nav__dropdown-link { color: var(--lmhh-ink); text-decoration: none; line-height: 1.3; }
.header .nav__dropdown-link:hover { color: var(--lmhh-bronze); }
.header .nav__dropdown-link--all { margin-top: 6px; color: var(--lmhh-espresso); font-weight: 600; }

.header .nav__intro {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-left: 32px;
  border-left: 1px solid var(--lmhh-line);
}
.header .nav__intro p.nav__intro-line {
  margin: 0;
  font-family: 'Cormorant Garamond', Garamond, serif;
  font-size: 21px;
  line-height: 1.35;
  color: var(--lmhh-espresso);
}
.header .nav__intro p { margin: 0; font-size: 13px; line-height: 1.65; color: var(--lmhh-body); }
.header .nav__arrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--lmhh-bronze) !important;
  text-decoration: none;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.header .nav__card { display: flex; flex-direction: column; gap: 14px; text-decoration: none; }
.header .nav__card img { width: 100%; aspect-ratio: 300 / 236; object-fit: cover; display: block; }
.header .nav__card-title { font-family: 'Cormorant Garamond', Garamond, serif; font-size: 22px; font-weight: 500; color: var(--lmhh-espresso); }
.header .nav__card-text { font-size: 12.5px; line-height: 1.55; color: var(--lmhh-muted); }

.header .nav-overlay { display: none; }

/* Narrow desktops: drop the photo card so the link columns keep their width. */
@media (min-width: 1200px) and (max-width: 1379px) {
  .header .nav__dropdown { grid-template-columns: repeat(3, minmax(0, 1fr)) 1.3fr; gap: 32px; }
  .header .nav__card { display: none; }
}

/* =============================================================
   Below 1200px: burger / wordmark / icons, full-screen drawer
   ============================================================= */
@media (max-width: 1199px) {
  .lmhh__announce { gap: 10px; font-size: 9.5px; letter-spacing: 0.14em; }
  .lmhh__announce-dot, .lmhh__announce-long { display: none; }
  .lmhh__announce-short { display: inline; }

  .lmhh__bar { height: 60px; padding: 0 8px; grid-template-columns: 88px minmax(0, 1fr) 88px; }
  .lmhh__util { display: none; }
  .header .mobile-toggle { display: flex; grid-column: 1; grid-row: 1; }
  .lmhh__logo { grid-column: 2; grid-row: 1; gap: 2px; }
  .lmhh__word { font-size: 24px; }
  .lmhh__city { font-size: 7px; }
  .header .nav__icons { grid-column: 3; grid-row: 1; gap: 0; }
  .header .nav__icon--account { display: none; }

  .header .nav {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    z-index: 1002;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    gap: 0;
    padding: 0 0 24px;
    background: var(--lmhh-cream);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    transform: translateX(-100%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0.3s;
  }
  .header .nav.nav--open { transform: none; visibility: visible; }

  .header .nav__mobile-header {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) 88px;
    align-items: center;
    height: 60px;
    flex-shrink: 0;
    padding: 0 8px;
    border-bottom: 1px solid var(--lmhh-line);
  }
  .header .nav__mobile-close {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    padding: 0;
    color: var(--lmhh-ink);
    cursor: pointer;
  }
  .header .nav__mobile-header .nav__icon { justify-self: end; }

  .header .lmhh__msearch { display: block; padding: 16px 20px 8px; }
  .header .lmhh__msearch label {
    display: block;
    margin-bottom: 8px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lmhh-muted);
  }
  .header .lmhh__msearch input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    border: 1px solid var(--lmhh-line);
    border-radius: 0;
    background: var(--lmhh-ivory);
    font-family: inherit;
    font-size: 16px;
    color: var(--lmhh-ink);
  }

  .header .nav__item { margin: 0 20px; border-bottom: 1px solid var(--lmhh-line); }
  .header .nav__item--story { display: none; }
  .header .nav__item-link {
    width: 100%;
    height: 58px;
    padding: 0;
    border-bottom: 0;
    justify-content: space-between;
    font-family: 'Cormorant Garamond', Garamond, serif;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--lmhh-espresso);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .header .nav__item-link .dropdown-arrow { width: 12px; height: 8px; }
  .header .nav__item:hover > .nav__item-link,
  .header .nav__item:focus-within > .nav__item-link { color: var(--lmhh-espresso); font-weight: 500; }
  .header .nav__item.open > .nav__item-link,
  .header .nav__item-link[aria-expanded="true"] { color: var(--lmhh-bronze); font-weight: 500; }
  .header .nav__item:hover .dropdown-arrow { transform: none; }
  .header .nav__item.open .dropdown-arrow { transform: rotate(180deg); }

  .header .nav__dropdown,
  .header .nav__item:hover .nav__dropdown,
  .header .nav__item:focus-within .nav__dropdown {
    position: static;
    display: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding: 4px 0 20px;
    background: none;
    border: 0;
    box-shadow: none;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: none;
  }
  .header .nav__item.open > .nav__dropdown { display: grid; }
  .header .nav__group { gap: 0; font-size: 14px; }
  .header .nav__dropdown-label { font-size: 10px; margin-bottom: 4px; }
  .header .nav__dropdown-link { min-height: 40px; display: flex; align-items: center; }
  .header .nav__dropdown-link--all { margin-top: 0; }
  .header .nav__intro, .header .nav__card { display: none; }

  .header .lmhh__mextra { display: flex; flex-direction: column; gap: 2px; padding: 18px 20px 0; }
  .header .lmhh__mextra a {
    min-height: 44px;
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .header .lmhh__mnote {
    margin-top: auto;
    padding: 16px 20px 0;
    border-top: 1px solid var(--lmhh-line);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 11.5px;
    color: var(--lmhh-muted);
  }
  .header .lmhh__mextra + .lmhh__mnote { margin-top: 24px; }
  .header .lmhh__social {
    display: flex;
    gap: 12px;
    padding-bottom: 14px;
  }
  .header .lmhh__social-link {
    width: 44px;
    height: 44px;
    border: 1px solid var(--lmhh-line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lmhh-ink);
    text-decoration: none;
  }
  .header .lmhh__social-link:hover { border-color: var(--lmhh-gold); color: var(--lmhh-gold); }
  .header--nav-open .nav__icons,
  .header--nav-open .mobile-toggle { visibility: hidden; }
}
</style>

<header class="header" id="header">
  {%- if section.settings.announce_text != blank -%}
    <div class="lmhh__announce" role="region" aria-label="Announcement">
      <span>{{ section.settings.announce_text | escape }}</span>
      {%- if section.settings.announce_link_text != blank -%}
        <span class="lmhh__announce-dot" aria-hidden="true"></span>
        <a href="{{ section.settings.announce_url | default: '/pages/private-clients' }}">
          <span class="lmhh__announce-long">{{ section.settings.announce_link_text | escape }}</span><span class="lmhh__announce-short">{{ section.settings.announce_link_short | default: section.settings.announce_link_text | escape }}</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="nav-overlay" id="navOverlay"></div>

  <div class="lmhh__bar">
    <button class="mobile-toggle" id="mobileToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M0 1h20M0 7h20M0 13h20"/></svg>
    </button>

    <div class="lmhh__util">
      <a href="/pages/private-clients">Book an Appointment</a>
      <a href="/pages/about">Our Story</a>
    </div>

    <a href="{{ routes.root_url }}" class="lmhh__logo" aria-label="{{ shop.name | escape }}, home">
      <span class="lmhh__word">Laura <em>Milman</em></span>
      <span class="lmhh__city">New York</span>
    </a>

    <div class="nav__icons">
      <button type="button" class="nav__icon" id="searchToggle" aria-label="Search">
        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M12.5 12.5L17 17"/></svg>
      </button>
      <a href="{{ routes.account_url }}" class="nav__icon nav__icon--account" aria-label="Account">
        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="9" cy="6" r="3.5"/><path d="M2 17c1-3.5 3.8-5.5 7-5.5s6 2 7 5.5"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="nav__icon cart-icon" aria-label="Bag{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% endif %}">
        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 6h12l-1 11H4L3 6z"/><path d="M6 6V4.5a3 3 0 016 0V6"/></svg>
        {%- if cart.item_count > 0 -%}<span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>

  <nav class="nav" id="nav" aria-label="Main">
    <div class="nav__mobile-header">
      <button class="nav__mobile-close" id="navClose" type="button" aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16"/></svg>
      </button>
      <a href="{{ routes.root_url }}" class="lmhh__logo" aria-label="{{ shop.name | escape }}, home">
        <span class="lmhh__word">Laura <em>Milman</em></span>
        <span class="lmhh__city">New York</span>
      </a>
      <a href="{{ routes.cart_url }}" class="nav__icon" aria-label="Bag">
        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 6h12l-1 11H4L3 6z"/><path d="M6 6V4.5a3 3 0 016 0V6"/></svg>
      </a>
    </div>

    <form class="lmhh__msearch" action="{{ routes.search_url }}" method="get" role="search">
      <label for="lmhhMenuSearch">Search</label>
      <input type="hidden" name="type" value="product">
      <input id="lmhhMenuSearch" type="search" name="q" placeholder="Chains, Rolex, 1 ct oval…" autocomplete="off">
    </form>

    {%- comment -%}
      Four pillars, in the order the homepage walks them. Style links use
      ?type=, which the collection page reads to pre-select its style chips;
      shape links use ?shape=, which the diamond search reads the same way.
      Gold links land on chains until the gold-jewelry collection has pieces.
    {%- endcomment -%}
    {%- assign gold_all_url = '/collections/chains' -%}
    {%- if collections['gold-jewelry'].products_count > 0 -%}
      {%- assign gold_all_url = '/collections/gold-jewelry' -%}
    {%- endif -%}
    {%- assign peaceful_url = section.settings.peaceful_url | default: '/collections/lab-grown-diamond-jewelry' -%}
    {%- capture caret -%}<svg class="dropdown-arrow" viewBox="0 0 9 6" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1"/></svg>{%- endcapture -%}
    {%- capture arrow -%}{% render 'lmh-arrow' %}{%- endcapture -%}

    {%- comment -%}
      Lab-Grown Diamonds leads the menu: loose stones and ring settings are
      the house specialty. Eternity and wedding bands are absent: the house
      holds no lab-grown stock in those.
    {%- endcomment -%}
    <div class="nav__item nav__item--peaceful">
      <button type="button" aria-expanded="false" class="nav__item-link">{{ section.settings.peaceful_label | default: 'Lab-Grown Diamonds' }} {{ caret }}</button>
      <div class="nav__dropdown">
        <div class="nav__group">
          <span class="nav__dropdown-label">Most popular</span>
          <a href="/collections/lab-grown-diamonds" class="nav__dropdown-link">Loose Lab-Grown Diamonds</a>
          <a href="/pages/ring-builder" class="nav__dropdown-link">Build Your Ring</a>
          <a href="/collections/lab-grown-bracelets?type=Tennis" class="nav__dropdown-link">Tennis Bracelets</a>
          <a href="/collections/lab-grown-earrings?type=Huggie,Hoop" class="nav__dropdown-link">Huggies &amp; Hoops</a>
          <a href="/collections/lab-grown-earrings?type=Stud" class="nav__dropdown-link">Stud Earrings</a>
          <a href="/collections/lab-grown-necklaces?type=Station" class="nav__dropdown-link">Station Necklaces</a>
          <a href="/collections/lab-grown-engagement-rings" class="nav__dropdown-link">Engagement Rings</a>
          <a href="{{ peaceful_url }}" class="nav__dropdown-link nav__dropdown-link--all">All lab-grown jewelry</a>
        </div>
        <div class="nav__group">
          <span class="nav__dropdown-label">By category</span>
          <a href="/collections/lab-grown-bracelets" class="nav__dropdown-link">Bracelets</a>
          <a href="/collections/lab-grown-necklaces" class="nav__dropdown-link">Necklaces</a>
          <a href="/collections/lab-grown-earrings" class="nav__dropdown-link">Earrings</a>
          <a href="/collections/lab-grown-rings" class="nav__dropdown-link">Rings</a>
          <a href="/collections/lab-grown-pendants" class="nav__dropdown-link">Pendants</a>
        </div>
        <div class="nav__group">
