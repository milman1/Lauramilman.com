<script>
  document.addEventListener('DOMContentLoaded', function() {
    const header = document.getElementById('header');

    var headerScrollTicking = false;
    function handleScroll() {
      if (window.scrollY > 50) {
        header.classList.add('header--scrolled');
      } else {
        header.classList.remove('header--scrolled');
      }
    }

    window.addEventListener('scroll', function() {
      if (!headerScrollTicking) {
        window.requestAnimationFrame(function() {
          handleScroll();
          headerScrollTicking = false;
        });
        headerScrollTicking = true;
      }
    }, { passive: true });
    handleScroll();

    const mobileToggle = document.getElementById('mobileToggle');
    const nav = document.getElementById('nav');
    const navOverlay = document.getElementById('navOverlay');

    function isMobile() {
      return window.innerWidth <= 1199;
    }

    function openMobileMenu() {
      nav.classList.add('nav--open');
      header.classList.add('header--nav-open');
      mobileToggle.classList.add('active');
      mobileToggle.setAttribute('aria-expanded', 'true');
      navOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      nav.classList.remove('nav--open');
      header.classList.remove('header--nav-open');
      mobileToggle.classList.remove('active');
      mobileToggle.setAttribute('aria-expanded', 'false');
      navOverlay.classList.remove('active');
      document.body.style.overflow = '';
      nav.querySelectorAll('.nav__item.open').forEach(function(item) {
        item.classList.remove('open');
        var link = item.querySelector('button.nav__item-link');
        if (link) link.setAttribute('aria-expanded', 'false');
      });
    }

    const navClose = document.getElementById('navClose');

    if (mobileToggle && nav) {
      mobileToggle.addEventListener('click', function() {
        if (nav.classList.contains('nav--open')) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      });

      if (navClose) {
        navClose.addEventListener('click', closeMobileMenu);
      }

      if (navOverlay) {
        navOverlay.addEventListener('click', closeMobileMenu);
      }

      var touchedDropdown = false;

      nav.querySelectorAll('.nav__item').forEach(function(item) {
        var parentLink = item.querySelector('.nav__item-link');

        if (parentLink) {
          function setExpanded(el, open) {
            var btn = el.querySelector('button.nav__item-link');
            if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          }

          function toggleDropdown() {
            nav.querySelectorAll('.nav__item.open').forEach(function(openItem) {
              if (openItem !== item) {
                openItem.classList.remove('open');
                setExpanded(openItem, false);
              }
            });
            item.classList.toggle('open');
            setExpanded(item, item.classList.contains('open'));
          }

          // Desktop: the menu opens on hover or keyboard focus; keep
          // aria-expanded in step and let Escape close it.
          item.addEventListener('mouseenter', function() { if (!isMobile()) setExpanded(item, true); });
          item.addEventListener('mouseleave', function() {
            if (isMobile()) return;
            item.removeAttribute('data-dismissed');
            if (!item.contains(document.activeElement)) setExpanded(item, false);
          });
          item.addEventListener('focusin', function() {
            if (!isMobile() && !item.hasAttribute('data-dismissed')) setExpanded(item, true);
          });
          item.addEventListener('focusout', function(e) {
            if (item.contains(e.relatedTarget)) return;
            item.removeAttribute('data-dismissed');
            if (!isMobile()) setExpanded(item, false);
          });
          item.addEventListener('keydown', function(e) {
            if (e.key !== 'Escape') return;
            if (isMobile()) {
              item.classList.remove('open');
            } else {
              item.setAttribute('data-dismissed', '');
            }
            setExpanded(item, false);
            parentLink.focus();
          });

          parentLink.addEventListener('touchstart', function(e) {
            if (!isMobile()) return;
            // Journal (and any linked parent): caret toggles; label navigates.
            var isLinked = parentLink.tagName === 'A' && parentLink.getAttribute('href');
            var onCaret = e.target.closest('.dropdown-arrow');
            if (isLinked && !onCaret) return;
            e.preventDefault();
            touchedDropdown = true;
            toggleDropdown();
          }, { passive: false });

          parentLink.addEventListener('click', function(e) {
            if (!isMobile()) {
              // Mouse users open these menus by hovering; only a keyboard
              // press (detail 0) toggles them.
              if (parentLink.tagName !== 'BUTTON' || e.detail !== 0) return;
              var closed = item.hasAttribute('data-dismissed');
              if (closed) item.removeAttribute('data-dismissed'); else item.setAttribute('data-dismissed', '');
              setExpanded(item, closed);
              return;
            }
            var isLinked = parentLink.tagName === 'A' && parentLink.getAttribute('href');
            var onCaret = e.target.closest('.dropdown-arrow');
            if (isLinked && !onCaret) {
              closeMobileMenu();
              return;
            }
            e.preventDefault();
            if (touchedDropdown) {
              touchedDropdown = false;
              return;
            }
            toggleDropdown();
          });
        }
      });

      nav.querySelectorAll('.nav__dropdown-link').forEach(function(link) {
        link.addEventListener('click', function() {
          if (isMobile()) {
            closeMobileMenu();
          }
        });
      });

      nav.querySelectorAll('.nav__link').forEach(function(link) {
        link.addEventListener('click', function() {
          if (isMobile()) {
            closeMobileMenu();
          }
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && nav.classList.contains('nav--open')) {
          closeMobileMenu();
        }
      });
    }

    // Search overlay
    var searchToggle = document.getElementById('searchToggle');
    var searchOverlay = document.getElementById('searchOverlay');
    var searchClose = document.getElementById('searchClose');
    var searchInput = document.getElementById('searchInput');
    var searchResults = document.getElementById('searchResults');
    var searchLinks = searchOverlay ? searchOverlay.querySelector('.search-overlay__links') : null;
    var searchDebounce = null;

    function openSearch() {
      if (!searchOverlay) return;
      searchOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(function() { searchInput.focus(); }, 100);
    }

    function closeSearch() {
      if (!searchOverlay) return;
      searchOverlay.classList.remove('active');
      document.body.style.overflow = '';
      searchInput.value = '';
      searchResults.innerHTML = '';
      if (searchLinks) searchLinks.style.display = '';
    }

    if (searchToggle) {
      searchToggle.addEventListener('click', function(e) {
        e.preventDefault();
        openSearch();
      });
    }

    if (searchClose) {
      searchClose.addEventListener('click', closeSearch);
    }

    if (searchOverlay) {
      searchOverlay.addEventListener('click', function(e) {
        if (e.target === searchOverlay) closeSearch();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && searchOverlay && searchOverlay.classList.contains('active')) {
        closeSearch();
      }
    });

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        var q = searchInput.value.trim();
        clearTimeout(searchDebounce);
        if (q.length < 2) {
          searchResults.innerHTML = '';
          if (searchLinks) searchLinks.style.display = '';
          return;
        }
        searchDebounce = setTimeout(function() {
          fetch('/search/suggest.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=6&resources[options][fields]=title,product_type,vendor,tag,variants.title,variants.sku,body')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (searchInput.value.trim() !== q) return;

              var products = ((data.resources && data.resources.results && data.resources.results.products) || []).filter(function(product) {
                var searchableText = [product.title, product.vendor, product.type, product.handle]
                  .concat(product.tags || [])
                  .concat((product.variants || []).map(function(v) { return v.sku; }))
                  .join(' ')
                  .toLowerCase();
                /* Words with a digit can be a SKU or an IGI/GIA report number,
                   which only the description carries; plain words still have to
                   match the title, type or tags. */
                var bodyText = String(product.body || '').toLowerCase();

                return q.toLowerCase().split(/\s+/).every(function(word) {
                  if (word.length < 2 || searchableText.indexOf(word) !== -1) return true;
                  return /\d/.test(word) && bodyText.indexOf(word) !== -1;
                });
              });
              if (searchLinks) searchLinks.style.display = products.length > 0 || q.length >= 2 ? 'none' : '';
              if (products.length === 0) {
                searchResults.innerHTML = '<p class="search-overlay__no-results">No results for \u201c' + q.replace(/</g, '&lt;') + '\u201d</p>';
                return;
              }
              var html = '';
              products.forEach(function(p) {
                var img = p.image || '';
                var price = p.price;
                if (typeof price === 'string') price = parseFloat(price);
                var formattedPrice = '$' + (price / 1).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                html += '<a href="' + p.url + '" class="search-overlay__result-item">';
                if (img) html += '<img class="search-overlay__result-img" src="' + img.replace(/(\.\w+)$/, '_200x$1') + '" alt="" loading="lazy">';
                html += '<div class="search-overlay__result-info">';
                html += '<div class="search-overlay__result-title">' + p.title + '</div>';
                html += '<div class="search-overlay__result-price">' + formattedPrice + '</div>';
                html += '</div></a>';
              });
              searchResults.innerHTML = html;
            })
            .catch(function() { searchResults.innerHTML = ''; });
        }, 300);
      });
    }
  });
</script>

