{%- comment -%}
  "Rings, your way.": a heading over up to three photo tiles, each with a
  serif title and a link beneath. Colors come from the brand palette
  (warm white by default; navy or espresso optional). Stacks on phones.
{%- endcomment -%}
{{ 'lmny-home.css' | asset_url | stylesheet_tag }}

<section class="lmh lmh-split lmh-split--{{ section.settings.style | default: 'warm' }}" aria-labelledby="LmhSplit-{{ section.id }}">
  <h2 class="lmh-h2 lmh-split__title" id="LmhSplit-{{ section.id }}">{{ section.settings.title | escape }}</h2>
  <div class="lmh-split__grid">
    {%- for block in section.blocks -%}
      <a class="lmh-split__tile" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
        <span class="lmh-split__media"{% if block.settings.position != blank %} style="--pos: {{ block.settings.position }}"{% endif %}>
          {%- render 'lmh-img', img: block.settings.image, asset: block.settings.image_asset, alt: block.settings.image_alt, sizes: '(max-width: 749px) 100vw, 33vw' -%}
        </span>
        {%- if block.settings.title != blank -%}<span class="lmh-split__label">{{ block.settings.title | escape }}</span>{%- endif -%}
        {%- if block.settings.link_text != blank -%}<span class="lmh-split__link">{{ block.settings.link_text | escape }} {% render 'lmh-arrow' %}</span>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
  {%- if section.settings.footer_text != blank -%}
    <p class="lmh-split__all"><a class="lmh-arrow" href="{{ section.settings.footer_url | default: '/collections/all' }}">{{ section.settings.footer_text | escape }} {% render 'lmh-arrow' %}</a></p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "LM split tiles",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Rings, your way." },
    { "type": "select", "id": "style", "label": "Color", "default": "warm", "options": [ { "value": "warm", "label": "Warm white (matches the page)" }, { "value": "navy", "label": "Navy" }, { "value": "espresso", "label": "Espresso" } ] },
    { "type": "text", "id": "footer_text", "label": "Link under the tiles" },
    { "type": "url", "id": "footer_url", "label": "Link under the tiles, URL" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title under the photo" },
        { "type": "text", "id": "link_text", "label": "Link text" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Theme asset image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "position", "label": "Image focus (CSS object-position)", "info": "For example 92% 50% keeps a subject at the right in view." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "LM split tiles" }]
}
{% endschema %}
