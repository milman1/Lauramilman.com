{%- comment -%}
  Laura Milman New York — lab-grown jewelry block.
  Wine ground and gold accents, the house palette. The espresso maison
  block below stays darker so the two sections still separate.
{%- endcomment -%}

{%- assign pd_collection = section.settings.collection -%}

<section class="lm-peaceful" aria-label="Lab-grown jewelry by Laura Milman New York">
  <div class="lm-peaceful__glow" aria-hidden="true"></div>
  <div class="lm-peaceful__container">

    <div class="lm-peaceful__content">
      <span class="lm-peaceful__chip">{{ section.settings.chip_text }}</span>
      <h2 class="lm-peaceful__title">
        {{ section.settings.title }}
        <span class="lm-peaceful__byline">{{ section.settings.byline }}</span>
      </h2>
      {%- if section.settings.description != blank -%}
        <p class="lm-peaceful__desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="lm-peaceful__points">
          {%- for block in section.blocks -%}
            <li class="lm-peaceful__point" {{ block.shopify_attributes }}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="lm-peaceful__buttons">
        {%- if pd_collection != blank -%}
          <a href="{{ pd_collection.url }}" class="lm-peaceful__btn lm-peaceful__btn--solid">
            {{ section.settings.cta_text | default: 'Shop Lab-Grown Jewelry' }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_text != blank and section.settings.secondary_cta_url != blank -%}
          <a href="{{ section.settings.secondary_cta_url }}" class="lm-peaceful__btn lm-peaceful__btn--ghost">
            {{ section.settings.secondary_cta_text }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="lm-peaceful__visual" data-pd-slider>
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          srcset="{{ section.settings.image | image_url: width: 500 }} 500w,
                  {{ section.settings.image | image_url: width: 900 }} 900w"
          sizes="(max-width: 992px) 100vw, 45vw"
          alt="{{ section.settings.title | escape }}"
          loading="lazy"
          decoding="async"
        >
      {%- elsif pd_collection != blank -%}
        {%- assign pd_slide_count = 0 -%}
        {%- for product in pd_collection.products limit: 8 -%}
          {%- if product.featured_image -%}
            {%- assign pd_slide_count = pd_slide_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- capture pd_slides -%}
          {%- for product in pd_collection.products limit: 8 -%}
            {%- if product.featured_image -%}
              <a class="lm-peaceful__slide" data-pd-slide href="{{ product.url }}">
                <img
                  src="{{ product.featured_image | image_url: width: 900 }}"
                  alt="{{ product.title | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  decoding="async"
                  draggable="false"
                >
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if pd_slide_count > 0 -%}
          <div class="lm-peaceful__track" data-pd-track>
            {{ pd_slides }}
          </div>
          {%- if pd_slide_count > 1 -%}
            <button type="button" class="lm-peaceful__nav lm-peaceful__nav--prev" data-pd-prev aria-label="Previous piece">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="lm-peaceful__nav lm-peaceful__nav--next" data-pd-next aria-label="Next piece">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <div class="lm-peaceful__dots" role="tablist" aria-label="Lab-grown jewelry pieces">
              {%- for i in (1..pd_slide_count) -%}
                <button type="button" class="lm-peaceful__dot{% if forloop.first %} is-active{% endif %}" data-pd-dot aria-label="Show piece {{ i }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="lm-peaceful__visual-placeholder" aria-hidden="true">
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg>
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="lm-peaceful__visual-placeholder" aria-hidden="true">
          <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg>
        </div>
      {%- endif -%}
      {%- if pd_collection != blank -%}
        <span class="lm-peaceful__visual-count">{{ pd_collection.products_count }} certified {{ pd_collection.products_count | pluralize: 'piece', 'pieces' }}</span>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  .lm-peaceful {
    position: relative;
    background: linear-gradient(165deg, var(--wine, #4A1428) 0%, #2E0C18 100%);
    padding: 6rem 0;
    overflow: hidden;
  }

  .lm-peaceful__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 60% at 78% 40%, rgba(201, 160, 80, 0.22) 0%, transparent 65%),
      radial-gradient(ellipse 40% 50% at 15% 80%, rgba(226, 194, 122, 0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .lm-peaceful__container {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
    padding: 0 var(--container-padding);
  }

  .lm-peaceful__chip {
    display: inline-block;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold-light, #E2C27A);
    border: 1px solid rgba(226, 194, 122, 0.45);
    border-radius: 100px;
    padding: 0.45rem 1.1rem;
    margin-bottom: 1.75rem;
  }

  .lm-peaceful__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
  }

  .lm-peaceful__byline {
    display: block;
    font-size: 0.42em;
    font-style: italic;
    letter-spacing: 0.04em;
    color: var(--gold-light, #E2C27A);
    margin-top: 0.6rem;
  }

  .lm-peaceful__desc {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.72);
    max-width: 520px;
    margin: 0 0 1.75rem;
  }

  .lm-peaceful__points {
    list-style: none;
    padding: 0;
    margin: 0 0 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .lm-peaceful__point {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.85rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.85);
  }

  .lm-peaceful__point svg {
    color: var(--gold, #C9A050);
    flex-shrink: 0;
  }

  .lm-peaceful__buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .lm-peaceful__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 34px;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-sm, 4px);
    transition: all 0.3s ease;
  }

  .lm-peaceful__btn--solid {
    background: var(--gold, #C9A050);
    color: var(--espresso, #1E1109);
  }

  .lm-peaceful__btn--solid:hover {
    background: var(--gold-light, #E2C27A);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(201, 160, 80, 0.35);
  }

  .lm-peaceful__btn--ghost {
    border: 1px solid rgba(226, 194, 122, 0.55);
    color: var(--gold-pale, #F0DFB0);
    background: transparent;
  }

  .lm-peaceful__btn--ghost:hover {
    border-color: var(--gold-light, #E2C27A);
    background: rgba(201, 160, 80, 0.12);
  }

  .lm-peaceful__visual {
    position: relative;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    border: 1px solid rgba(226, 194, 122, 0.35);
    aspect-ratio: 4 / 5;
    background: #2E0C18;
  }

  .lm-peaceful__track {
    position: absolute;
    inset: 0;
    display: flex;
    height: 100%;
    transition: transform 0.45s ease;
  }

  .lm-peaceful__visual > img {
    position: absolute;
    inset: 0;
  }

  .lm-peaceful__slide {
    flex: 0 0 100%;
    height: 100%;
    min-width: 0;
  }

  .lm-peaceful__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
    user-select: none;
  }

  .lm-peaceful__nav {
    position: absolute;
    top: 46%;
    z-index: 2;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(226, 194, 122, 0.55);
    background: rgba(30, 17, 9, 0.45);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .lm-peaceful__nav:hover {
    background: rgba(30, 17, 9, 0.72);
  }

  .lm-peaceful__nav--prev { left: 0.85rem; }
  .lm-peaceful__nav--next { right: 0.85rem; }

  .lm-peaceful__dots {
    position: absolute;
    right: 1.15rem;
    bottom: 1.35rem;
    z-index: 2;
    display: flex;
    gap: 0.4rem;
  }

  .lm-peaceful__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
  }

  .lm-peaceful__dot.is-active {
    background: var(--gold-light, #E2C27A);
  }

  @media (prefers-reduced-motion: reduce) {
    .lm-peaceful__track { transition: none; }
  }

  .lm-peaceful__visual-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(226, 194, 122, 0.35);
  }

  .lm-peaceful__visual-count {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FFFFFF;
    background: rgba(46, 12, 24, 0.78);
    backdrop-filter: blur(8px);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    border: 1px solid rgba(226, 194, 122, 0.35);
  }

  @media (max-width: 992px) {
    .lm-peaceful__container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .lm-peaceful__visual {
      max-width: 480px;
      aspect-ratio: 1;
    }
  }

  @media (max-width: 768px) {
    .lm-peaceful {
      padding: 4rem 0;
    }
  }
</style>

<script>
  (function () {
    document.querySelectorAll('[data-pd-slider]').forEach(function (root) {
      var track = root.querySelector('[data-pd-track]');
      var slides = root.querySelectorAll('[data-pd-slide]');
      if (!track || slides.length < 2) return;
      var dots = root.querySelectorAll('[data-pd-dot]');
      var index = 0;
      var startX = 0;
      var dragging = false;
      var swiped = false;

      function go(next) {
        index = (next + slides.length) % slides.length;
        track.style.transform = 'translateX(' + (-index * 100) + '%)';
        dots.forEach(function (dot, i) {
          var active = i === index;
          dot.classList.toggle('is-active', active);
          if (active) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      }

      var prev = root.querySelector('[data-pd-prev]');
      var nextBtn = root.querySelector('[data-pd-next]');
      if (prev) prev.addEventListener('click', function () { go(index - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { go(index + 1); });
      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function () { go(i); });
      });

      root.addEventListener('pointerdown', function (event) {
        if (event.target.closest('.lm-peaceful__nav, .lm-peaceful__dot, .lm-peaceful__visual-count')) return;
        dragging = true;
        startX = event.clientX;
      });
      root.addEventListener('pointerup', function (event) {
        if (!dragging) return;
        dragging = false;
        var delta = event.clientX - startX;
        if (Math.abs(delta) < 40) return;
        swiped = true;
        go(delta < 0 ? index + 1 : index - 1);
      });
      root.addEventListener('pointercancel', function () { dragging = false; });
      root.addEventListener('click', function (event) {
        if (!swiped) return;
        swiped = false;
        event.preventDefault();
        event.stopPropagation();
      }, true);
    });
  })();
</script>

{% schema %}
{
  "name": "Lab-Grown Diamonds Feature",
  "tag": "section",
  "class": "section-lab-grown-diamonds-feature",
  "settings": [
    {
      "type": "text",
      "id": "chip_text",
      "label": "Label chip",
      "default": "The Lab-Grown Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Lab-Grown Jewelry"
    },
    {
      "type": "text",
      "id": "byline",
      "label": "Byline",
      "default": "by Laura Milman New York"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Certified lab-grown diamonds, held to the same New York standards as everything we make. The modern way to begin your collection — brilliant, transparent, and priced to make exceptional possible."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Lab-grown jewelry collection"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop Lab-Grown Jewelry"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA text"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature image"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Benefit point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "IGI-certified lab-grown diamonds"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lab-Grown Diamonds Feature",
      "blocks": [
        { "type": "point", "settings": { "text": "Certified lab-grown diamonds" } },
        { "type": "point", "settings": { "text": "Crafted to the same LMNY standard" } },
        { "type": "point", "settings": { "text": "Exceptional carat weight, accessible price" } }
      ]
    }
  ]
}
{% endschema %}
