{{ 'lmny-home.css' | asset_url | stylesheet_tag }}
<section class="lmh lmh-link-band{% if section.settings.style == 'sand' %} lmh-link-band--sand{% endif %}" aria-labelledby="LmhBand-{{ section.id }}">
  <div>
    {%- if section.settings.eyebrow != blank -%}<p class="lmh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="lmh-h2" id="LmhBand-{{ section.id }}">{{ section.settings.title | escape }}</h2>
  </div>
  <div class="lmh-link-band__copy">
    {%- if section.settings.text != blank -%}<p class="lmh-lede">{{ section.settings.text | escape }}</p>{%- endif -%}
    <div class="lmh-link-band__links">
      {%- for block in section.blocks -%}
        <a class="lmh-arrow" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }} {% render 'lmh-arrow' %}</a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "LM editorial link band",
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "default": "ivory", "options": [{ "value": "ivory", "label": "Ivory" }, { "value": "sand", "label": "Sand" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [{
    "type": "link",
    "name": "Link",
    "settings": [
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "url", "label": "Link" }
    ]
  }],
  "max_blocks": 3,
  "presets": [{ "name": "LM editorial link band" }]
}
{% endschema %}
