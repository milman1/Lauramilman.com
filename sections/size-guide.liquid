{%- comment -%}
  Laura Milman New York — Ring Size Guide
  US sizes with diameter/circumference table + measuring tips.
{%- endcomment -%}

<section class="lm-sizes" aria-label="Ring size guide">
  <div class="lm-sizes__container">

    <header class="lm-sizes__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="lm-sizes__title">{{ section.settings.title | default: page.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="lm-sizes__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="lm-sizes__table-wrap">
      <table class="lm-sizes__table">
        <thead>
          <tr>
            <th scope="col">US Size</th>
            <th scope="col">Diameter (mm)</th>
            <th scope="col">Circumference (mm)</th>
          </tr>
        </thead>
        <tbody>
          {%- assign size_rows = '4|14.9|46.8,4.5|15.3|48.0,5|15.7|49.3,5.5|16.1|50.6,6|16.5|51.9,6.5|16.9|53.1,7|17.3|54.4,7.5|17.7|55.7,8|18.1|57.0,8.5|18.5|58.3,9|19.0|59.5,9.5|19.4|60.8,10|19.8|62.1,10.5|20.2|63.4,11|20.6|64.6,11.5|21.0|65.9,12|21.4|67.2,12.5|21.8|68.5,13|22.2|69.7' | split: ',' -%}
          {%- for row in size_rows -%}
            {%- assign cells = row | split: '|' -%}
            <tr>
              <td>{{ cells[0] }}</td>
              <td>{{ cells[1] }}</td>
              <td>{{ cells[2] }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <div class="lm-sizes__tips">
      <h2 class="lm-sizes__tips-title">{{ section.settings.tips_title }}</h2>
      {%- for block in section.blocks -%}
        <div class="lm-sizes__tip" {{ block.shopify_attributes }}>
          <span class="lm-sizes__tip-num">{{ forloop.index }}</span>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="lm-sizes__footer">
        <p>{{ section.settings.footer_text }}</p>
        <a href="{{ section.settings.cta_url | default: '/pages/private-clients' }}" class="btn btn--outline">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .lm-sizes {
    background: var(--warm-white, #FDFAF6);
    padding: 3rem 2rem 5rem;
  }

  .lm-sizes__container {
    max-width: 720px;
    margin: 0 auto;
  }

  .lm-sizes__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .lm-sizes__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    color: var(--text-dark, #2C1810);
    margin: 0.5rem 0 1rem;
  }

  .lm-sizes__intro {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--text-muted, #8A8070);
    max-width: 560px;
    margin: 0 auto;
  }

  .lm-sizes__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border-light, #E8E2D8);
    border-radius: var(--radius-md, 8px);
  }

  .lm-sizes__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.88rem;
  }

  .lm-sizes__table th {
    background: var(--espresso, #1E1109);
    color: var(--gold-light, #E2C27A);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.85rem 1rem;
    text-align: left;
  }

  .lm-sizes__table td {
    padding: 0.65rem 1rem;
    color: var(--text-dark, #2C1810);
    border-bottom: 1px solid var(--border-light, #E8E2D8);
  }

  .lm-sizes__table tbody tr:nth-child(even) {
    background: var(--cream, #FAF6F0);
  }

  .lm-sizes__table tbody tr:last-child td {
    border-bottom: none;
  }

  .lm-sizes__tips {
    margin-top: 3rem;
  }

  .lm-sizes__tips-title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--text-dark, #2C1810);
    margin: 0 0 1.5rem;
  }

  .lm-sizes__tip {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .lm-sizes__tip-num {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(201, 160, 80, 0.15);
    color: var(--gold-dark, #A88340);
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .lm-sizes__tip p {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.75;
    color: var(--text-wine, #4A2018);
    margin: 0;
  }

  .lm-sizes__footer {
    text-align: center;
    margin-top: 3rem;
  }

  .lm-sizes__footer p {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.9rem;
    color: var(--text-muted, #8A8070);
    margin-bottom: 1.25rem;
  }

  @media (max-width: 768px) {
    .lm-sizes {
      padding: 2rem 1.25rem 3.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Ring Size Guide",
  "tag": "section",
  "class": "section-size-guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fit & Sizing"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Ring Size Guide"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Find your size with confidence — and if you're between sizes or buying as a surprise, we'll help you get it right."
    },
    {
      "type": "text",
      "id": "tips_title",
      "label": "Tips heading",
      "default": "How to Measure at Home"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Unsure between two sizes? Complimentary resizing is included on most rings."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Footer CTA text",
      "default": "Ask a Specialist"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Footer CTA link"
    }
  ],
  "blocks": [
    {
      "type": "tip",
      "name": "Measuring tip",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Tip"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ring Size Guide",
      "blocks": [
        { "type": "tip", "settings": { "text": "Wrap a thin strip of paper snugly around the base of your finger and mark where it overlaps. Measure the length in millimeters — that's your circumference." } },
        { "type": "tip", "settings": { "text": "Measure at the end of the day, when your fingers are at their largest. Avoid measuring when your hands are cold." } },
        { "type": "tip", "settings": { "text": "If a ring that fits is already in hand, measure its inside diameter and match it to the table above." } },
        { "type": "tip", "settings": { "text": "Wider bands wear more snugly — for bands over 6mm, consider going up half a size." } }
      ]
    }
  ]
}
{% endschema %}
