  }

  .lm-collection__filter-btn:hover {
    background: var(--text-dark, #2C1810);
    box-shadow: var(--shadow-md);
  }

  .lm-collection__sort {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lm-collection__sort label {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
