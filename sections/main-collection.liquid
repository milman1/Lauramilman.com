    margin-bottom: 1.25rem;
  }

  .lm-collection__empty-title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1.6rem;
    color: var(--text-dark, #2C1810);
    margin: 0 0 0.5rem;
  }

  .lm-collection__empty-text {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.9rem;
    margin: 0 0 1.75rem;
  }

