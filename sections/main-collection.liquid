    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted, #8A8070);
    margin-right: 0.5rem;
  }

  .lm-collection__chip {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-dark, #2C1810);
