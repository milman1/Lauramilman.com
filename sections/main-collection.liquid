    border-color: var(--gold, #C9A050);
    color: var(--gold-dark, #A88340);
    background: rgba(201, 160, 80, 0.06);
  }

  /* Toolbar */
  .lm-collection__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    margin-bottom: 1rem;
    border-top: 1px solid var(--rule-light, #DDD5C5);
    border-bottom: 1px solid var(--rule-light, #DDD5C5);
  }

  .lm-collection__count {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.82rem;
    color: var(--text-muted, #8A8070);
  }

  .lm-collection__controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .lm-collection__filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
