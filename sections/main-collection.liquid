{%- comment -%}
  Laura Milman New York — Collection Page
  Mirrors PD's collection merchandising: SEO description block above the grid,
  shop-by chips, "Refine By" drawer (snippet), sort, product count, numbered
  pagination, and a filtered-empty state with Clear All.

  "Navy mode" re-skins accents for the Peaceful Diamonds (lab-grown) tier —
  assign templates/collection.peaceful.json to that collection.
{%- endcomment -%}

{%- liquid
  assign navy_mode = section.settings.navy_mode
  assign jewelry_only = false
  assign schema_include_products = true
  if collection.handle == 'all' or collection.handle == 'all-jewelry'
    assign jewelry_only = true
    assign schema_include_products = false
  endif
  assign jewelry_handles = 'rings,necklaces,pendants-1,bracelets,earrings,engagement-rings,wedding-bands,stackable-bands,vintage-jewelry,peaceful-diamonds-by-laura-milman-new-york' | split: ','

  assign has_active_filters = false
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign has_active_filters = true
      endif
    elsif filter.active_values.size > 0
      assign has_active_filters = true
    endif
  endfor
-%}

{%- paginate collection.products by section.settings.products_per_page -%}

<section class="lm-collection{% if navy_mode %} lm-collection--navy{% endif %}" aria-label="{{ collection.title | escape }}">
  <div class="lm-collection__container">

    <!-- SEO-loaded collection intro -->
    <header class="lm-collection__header">
      <h1 class="lm-collection__title">
        {%- if jewelry_only -%}All Jewelry{%- else -%}{{ collection.title }}{%- endif -%}
      </h1>
      {%- if jewelry_only -%}
        <div class="lm-collection__desc">
          <p>Rings, necklaces, earrings, bracelets, and estate jewels — not watches. Timepieces are listed separately.</p>
        </div>
      {%- elsif collection.description != blank -%}
        <div class="lm-collection__desc">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if jewelry_only -%}
      <nav class="lm-collection__chips" aria-label="Jewelry categories">
        <span class="lm-collection__chips-label">Shop jewelry</span>
        <a href="/collections/rings" class="lm-collection__chip">Rings</a>
        <a href="/collections/necklaces" class="lm-collection__chip">Necklaces</a>
        <a href="/collections/earrings" class="lm-collection__chip">Earrings</a>
        <a href="/collections/bracelets" class="lm-collection__chip">Bracelets</a>
        <a href="/collections/pendants-1" class="lm-collection__chip">Pendants</a>
        <a href="/collections/engagement-rings" class="lm-collection__chip">Engagement</a>
        <a href="/collections/vintage-jewelry" class="lm-collection__chip">Estate</a>
        <a href="/collections/time-pieces" class="lm-collection__chip">Timepieces</a>
      </nav>
    {%- endif -%}

    <!-- Shop-by chips -->
    {%- if jewelry_only == false and section.blocks.size > 0 -%}
      <nav class="lm-collection__chips" aria-label="Shop by">
        {%- if section.settings.chips_label != blank -%}
          <span class="lm-collection__chips-label">{{ section.settings.chips_label }}</span>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            {%- liquid
              assign chip_href = block.settings.link
              if chip_href == blank and block.settings.filter_query != blank
                assign chip_href = collection.url | append: block.settings.filter_query
              endif
            -%}
            {%- if chip_href != blank -%}
              <a href="{{ chip_href }}" class="lm-collection__chip" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- comment -%} Style quick-filter bar (jewelry only; never on loose diamonds) {%- endcomment -%}
    {%- render 'jewelry-style-bar', collection: collection -%}

    <!-- Toolbar -->
    <div class="lm-collection__toolbar">
      <span class="lm-collection__count" role="status">
        {%- if jewelry_only -%}
          Jewelry only — watches are listed under Timepieces
        {%- elsif paginate.pages > 1 -%}
          Showing {{ paginate.current_offset | plus: 1 }}&ndash;{{ paginate.current_offset | plus: collection.products.size }} of {{ collection.products_count }} products
        {%- else -%}
          Showing {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
        {%- endif -%}
      </span>

      <div class="lm-collection__controls">
        {%- unless jewelry_only -%}
        <button type="button" class="lm-collection__filter-btn" id="RefineOpen" aria-haspopup="dialog">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          Filter &amp; Sort
        </button>

        <div class="lm-collection__sort">
          <label for="lm-sort-select">Sort by</label>
          <select id="lm-sort-select">
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            {%- assign sort_pairs = 'manual::Featured||best-selling::Best Selling||price-ascending::Price: Low to High||price-descending::Price: High to Low||created-descending::Date: New to Old||title-ascending::Alphabetically, A–Z' | split: '||' -%}
            {%- for pair in sort_pairs -%}
              {%- assign sort_parts = pair | split: '::' -%}
              <option value="{{ sort_parts[0] }}" {% if current_sort == sort_parts[0] %}selected{% endif %}>{{ sort_parts[1] }}</option>
            {%- endfor -%}
          </select>
        </div>
        {%- endunless -%}
      </div>
    </div>

    <!-- Active filter pills -->
    {%- if has_active_filters and jewelry_only == false -%}
      <div class="lm-collection__active" aria-label="Active filters">
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
              <a href="{{ filter.url_to_remove }}" class="lm-collection__active-pill">
                {{ filter.label }}:
                {% if filter.min_value.value %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %}
                &ndash;
                {% if filter.max_value.value %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %}
                <span aria-hidden="true">&times;</span>
              </a>
            {%- endif -%}
          {%- else -%}
            {%- for value in filter.active_values -%}
              <a href="{{ value.url_to_remove }}" class="lm-collection__active-pill">
                {{ value.label }}
                <span aria-hidden="true">&times;</span>
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ collection.url }}" class="lm-collection__clear-all">Clear all filters</a>
      </div>
    {%- endif -%}

    <!-- Product grid -->
    {%- if jewelry_only or collection.products.size > 0 -%}
      <div class="products-grid lm-collection__grid" id="productsGrid">
        {%- if jewelry_only -%}
          {%- assign seen_ids = ',' -%}
          {%- assign shown_count = 0 -%}
          {%- for handle in jewelry_handles -%}
            {%- if shown_count >= 48 -%}{% break %}{%- endif -%}
            {%- assign src_col = collections[handle] -%}
            {%- if src_col != blank -%}
              {%- for product in src_col.products limit: 50 -%}
                {%- if shown_count >= 48 -%}{% break %}{%- endif -%}
                {%- capture watch_flag -%}{% render 'product-is-watch', product: product %}{%- endcapture -%}
                {%- assign pid = ',' | append: product.id | append: ',' -%}
                {%- if watch_flag != 'true' -%}
                  {%- unless seen_ids contains pid -%}
                    {%- render 'product-card', product: product -%}
                    {%- assign seen_ids = seen_ids | append: product.id | append: ',' -%}
                    {%- assign shown_count = shown_count | plus: 1 -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="lm-collection__empty lm-collection__empty--filtered" id="jewelryFilterNoResults" hidden>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <p class="lm-collection__empty-title">No products match your filters</p>
        <p class="lm-collection__empty-text">Try adjusting your selections or clear all filters.</p>
        <button type="button" class="btn btn--gold" id="jewelryFilterClearBtn">Clear All Filters</button>
      </div>

      <!-- Pagination -->
      {%- if paginate.pages > 1 and jewelry_only == false -%}
        <nav class="lm-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="lm-pagination__arrow" aria-label="Previous page">&larr;</a>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="lm-pagination__page">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="lm-pagination__page lm-pagination__page--current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="lm-pagination__ellipsis">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="lm-pagination__arrow" aria-label="Next page">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- elsif has_active_filters -%}
      <div class="lm-collection__empty">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <p class="lm-collection__empty-title">No products match your filters</p>
        <p class="lm-collection__empty-text">Try removing a filter, or start over to see the full collection.</p>
        <a href="{{ collection.url }}" class="btn btn--gold">Clear All Filters</a>
      </div>
    {%- else -%}
      <div class="lm-collection__empty">
        <p class="lm-collection__empty-title">This collection is coming soon</p>
        <p class="lm-collection__empty-text">In the meantime, explore the full Laura Milman New York collection.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--gold">View All Jewelry</a>
      </div>
    {%- endif -%}

  </div>
</section>

{%- unless jewelry_only -%}
{%- render 'filter-drawer', results: collection -%}
{%- endunless -%}

{% render 'structured-data-collection',
  collection: collection,
  include_products: schema_include_products
%}

{%- endpaginate -%}

<style>
