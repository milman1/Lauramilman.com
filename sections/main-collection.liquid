  /* ── Navy mode: Peaceful Diamonds tier ── */
  .lm-collection--navy {
    background: linear-gradient(180deg, #F4F6FB 0%, var(--warm-white, #FDFAF6) 320px);
  }

  .lm-collection--navy .lm-collection__title {
    color: var(--navy, #1A1F3A);
  }

  .lm-collection--navy .lm-collection__filter-btn {
    background: var(--navy, #1A1F3A);
  }

  .lm-collection--navy .lm-collection__filter-btn svg {
    color: var(--pd-ice, #A9BEE3);
  }

  .lm-collection--navy .lm-collection__filter-btn:hover {
    background: var(--navy-deep, #12162B);
  }

  .lm-collection--navy .lm-collection__chip:hover {
    border-color: var(--pd-blue, #5B7FBD);
    color: var(--pd-blue, #5B7FBD);
    background: rgba(91, 127, 189, 0.06);
  }

  .lm-collection--navy .lm-collection__active-pill {
    color: var(--navy, #1A1F3A);
    background: rgba(91, 127, 189, 0.1);
    border-color: rgba(91, 127, 189, 0.35);
  }

  .lm-collection--navy .lm-collection__clear-all {
    color: var(--pd-blue, #5B7FBD);
  }

  .lm-collection--navy .lm-pagination__page--current {
    background: var(--navy, #1A1F3A);
  }

  .lm-collection--navy .lm-pagination__page:hover,
  .lm-collection--navy .lm-pagination__arrow:hover {
    border-color: var(--pd-blue, #5B7FBD);
    color: var(--pd-blue, #5B7FBD);
  }

  @media (max-width: 1024px) {
    .lm-collection__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .lm-collection {
      padding: 0.5rem 0 3rem;
    }
    .lm-collection__header {
      padding: 1.75rem 0 1.25rem;
    }
    .lm-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .lm-collection__toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .lm-collection__count {
      text-align: center;
    }
    .lm-collection__controls {
      justify-content: space-between;
    }
    .lm-collection__sort label {
      display: none;
    }
    .lm-collection__chips {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }
    .lm-collection__chips::-webkit-scrollbar {
      display: none;
    }
    .lm-collection__chip {
      white-space: nowrap;
    }
  }
</style>

<script>
  (function () {
    var drawer = document.getElementById('RefineDrawer');
    var overlay = document.getElementById('RefineOverlay');
    var openBtn = document.getElementById('RefineOpen');
    var closeBtn = document.getElementById('RefineClose');
    var form = document.getElementById('RefineForm');
    var sortSelect = document.getElementById('lm-sort-select');
    var productsGrid = document.getElementById('productsGrid');
    var noResultsEl = document.getElementById('jewelryFilterNoResults');
    var clearBtn = document.getElementById('jewelryFilterClearBtn');
    var countEl = document.querySelector('.lm-collection__count');
    var allCards = productsGrid ? Array.from(productsGrid.querySelectorAll('.product-card')) : [];
    var totalOnPage = allCards.length;
    var hasJewelryFilters = !!document.querySelector('[data-jewelry-filters]');

    function openDrawer() {
      if (!drawer) return;
      overlay.hidden = false;
      requestAnimationFrame(function () {
        overlay.classList.add('active');
        drawer.classList.add('active');
      });
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawer) return;
      overlay.classList.remove('active');
      drawer.classList.remove('active');
      document.body.style.overflow = '';
      setTimeout(function () { overlay.hidden = true; }, 300);
    }

    if (openBtn) openBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (overlay) overlay.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer && drawer.classList.contains('active')) closeDrawer();
    });

    // Collapsible groups
    document.querySelectorAll('[data-refine-group] .refine__group-head').forEach(function (head) {
      head.addEventListener('click', function () {
        var group = head.closest('[data-refine-group]');
        var collapsed = group.classList.toggle('collapsed');
        head.setAttribute('aria-expanded', String(!collapsed));
      });
    });

    /* ---------- Jewelry client-side filters (PD-style) ---------- */
    function normalize(value) {
      return String(value || '').toLowerCase().replace(/[-_]+/g, ' ');
    }

    function containsValue(haystack, needle) {
      return normalize(haystack).indexOf(normalize(needle)) !== -1;
    }

    function extractCarat(card) {
      var raw = card.dataset.carat || '';
      var fromMeta = parseFloat(String(raw).replace(/[^0-9.]/g, ''));
      if (!isNaN(fromMeta) && fromMeta > 0) return fromMeta;
      var title = card.dataset.title || '';
      var match = title.match(/([\d.]+)\s*(?:carat|ct)\b/i);
      return match ? parseFloat(match[1]) : null;
    }

    function caratInRange(carat, rangeKey) {
      if (carat === null || isNaN(carat)) return false;
      switch (rangeKey) {
        case 'Under 0.5 Carats': return carat < 0.5;
        case '0.5-1 Carats': return carat >= 0.5 && carat < 1;
        case 'Under 1 Carat': return carat < 1;
        case '1-2 Carats': return carat >= 1 && carat < 2;
        case 'Under 2 Carats': return carat < 2;
        case '2-3 Carats': return carat >= 2 && carat < 3;
        case 'Under 3 Carats': return carat < 3;
        case '3-4 Carats': return carat >= 3 && carat < 4;
        case '3-5 Carats': return carat >= 3 && carat < 5;
        case '4-5 Carats': return carat >= 4 && carat < 5;
        case '5-7 Carats': return carat >= 5 && carat < 7;
        case '5-10 Carats': return carat >= 5 && carat < 10;
        case '7-10 Carats': return carat >= 7 && carat < 10;
        case '10-20 Carats': return carat >= 10 && carat < 20;
        case '5+ Carats': return carat >= 5;
        case '3+ Carats': return carat >= 3;
        case '7+ Carats': return carat >= 7;
        case '10+ Carats': return carat >= 10;
        case '20+ Carats': return carat >= 20;
        default: return false;
      }
    }

    function selectedValues(selector) {
      return Array.prototype.map.call(
        document.querySelectorAll(selector + ':checked'),
        function (el) { return el.value; }
      );
    }

    function syncStyleBar(selectedTypes) {
      var chips = document.querySelectorAll('.js-jf-style-chip');
      if (!chips.length) return;
      var multi = selectedTypes.length > 1;
      chips.forEach(function (chip) {
        var val = chip.getAttribute('data-style-value') || '';
        var active = val === ''
          ? selectedTypes.length === 0
          : (!multi && selectedTypes.length === 1 && normalize(selectedTypes[0]) === normalize(val));
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', String(active));
      });
    }

    function syncURL(selectedTypes, selectedMetals, caratRange) {
      try {
        var params = new URLSearchParams(window.location.search);
        ['type', 'metal', 'carat'].forEach(function (k) { params.delete(k); });
        if (selectedTypes.length) params.set('type', selectedTypes.join(','));
        if (selectedMetals.length) params.set('metal', selectedMetals.join(','));
        if (caratRange) params.set('carat', caratRange);
        var qs = params.toString();
        var next = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
        window.history.replaceState({}, '', next);
      } catch (e) { /* ignore */ }
    }

    function updateFilterBadge(activeCount) {
      if (!openBtn) return;
      var base = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg> Filter &amp; Sort';
      if (activeCount > 0) {
        openBtn.innerHTML = base + ' <span class="lm-collection__filter-count">' + activeCount + '</span>';
      } else {
        openBtn.innerHTML = base;
      }
    }

    function applyJewelryFilters() {
      if (!hasJewelryFilters || !allCards.length) return;

      var selectedTypes = selectedValues('.js-jf-style');
      var selectedMetals = selectedValues('.js-jf-metal');
      var caratBtn = document.querySelector('.js-jf-carat-btn.is-active');
      var caratRange = caratBtn ? caratBtn.getAttribute('data-carat') : null;

      var visibleCount = 0;
      var hasActive = selectedTypes.length > 0 || selectedMetals.length > 0 || !!caratRange;

      allCards.forEach(function (card) {
        var tags = card.dataset.tags || '';
        var titleLower = card.dataset.titleLower || '';
        var productType = card.dataset.type || '';
        var metalMeta = card.dataset.metal || '';
        var show = true;

        if (show && selectedTypes.length) {
          var typeMatch = selectedTypes.some(function (type) {
            return containsValue(tags, type) || containsValue(titleLower, type) || containsValue(productType, type);
          });
          if (!typeMatch) show = false;
        }

        if (show && selectedMetals.length) {
          var metalMatch = selectedMetals.some(function (metal) {
            return containsValue(tags, metal) || containsValue(titleLower, metal) || containsValue(metalMeta, metal);
          });
          if (!metalMatch) show = false;
        }

        if (show && caratRange) {
          if (!caratInRange(extractCarat(card), caratRange)) show = false;
        }

        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      if (countEl && hasActive) {
        countEl.textContent = 'Showing ' + visibleCount + ' of ' + totalOnPage + ' products';
      } else if (countEl && countEl.dataset.defaultCount) {
        countEl.textContent = countEl.dataset.defaultCount;
      }

      if (noResultsEl) {
        noResultsEl.hidden = !(visibleCount === 0 && hasActive);
        if (productsGrid) productsGrid.style.display = (visibleCount === 0 && hasActive) ? 'none' : '';
      }

      syncStyleBar(selectedTypes);
      syncURL(selectedTypes, selectedMetals, caratRange);
      updateFilterBadge(selectedTypes.length + selectedMetals.length + (caratRange ? 1 : 0));
    }

    function clearJewelryFilters() {
      document.querySelectorAll('.js-jf-style, .js-jf-metal').forEach(function (input) {
        input.checked = false;
      });
      document.querySelectorAll('.js-jf-carat-btn').forEach(function (btn) {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-pressed', 'false');
      });
      applyJewelryFilters();
    }

    function hydrateFromURL() {
      var params = new URLSearchParams(window.location.search);
      var applied = false;

      function checkList(paramName, selector) {
        var raw = params.get(paramName);
        if (!raw) return;
        var wanted = raw.split(',').map(function (v) { return normalize(v.trim()); }).filter(Boolean);
        document.querySelectorAll(selector).forEach(function (input) {
          if (wanted.indexOf(normalize(input.value)) !== -1) {
            input.checked = true;
            applied = true;
          }
        });
      }

      checkList('type', '.js-jf-style');
      checkList('metal', '.js-jf-metal');

      var caratParam = params.get('carat');
      if (caratParam) {
        var wantedCarat = normalize(caratParam);
        document.querySelectorAll('.js-jf-carat-btn').forEach(function (btn) {
          if (normalize(btn.getAttribute('data-carat')) === wantedCarat) {
            btn.classList.add('is-active');
            btn.setAttribute('aria-pressed', 'true');
            applied = true;
          }
        });
      }

      if (applied) applyJewelryFilters();
      else syncStyleBar([]);
    }

    if (countEl) countEl.dataset.defaultCount = countEl.textContent.trim();

    if (hasJewelryFilters) {
      if (form) {
        form.addEventListener('change', function (e) {
          if (e.target && e.target.matches('[data-client-filter]')) {
            e.stopPropagation();
            applyJewelryFilters();
          }
        }, true);

        // Prevent jewelry filter fields from being submitted as Shopify params
        form.addEventListener('submit', function () {
          form.querySelectorAll('[data-client-filter]').forEach(function (input) {
            input.disabled = true;
          });
          form.querySelectorAll('input[type="number"]').forEach(function (input) {
            if (input.value === '') input.disabled = true;
          });
        });
      }

      document.querySelectorAll('.js-jf-style-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          var value = chip.getAttribute('data-style-value') || '';
          document.querySelectorAll('.js-jf-style').forEach(function (input) {
            input.checked = value !== '' && normalize(input.value) === normalize(value);
          });
          applyJewelryFilters();
        });
      });

      document.querySelectorAll('.js-jf-carat-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var wasActive = btn.classList.contains('is-active');
          document.querySelectorAll('.js-jf-carat-btn').forEach(function (b) {
            b.classList.remove('is-active');
            b.setAttribute('aria-pressed', 'false');
          });
          if (!wasActive) {
            btn.classList.add('is-active');
            btn.setAttribute('aria-pressed', 'true');
          }
          applyJewelryFilters();
        });
      });

      if (clearBtn) clearBtn.addEventListener('click', clearJewelryFilters);

      var refineClear = form ? form.querySelector('.refine__clear') : null;
      if (refineClear) {
        refineClear.addEventListener('click', function () {
          clearJewelryFilters();
        });
      }

      hydrateFromURL();
    }

    if (form) {
      // Native S&D checkboxes / sort radios still apply via form submit
      form.addEventListener('change', function (e) {
        if (e.target.matches('[data-client-filter]')) return;
        if (e.target.matches('input[type="checkbox"], input[type="radio"]')) {
          if (typeof form.requestSubmit === 'function') form.requestSubmit();
          else form.submit();
        }
      });
    }

    // Toolbar sort preserves active filter params
    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        var params = new URLSearchParams(window.location.search);
        params.set('sort_by', sortSelect.value);
        params.delete('page');
        window.location.href = window.location.pathname + '?' + params.toString();
      });
    }
  })();
</script>

<style>
  .lm-collection__filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    margin-left: 0.35rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--gold, #C9A050);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
  }
  .lm-collection__empty--filtered[hidden] {
    display: none !important;
  }
</style>

{% schema %}
{
  "name": "Collection Products",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 48
    },
    {
      "type": "text",
      "id": "chips_label",
      "label": "Shop-by label",
      "default": "Shop by"
    },
    {
      "type": "checkbox",
      "id": "navy_mode",
      "label": "Navy mode (Peaceful Diamonds tier)",
      "info": "Cool navy accents for the lab-grown sub-brand. Leave off for LMNY-proper collections.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Shop-by chip",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (absolute)",
          "info": "Use for landing collections, e.g. /collections/sapphire-engagement-rings"
        },
        {
          "type": "text",
          "id": "filter_query",
          "label": "Filter query (relative)",
          "info": "Appended to the current collection URL, e.g. ?filter.v.price.lte=5000. Used only when Link is empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Products"
    }
  ]
}
{% endschema %}
