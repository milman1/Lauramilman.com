{%- comment -%}
  Loose-diamond page → engagement rings made for this diamond's shape.
  Matches on shape only: the diamond's custom.diamond_shape against each
  ring's stated center-stone shape (snippets/center-stone-shape.liquid).
  "Set it in this ring" opens the ring with ?diamond=<handle>, where the
  pairing block shows both and takes a quote request. Rings are priced with
  their own center stone, so no ring price is shown here.
{%- endcomment -%}

{%- liquid
  assign stone_shape = product.metafields.custom.diamond_shape.value | strip
  assign ring_collection = section.settings.collection | default: collections['engagement-rings']
  assign max_rings = section.settings.max_rings | default: 4
  assign matches = 0
  assign stone_image = ''
  if product.featured_image
    assign stone_image = product.featured_image | image_url: width: 240
  endif
-%}

{%- if stone_shape != blank and ring_collection != blank -%}
  {%- capture cards -%}
    {%- for ring in ring_collection.products limit: 50 -%}
      {%- if matches < max_rings and ring.available and ring.id != product.id -%}
        {%- capture ring_shape -%}{% render 'center-stone-shape', product: ring %}{%- endcapture -%}
        {%- assign ring_shape = ring_shape | strip -%}
        {%- if ring_shape == stone_shape -%}
          {%- assign matches = matches | plus: 1 -%}
          <li class="dring__card">
            <a class="dring__link" href="{{ ring.url }}?diamond={{ product.handle | url_encode }}" data-ring-handle="{{ ring.handle }}">
              <span class="dring__media">
                {%- if ring.featured_image -%}
                  <img
                    src="{{ ring.featured_image | image_url: width: 600 }}"
                    srcset="{{ ring.featured_image | image_url: width: 300 }} 300w, {{ ring.featured_image | image_url: width: 600 }} 600w"
                    sizes="(max-width: 750px) 50vw, 25vw"
                    alt="{{ ring.featured_image.alt | default: ring.title | escape }}"
                    width="600"
                    height="600"
                    loading="lazy"
                  >
                {%- endif -%}
              </span>
              <span class="dring__title">{{ ring.title }}</span>
              <span class="dring__cta">Set it in this ring</span>
            </a>
          </li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  <section class="dring" aria-labelledby="DiamondRingMatch-{{ section.id }}" data-dring data-stone-shape="{{ stone_shape | escape }}" data-stone-handle="{{ product.handle }}">
    <div class="dring__inner">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="dring__heading" id="DiamondRingMatch-{{ section.id }}">
        {{ section.settings.heading | replace: '[shape]', stone_shape }}
      </h2>

      <p class="dring__recent" data-dring-recent hidden>
        <a href="#" data-dring-recent-link></a>
      </p>

      {%- if matches > 0 -%}
        <ul class="dring__grid" role="list">{{ cards }}</ul>
        <p class="dring__note">Rings are pictured with our own center stones. Choose a setting and we will quote it with this diamond and confirm every detail before anything is made.</p>
      {%- else -%}
        <p class="dring__note">None of our current settings is made for {{ stone_shape | downcase }}-cut diamonds. Ask us about a custom setting for this stone.</p>
        <div class="pdp-inquire__actions dring__ask">
          <button
            type="button"
            class="pdp-inquire__btn js-open-product-chat"
            data-chat-intent="ask"
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
            data-product-url="{{ shop.url }}{{ product.url }}"
            data-product-image="{{ stone_image | escape }}"
          >
            Ask about a setting
          </button>
        </div>
      {%- endif -%}
    </div>
  </section>

  <style>
    .dring {
      background: var(--warm-white, #FDFAF6);
      padding: 3rem 2rem;
      border-top: 1px solid var(--rule-light, #DDD5C5);
    }
    .dring__inner { max-width: 1200px; margin: 0 auto; }
    .dring__heading {
      font-family: var(--font-heading, 'Cormorant Garamond', serif);
      font-size: clamp(1.7rem, 3vw, 2.3rem);
      font-weight: 400;
      color: var(--text-dark, #2C1810);
      margin: 0.35rem 0 1.5rem;
    }
    .dring__grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .dring__link {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      color: var(--text-dark, #2C1810);
      text-decoration: none;
    }
    .dring__media {
      display: block;
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: var(--radius-md, 8px);
      background: var(--cream, #FAF6F0);
    }
    .dring__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .dring__link:hover .dring__media img { transform: scale(1.03); }
    .dring__title {
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.85rem;
      line-height: 1.45;
    }
    .dring__cta {
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold-dark, #A88340);
    }
    .dring__note,
    .dring__recent {
      margin: 1.25rem 0 0;
      font-family: var(--font-body, 'Montserrat', sans-serif);
      font-size: 0.82rem;
      line-height: 1.7;
      color: var(--text-muted, #8A8070);
      max-width: 640px;
    }
    .dring__recent { margin: 0 0 1.25rem; }
    .dring__recent a { color: var(--gold-dark, #A88340); font-weight: 500; }
    .dring__ask { margin-top: 1rem; }
    @media (max-width: 750px) {
      .dring { padding: 2.25rem 1rem; }
      .dring__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    }
  </style>

  <script>
    (function () {
      var root = document.querySelector('[data-dring]');
      if (!root) return;
      var ring = null;
      try { ring = JSON.parse(sessionStorage.getItem('lmPairRing') || 'null'); } catch (e) {}
      if (!ring || !ring.handle || !/^[a-z0-9][a-z0-9-]{0,99}$/.test(ring.handle)) return;
      if (ring.shape !== root.getAttribute('data-stone-shape')) return;
      // The ring the shopper came from goes first, as a direct link back.
      var link = root.querySelector('[data-dring-recent-link]');
      link.href = '/products/' + ring.handle + '?diamond=' + encodeURIComponent(root.getAttribute('data-stone-handle'));
      link.textContent = 'Set this diamond in the ' + (ring.title || 'ring you were viewing') + ' →';
      root.querySelector('[data-dring-recent]').hidden = false;
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Rings for this diamond",
  "tag": "div",
  "class": "section-diamond-ring-match",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Make it a ring" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Settings made for [shape] diamonds",
      "info": "[shape] is replaced with this diamond's shape."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Ring collection",
      "info": "Defaults to Engagement Rings. Rings match when their center-stone shape equals this diamond's."
    },
    { "type": "range", "id": "max_rings", "label": "Rings to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Rings for this diamond" }]
}
{% endschema %}
