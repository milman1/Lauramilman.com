{%- comment -%}
  Homepage diamond search: the same shape, carat, price, color and clarity
  choices as the stone search, in a compact form. Submitting opens the
  lab-grown (or natural) search with those choices already applied;
  assets/diamond-storefront.js reads them from the URL.
{%- endcomment -%}
{{ 'lmny-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shapes = section.settings.shapes | default: 'Round,Oval,Emerald,Cushion,Pear,Radiant,Princess,Marquise' | split: ','
  assign lab_url = section.settings.lab_url | default: '/collections/lab-grown-diamonds'
  assign natural_url = section.settings.natural_url | default: '/collections/natural-diamonds'
-%}

<section class="lmh lmh-dsearch" aria-labelledby="LmhDsearch-{{ section.id }}">
  <div class="lmh-dsearch__head">
    {%- if section.settings.eyebrow != blank -%}<p class="lmh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="lmh-h2" id="LmhDsearch-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="lmh-dsearch__text">{{ section.settings.text | escape }}</p>{%- endif -%}
  </div>

  <form class="lmh-dsearch__form" action="{{ lab_url }}" method="get" data-lab-url="{{ lab_url }}" data-natural-url="{{ natural_url }}">
    <div class="lmh-dsearch__origin" role="radiogroup" aria-label="Diamond origin">
      <label><input type="radio" name="lmh_origin" value="lab" checked><span>Lab-grown</span></label>
      <label><input type="radio" name="lmh_origin" value="natural"><span>Natural</span></label>
    </div>

    <fieldset class="lmh-dsearch__shapes">
      <legend class="lmh-dsearch__label">Shape</legend>
      {%- for name in shapes -%}
        {%- assign shape_name = name | strip -%}
        {%- assign shape_key = shape_name | downcase -%}
        <label class="lmh-dsearch__shape">
          <input type="checkbox" name="shape" value="{{ shape_name | escape }}">
          <span class="lmh-dsearch__icon">{%- render 'diamond-shape-icon', shape: shape_key -%}</span>
          <span class="lmh-dsearch__shape-name">{{ shape_name }}</span>
        </label>
      {%- endfor -%}
    </fieldset>

    <div class="lmh-dsearch__fields">
      <div class="lmh-dsearch__field">
        <span class="lmh-dsearch__label">Carat</span>
        <div class="lmh-dsearch__pair">
          <input type="number" name="min_carat" inputmode="decimal" step="0.01" min="0" placeholder="Min" aria-label="Minimum carat">
          <span aria-hidden="true">&ndash;</span>
          <input type="number" name="max_carat" inputmode="decimal" step="0.01" min="0" placeholder="Max" aria-label="Maximum carat">
        </div>
      </div>
      <div class="lmh-dsearch__field">
        <label class="lmh-dsearch__label" for="LmhDsearchPrice-{{ section.id }}">Budget up to</label>
        <select name="max_price" id="LmhDsearchPrice-{{ section.id }}">
          <option value="">Any budget</option>
          <option value="1000">{{ 100000 | money_without_trailing_zeros }}</option>
          <option value="2500">{{ 250000 | money_without_trailing_zeros }}</option>
          <option value="5000">{{ 500000 | money_without_trailing_zeros }}</option>
          <option value="10000">{{ 1000000 | money_without_trailing_zeros }}</option>
          <option value="25000">{{ 2500000 | money_without_trailing_zeros }}</option>
        </select>
      </div>
      <div class="lmh-dsearch__field">
        <label class="lmh-dsearch__label" for="LmhDsearchColor-{{ section.id }}">Color</label>
        <select name="color" id="LmhDsearchColor-{{ section.id }}">
          <option value="">Any color</option>
          <option value="D,E,F">D–F · colorless</option>
          <option value="G,H">G–H · near colorless</option>
          <option value="I,J">I–J · faint warmth</option>
        </select>
      </div>
      <div class="lmh-dsearch__field">
        <label class="lmh-dsearch__label" for="LmhDsearchClarity-{{ section.id }}">Clarity</label>
        <select name="clarity" id="LmhDsearchClarity-{{ section.id }}">
          <option value="">Any clarity</option>
          <option value="FL,IF,VVS1,VVS2">FL–VVS</option>
          <option value="VS1,VS2">VS</option>
          <option value="SI1,SI2">SI</option>
        </select>
      </div>
    </div>

    <div class="lmh-dsearch__actions">
      <button type="submit" class="lmh-btn lmh-btn--dark">{{ section.settings.button_text | default: 'Explore All Diamonds' | escape }}</button>
      {%- if section.settings.note != blank -%}<p class="lmh-dsearch__note">{{ section.settings.note | escape }}</p>{%- endif -%}
    </div>
  </form>
</section>

<script>
  (function () {
    var form = document.querySelector('#shopify-section-{{ section.id }} .lmh-dsearch__form');
    if (!form) return;
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var origin = form.querySelector('input[name="lmh_origin"]:checked');
      var base = origin && origin.value === 'natural' ? form.dataset.naturalUrl : form.dataset.labUrl;
      var params = new URLSearchParams();
      var shapes = Array.prototype.map.call(form.querySelectorAll('input[name="shape"]:checked'), function (i) { return i.value; });
      if (shapes.length) params.set('shape', shapes.join(','));
      ['min_carat', 'max_carat', 'max_price', 'color', 'clarity'].forEach(function (name) {
        var el = form.elements[name];
        if (el && el.value) params.set(name, el.value);
      });
      var query = params.toString();
      window.location.href = base + (query ? '?' + query : '');
    });
  })();
</script>

{% schema %}
{
  "name": "LM diamond search",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Find a diamond that feels like you." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "shapes", "label": "Shapes (comma separated)", "default": "Round,Oval,Emerald,Cushion,Pear,Radiant,Princess,Marquise" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Explore All Diamonds" },
    { "type": "text", "id": "note", "label": "Note under the button" },
    { "type": "url", "id": "lab_url", "label": "Lab-grown search link" },
    { "type": "url", "id": "natural_url", "label": "Natural search link" }
  ],
  "presets": [{ "name": "LM diamond search" }]
}
{% endschema %}
