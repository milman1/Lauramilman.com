{%- comment -%}
  Laura Milman New York — Hero Section
  Single strong campaign image over espresso, heritage NY / made-in-Italy
  positioning, two CTAs. Trust strip renders as its own section below.
{%- endcomment -%}

{%- liquid
  assign hero_split = false
  assign hero_editorial = false
  if section.settings.layout == 'split'
    assign hero_split = true
  elsif section.settings.layout == 'editorial'
    assign hero_editorial = true
  endif
  assign hero_alt = section.settings.image_alt | default: section.settings.heading | strip_html | strip_newlines
-%}
<section class="lm-hero{% if hero_split %} lm-hero--split{% endif %}{% if hero_editorial %} lm-hero--editorial{% endif %}" aria-label="Hero">
  {%- unless hero_split -%}
  <div class="lm-hero__bg" aria-hidden="true"></div>
  <div class="lm-hero__glow" aria-hidden="true"></div>
  {%- endunless -%}

  {%- if hero_split -%}
    {%- comment -%} Split layout: the photo sits beside the copy, never under it. {%- endcomment -%}
  {%- elsif hero_editorial -%}
    {%- comment -%}
      Editorial layout: the photo fills the right side and fades into the
      espresso ground behind left-aligned copy.
    {%- endcomment -%}
    <div class="lm-hero__editorial-media">
      {%- if section.settings.background_image != blank -%}
        <img
          src="{{ section.settings.background_image | image_url: width: 1600 }}"
          srcset="{{ section.settings.background_image | image_url: width: 800 }} 800w,
                  {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
                  {{ section.settings.background_image | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 768px) 100vw, 62vw"
          width="{{ section.settings.background_image.width }}"
          height="{{ section.settings.background_image.height }}"
          alt="{{ hero_alt | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- elsif section.settings.image_asset != blank -%}
        <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ hero_alt | escape }}" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
  {%- elsif section.settings.background_image != blank -%}
    <img
      class="lm-hero__image"
      src="{{ section.settings.background_image | image_url: width: 1920 }}"
      srcset="{{ section.settings.background_image | image_url: width: 600 }} 600w,
              {{ section.settings.background_image | image_url: width: 900 }} 900w,
              {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
              {{ section.settings.background_image | image_url: width: 1920 }} 1920w"
      sizes="100vw"
      style="opacity: {{ section.settings.image_opacity | default: 55 | divided_by: 100.0 }};"
      alt="{{ section.settings.heading | strip_html | strip_newlines | escape }}"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
    <div class="lm-hero__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="lm-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="lm-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="lm-hero__title">
      {{- section.settings.heading | escape | newline_to_br -}}
      {%- if section.settings.heading_emphasis != blank %} <em>{{ section.settings.heading_emphasis | escape }}</em>{% endif -%}
    </h1>

    {%- if section.settings.subheading != blank -%}
      <p class="lm-hero__description">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="lm-hero__buttons">
      {%- if section.settings.primary_cta_text != blank -%}
        <a href="{{ section.settings.primary_cta_url | default: '/collections/all' }}" class="btn btn--gold btn--lg">
          {{ section.settings.primary_cta_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_cta_text != blank -%}
        <a href="{{ section.settings.secondary_cta_url | default: '/collections/all' }}" class="btn {% if hero_split %}lm-hero__link{% else %}btn--outline-light{% endif %} btn--lg">
          {{ section.settings.secondary_cta_text }}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.note != blank -%}
      <p class="lm-hero__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>

  {%- if hero_editorial and section.settings.caption_title != blank -%}
    <p class="lm-hero__caption"><span>{{ section.settings.caption_title }}</span>{{ section.settings.caption_text }}</p>
  {%- endif -%}

  {%- if hero_split -%}
    <div class="lm-hero__media">
      {%- if section.settings.background_image != blank -%}
        <img
          src="{{ section.settings.background_image | image_url: width: 1400 }}"
          srcset="{{ section.settings.background_image | image_url: width: 600 }} 600w,
                  {{ section.settings.background_image | image_url: width: 900 }} 900w,
                  {{ section.settings.background_image | image_url: width: 1400 }} 1400w"
          sizes="(max-width: 768px) 100vw, 50vw"
          width="{{ section.settings.background_image.width }}"
          height="{{ section.settings.background_image.height }}"
          alt="{{ hero_alt | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- elsif section.settings.image_asset != blank -%}
        <img
          src="{{ section.settings.image_asset | asset_url }}"
          alt="{{ hero_alt | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>
  {%- elsif hero_editorial == false -%}
  <div class="lm-hero__scroll" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </div>
  {%- endif -%}
</section>

<style>
  .lm-hero {
    position: relative;
    min-height: 80vh;
    min-height: calc(100svh - var(--header-height, 84px) - 44px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--cream, #FAF6F0);
  }

  .lm-hero__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(170deg, var(--espresso, #1E1109) 0%, #170d06 60%, #0d0704 100%);
    z-index: 0;
  }

  .lm-hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 45%, rgba(201, 160, 80, 0.09) 0%, transparent 70%),
      radial-gradient(ellipse 40% 60% at 75% 60%, rgba(74, 20, 40, 0.25) 0%, transparent 60%);
    z-index: 1;
    pointer-events: none;
  }

  .lm-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .lm-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(30, 17, 9, 0.45) 0%, rgba(30, 17, 9, 0.2) 40%, rgba(30, 17, 9, 0.65) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .lm-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 4rem 2rem;
    max-width: 820px;
  }

  .lm-hero__eyebrow {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold, #C9A050);
    margin-bottom: 2rem;
  }

  .lm-hero__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.8rem, 7vw, 5.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
    color: var(--cream, #FAF6F0);
  }

  .lm-hero__description {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.75;
    color: rgba(250, 246, 240, 0.75);
    max-width: 560px;
    margin: 0 auto 2.5rem;
  }

  .lm-hero__buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .lm-hero__buttons .btn--outline-light {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 36px;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid rgba(250, 246, 240, 0.35);
    border-radius: var(--radius-sm, 4px);
    color: var(--cream, #FAF6F0);
    background: transparent;
    transition: all 0.3s ease;
  }

  .lm-hero__buttons .btn--outline-light:hover {
    background: rgba(250, 246, 240, 0.08);
    border-color: rgba(250, 246, 240, 0.6);
  }

  .lm-hero__scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: rgba(250, 246, 240, 0.4);
    animation: lmHeroBounce 2s ease-in-out infinite 1.5s;
  }

  /* Editorial layout: dark ground, photo right, copy left. */
  .lm-hero--editorial {
    justify-content: flex-start;
    align-items: stretch;
    min-height: 0;
    min-height: min(640px, calc(100svh - var(--header-height, 84px) - 44px));
    background: var(--espresso, #1E1109);
  }
  .lm-hero__editorial-media {
    position: absolute;
    inset: 0 0 0 38%;
    z-index: 0;
  }
  .lm-hero__editorial-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .lm-hero__editorial-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--espresso, #1E1109) 0%, rgba(30, 17, 9, 0.85) 18%, rgba(30, 17, 9, 0.25) 48%, rgba(30, 17, 9, 0) 70%),
      linear-gradient(0deg, rgba(30, 17, 9, 0.55), rgba(30, 17, 9, 0) 35%);
  }
  .lm-hero--editorial .lm-hero__content {
    text-align: left;
    align-self: center;
    max-width: 640px;
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.25rem, 5vw, 4.5rem);
  }
  .lm-hero--editorial .lm-hero__eyebrow {
    margin-bottom: 1.25rem;
  }
  .lm-hero--editorial .lm-hero__title {
    font-weight: 300;
    font-size: clamp(2.9rem, 6.4vw, 5.75rem);
    line-height: 0.98;
  }
  .lm-hero--editorial .lm-hero__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--gold-light, #E2C27A);
  }
  .lm-hero--editorial .lm-hero__description {
    margin: 0 0 2rem;
    max-width: 440px;
  }
  .lm-hero--editorial .lm-hero__buttons {
    justify-content: flex-start;
  }
  .lm-hero__caption {
    position: absolute;
    right: clamp(1rem, 4vw, 3.5rem);
    bottom: 1.75rem;
    z-index: 2;
    margin: 0;
    text-align: right;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(250, 246, 240, 0.7);
  }
  .lm-hero__caption span {
    display: block;
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 1.25rem;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    color: var(--cream, #FAF6F0);
  }

  /* Split layout: copy on cream beside the photo. */
  .lm-hero--split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: stretch;
    min-height: 0;
    background: var(--cream, #FAF6F0);
    color: var(--text-dark, #2C1810);
  }
  .lm-hero--split .lm-hero__content {
    text-align: left;
    max-width: 640px;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 5vw, 4.5rem);
    align-self: center;
  }
  .lm-hero--split .lm-hero__eyebrow {
    color: var(--gold-deep, #A8813A);
    margin-bottom: 1.25rem;
  }
  .lm-hero--split .lm-hero__title {
    color: var(--espresso, #1E1109);
    font-size: clamp(2.6rem, 5.4vw, 4.75rem);
  }
  .lm-hero--split .lm-hero__description {
    color: var(--text-dark, #2C1810);
    margin: 0 0 2rem;
  }
  .lm-hero--split .lm-hero__buttons {
    justify-content: flex-start;
    align-items: center;
  }
  .lm-hero__link {
    color: var(--espresso, #1E1109);
    border-bottom: 1px solid var(--gold, #C9A050);
    border-radius: 0;
    padding: 0.35rem 0 !important;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .lm-hero__note {
    margin: 1.25rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-muted, #8A8070);
  }
  .lm-hero__media {
    position: relative;
    min-height: 420px;
  }
  .lm-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }
  @keyframes lmHeroBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }

  @media (max-width: 768px) {
    .lm-hero {
      min-height: calc(100svh - var(--header-height, 64px) - 40px);
    }
    .lm-hero--split {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .lm-hero--editorial {
      flex-direction: column;
      min-height: 0;
    }
    .lm-hero__editorial-media {
      position: relative;
      inset: auto;
      aspect-ratio: 4 / 4.6;
    }
    .lm-hero__editorial-media::after {
      background: linear-gradient(0deg, var(--espresso, #1E1109) 0%, rgba(30, 17, 9, 0.2) 40%, rgba(30, 17, 9, 0) 70%);
    }
    .lm-hero--editorial .lm-hero__content {
      margin-top: -7rem;
      padding: 0 1.25rem 2.75rem;
    }
    .lm-hero--editorial .lm-hero__buttons .btn {
      flex: 1 1 100%;
    }
    .lm-hero__caption {
      display: none;
    }
    .lm-hero--split .lm-hero__media {
      order: -1;
      min-height: 0;
      aspect-ratio: 4 / 4.4;
    }
    .lm-hero--split .lm-hero__content {
      padding: 1.75rem 1.25rem 2.5rem;
    }
    .lm-hero--split .lm-hero__buttons .btn--gold {
      flex: 1 1 100%;
    }
    .lm-hero__content {
      padding: 3rem 1.25rem;
    }
    .lm-hero__title {
      font-size: clamp(2.2rem, 10vw, 3.5rem);
    }
    .lm-hero__description {
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }
    .lm-hero__buttons .btn--lg,
    .lm-hero__buttons .btn--outline-light {
      padding: 12px 28px;
      font-size: 0.72rem;
    }
    .lm-hero__scroll {
      bottom: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "overlay", "label": "Text over image" },
        { "value": "split", "label": "Text beside image" },
        { "value": "editorial", "label": "Dark, photo on the right" }
      ],
      "default": "overlay"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Theme image file (split layout)",
      "info": "Used when no image is picked, e.g. fine-jewelry-model-earrings.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading ending in italic gold",
      "info": "Shown after the heading, e.g. \"chosen by you.\""
    },
    {
      "type": "text",
      "id": "caption_title",
      "label": "Photo caption (editorial layout)"
    },
    {
      "type": "text",
      "id": "caption_text",
      "label": "Photo caption detail"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print under the buttons"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Laura Milman · New York"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Designed in New York.\nCrafted in Italy."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "Natural diamonds, rare gemstones and authenticated maison estate pieces — fine jewelry made to be worn for generations."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary button text",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary button text",
      "default": "Explore Our World"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Campaign image",
      "info": "Use finished campaign photography — never product screenshots."
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Campaign image strength",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
