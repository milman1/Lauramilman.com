{{ 'lmny-home.css' | asset_url | stylesheet_tag }}
<section class="lmh lmh-entry" aria-labelledby="LmhEntry-{{ section.id }}">
  <div class="lmh-entry__head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="lmh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="lmh-h2" id="LmhEntry-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    </div>
    {%- if section.settings.link_text != blank -%}<a class="lmh-arrow" href="{{ section.settings.link_url }}">{{ section.settings.link_text | escape }} {% render 'lmh-arrow' %}</a>{%- endif -%}
  </div>
  <ul class="lmh-entry__grid" role="list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <a href="{{ block.settings.url }}">
          <span class="lmh-eyebrow">{{ block.settings.label | escape }}</span>
          <h3 class="lmh-h3">{{ block.settings.title | escape }}</h3>
          <span class="lmh-entry__cta">{{ block.settings.link_text | escape }} <span aria-hidden="true">→</span></span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
  {%- if section.settings.natural_text != blank -%}
    <a class="lmh-entry__natural" href="{{ section.settings.natural_url }}">{{ section.settings.natural_text | escape }} {% render 'lmh-arrow' %}</a>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "LM compact diamond entry",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "text", "id": "link_text", "label": "Heading link" },
    { "type": "url", "id": "link_url", "label": "Heading link URL" },
    { "type": "text", "id": "natural_text", "label": "Natural diamonds link" },
    { "type": "url", "id": "natural_url", "label": "Natural diamonds URL" }
  ],
  "blocks": [{
    "type": "shape",
    "name": "Diamond entry",
    "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "link_text", "label": "Link text" },
      { "type": "url", "id": "url", "label": "Link" }
    ]
  }],
  "max_blocks": 4,
  "presets": [{ "name": "LM compact diamond entry" }]
}
{% endschema %}
