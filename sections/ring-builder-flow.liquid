{{ 'ring-builder-flow.css' | asset_url | stylesheet_tag }}
{{ 'diamond-filter.css' | asset_url | stylesheet_tag }}
{%- assign settings_collection = section.settings.settings_collection -%}
{%- assign first_setting = settings_collection.products.first -%}
{%- assign first_diamond = section.settings.diamond_product -%}
<div id="lmny-ring-builder">
  <div class="intro">
    <h1>{{ 'ring_flow.title' | t }}</h1>
    <p class="quiet">{{ 'ring_flow.intro' | t }}</p>
    <nav aria-label="{{ 'ring_flow.title' | t | escape }}">
      <span data-stage="1" class="active">1 · {{ 'ring_flow.choose' | t }}</span>
      <span data-stage="2">2 · {{ 'ring_flow.pair' | t }}</span>
      <span data-stage="3">3 · {{ 'ring_flow.personalize' | t }}</span>
    </nav>
  </div>
  <div class="status" data-flow-status role="status"></div>
  <div class="layout solo">
    <div class="flow-body" data-flow-main>
      <h2>{{ 'ring_flow.where' | t }}</h2>
      <div class="paths">
        <button type="button" class="path" data-action="start-diamond">
          {% if first_diamond.featured_image %}{{ first_diamond.featured_image | image_url: width: 800 | image_tag: width: 800, height: 800, loading: 'eager', fetchpriority: 'high' }}{% endif %}
          <div><h2>{{ 'ring_flow.start_diamond' | t }}</h2><p class="quiet">{{ 'ring_flow.diamond_intro' | t }}</p><span class="eyebrow">{{ 'ring_flow.choose_diamond' | t }} →</span></div>
        </button>
        <button type="button" class="path" data-action="start-setting">
          {% if first_setting.featured_image %}{{ first_setting.featured_image | image_url: width: 800 | image_tag: width: 800, height: 800, loading: 'eager' }}{% endif %}
          <div><h2>{{ 'ring_flow.start_setting' | t }}</h2><p class="quiet">{{ 'ring_flow.setting_intro' | t }}</p><span class="eyebrow">{{ 'ring_flow.choose_setting' | t }} →</span></div>
        </button>
      </div>
      <noscript><p>{{ 'ring_flow.no_javascript' | t }} <a href="{{ section.settings.contact_url | default: '/pages/contact' }}">{{ 'ring_flow.help' | t }}</a></p></noscript>
    </div>
    <aside data-flow-summary aria-label="{{ 'ring_flow.your_ring' | t | escape }}" hidden></aside>
  </div>
  <div class="dock" data-flow-dock hidden></div>
  <footer><span>{{ 'ring_flow.saved' | t }}</span><button type="button" class="link" data-action="restart">{{ 'ring_flow.start_again' | t }}</button></footer>
  <template data-diamond-filter-template>
    <div class="diamond-search lm-dfilter lm-dfilter--navy" data-ring-builder="true">
      {% render 'diamond-origin-tabs', current: 'lab' %}
      {% capture shape_entries_raw %}{% render 'diamond-shape-order' %}{% endcapture %}
      {% assign filter_shapes = shape_entries_raw | strip | split: ';' %}
      {% assign filter_clarity = 'SI2,SI1,VS2,VS1,VVS2,VVS1,IF,FL' | split: ',' %}
      {% assign filter_color = 'M,L,K,J,I,H,G,F,E,D' | split: ',' %}
      {% assign filter_cut = 'Poor,Fair,Good,Very Good,Excellent,Ideal' | split: ',' %}
      {% render 'diamond-api-filter-form', form_url: request.path, carat_floor: 0.3, carat_ceil: 15, price_floor: 0, price_ceil: 50000, shape_order: filter_shapes, clarity_order: filter_clarity, color_order: filter_color, cut_order: filter_cut %}
    </div>
  </template>
  <script type="application/json" data-flow-config>
    {"apiBase":{{ section.settings.api_base_url | json }},"apiKey":{{ section.settings.api_anon_key | json }},"currency":{{ cart.currency.iso_code | default: shop.currency | json }},"root":{{ routes.root_url | json }},"cartUrl":{{ routes.cart_url | json }},"contact":{{ section.settings.contact_url | default: '/pages/contact' | json }},"appointment":{{ section.settings.appointment_url | default: '/pages/private-clients' | json }},"sizeGuide":{{ section.settings.size_guide_url | default: '/pages/ring-size-guide' | json }},"settings":[
      {% assign setting_emitted = false %}
      {% for ring in settings_collection.products limit: 50 %}
        {% capture ring_shape %}{% render 'center-stone-shape', product: ring %}{% endcapture %}
        {% assign ring_shape = ring_shape | strip %}
        {% if ring.available and ring.tags contains 'ring-setting' and ring_shape != blank %}
          {% if setting_emitted %},{% endif %}{% render 'ring-flow-product-data', product: ring %}
          {% assign setting_emitted = true %}
        {% endif %}
      {% endfor %}
    ],"bands":[
      {% assign band_emitted = false %}
      {% for band in collections['wedding-bands'].products limit: 50 %}
        {% if band.available and band.tags contains 'wedding-band' %}
          {% if band_emitted %},{% endif %}
          {"handle":{{ band.handle | json }},"title":{{ band.title | json }},"price":{{ band.price_min | json }},"price_varies":{{ band.price_varies | json }}}
          {% assign band_emitted = true %}
        {% endif %}
      {% endfor %}
    ],"copy":{
