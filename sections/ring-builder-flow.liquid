{% schema %}
{
  "name": "Ring builder flow",
  "tag": "section",
  "settings": [
    {"type":"collection","id":"settings_collection","label":"Ring settings collection"},
    {"type":"product","id":"diamond_product","label":"Diamond entry photograph"},
    {"type":"text","id":"api_base_url","label":"Diamond search URL"},
    {"type":"text","id":"api_anon_key","label":"Public diamond search key"},
    {"type":"url","id":"contact_url","label":"Contact page"},
    {"type":"url","id":"appointment_url","label":"Book a viewing page"},
    {"type":"url","id":"size_guide_url","label":"Ring size guide page"}
  ],
  "presets":[{"name":"Ring builder flow"}]
}
{% endschema %}
