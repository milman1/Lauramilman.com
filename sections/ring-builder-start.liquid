{%- comment -%}
  Ring builder — where to begin (homepage).
  Built on the homepage's own tile pattern (lmh-split, as in "Rings, your
  way"): a picture, a serif title under it, and gold uppercase links. No
  boxes, no labels printed over the photos.
  - Start with a diamond: three real lab-grown stones (round, oval, pear),
    read live from the stone search and shown small and uncropped on a navy
    panel, each linking to its own page. Until they load, or if the search
    is unreachable, each is a gold shape icon linking to that shape's search,
    so the panel never shows a stand-in picture.
  - Start with a setting: one real setting photo (the first available
    setting of the chosen shape) and "See all N settings".
  Settings come from the ring-settings collection; the shape comes from
  snippets/center-stone-shape.liquid, never the title.
  Heading level h2 on the homepage (the banner holds the page's h1).
{%- endcomment -%}
{{ 'lmny-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign setting_collection = collections[section.settings.settings_collection]
  assign heading_tag = 'h1'
  assign path_tag = 'h2'
  if section.settings.heading_level == 'h2'
    assign heading_tag = 'h2'
    assign path_tag = 'h3'
  endif
  assign more_url = section.settings.more_url | default: '/pages/ring-builder?start=setting'
  assign photo_shape = section.settings.ring_photo_shape | default: 'Round' | strip | downcase
  assign total = 0
  assign photo_ring = nil
  assign photo_ring_shape = ''
  assign first_ring = nil
  assign first_ring_shape = ''
  assign stone_shapes = 'Round,Oval,Pear' | split: ','
-%}
{%- if setting_collection != blank -%}
  {%- for ring in setting_collection.products limit: 50 -%}
    {%- unless ring.available and ring.tags contains 'ring-setting' -%}{%- continue -%}{%- endunless -%}
    {%- capture ring_shape -%}{% render 'center-stone-shape', product: ring %}{%- endcapture -%}
    {%- assign ring_shape = ring_shape | strip -%}
    {%- if ring_shape == blank -%}{%- continue -%}{%- endif -%}
    {%- assign total = total | plus: 1 -%}
    {%- if ring.featured_image == blank -%}{%- continue -%}{%- endif -%}
    {%- if first_ring == nil -%}
      {%- assign first_ring = ring -%}
      {%- assign first_ring_shape = ring_shape -%}
    {%- endif -%}
    {%- assign ring_shape_key = ring_shape | downcase -%}
    {%- if photo_ring == nil and ring_shape_key == photo_shape -%}
      {%- assign photo_ring = ring -%}
      {%- assign photo_ring_shape = ring_shape -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if photo_ring == nil -%}
  {%- assign photo_ring = first_ring -%}
  {%- assign photo_ring_shape = first_ring_shape -%}
{%- endif -%}

<section class="lmh lmh-split rbs" id="Rbs-{{ section.id }}" aria-labelledby="RbsTitle-{{ section.id }}">
  {%- if section.settings.eyebrow != blank -%}<p class="lmh-eyebrow rbs__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  <{{ heading_tag }} class="lmh-h2 lmh-split__title" id="RbsTitle-{{ section.id }}">{{ section.settings.title | escape }}</{{ heading_tag }}>
  {%- if section.settings.description != blank -%}<p class="lmh-lede rbs__desc">{{ section.settings.description | escape }}</p>{%- endif -%}

  <div class="lmh-split__grid rbs__grid{% unless section.settings.show_diamond_path %} rbs__grid--solo{% endunless %}">
    {%- if section.settings.show_diamond_path -%}
    <div class="lmh-split__tile">
      <div class="lmh-split__media rbs__case" data-rbs-stones data-api="{{ section.settings.api_base_url | escape }}" data-key="{{ section.settings.api_anon_key | escape }}">
        {%- for stone_shape in stone_shapes -%}
          {%- assign stone_icon = stone_shape | downcase -%}
          <a class="rbs__stone" data-shape="{{ stone_shape }}" href="{{ routes.collections_url }}/lab-grown-diamonds?shape={{ stone_shape | url_encode }}" aria-label="{{ stone_shape }} lab-grown diamonds">
            <span class="rbs__frame">{%- render 'diamond-shape-icon', shape: stone_icon -%}</span>
            <span class="rbs__name">{{ stone_shape }}</span>
          </a>
        {%- endfor -%}
      </div>
      <{{ path_tag }} class="lmh-split__label">Start with a diamond</{{ path_tag }}>
      <p class="rbs__links">
        <a class="lmh-split__link" href="{{ routes.collections_url }}/lab-grown-diamonds">Lab-grown {% render 'lmh-arrow' %}</a>
        <a class="lmh-split__link" href="{{ routes.collections_url }}/natural-diamonds">Natural {% render 'lmh-arrow' %}</a>
        {%- if section.settings.shapes_anchor != blank -%}
          <a class="lmh-split__link" href="{{ section.settings.shapes_anchor | escape }}">By shape {% render 'lmh-arrow' %}</a>
        {%- endif -%}
      </p>
    </div>
    {%- endif -%}
    <div class="lmh-split__tile">
      {%- if photo_ring != nil -%}
        <a class="lmh-split__media" href="/pages/ring-builder?setting={{ photo_ring.handle | url_encode }}&amp;shape={{ photo_ring_shape | url_encode }}">
          <img
            src="{{ photo_ring.featured_image | image_url: width: 900 }}"
            srcset="{{ photo_ring.featured_image | image_url: width: 600 }} 600w, {{ photo_ring.featured_image | image_url: width: 900 }} 900w, {{ photo_ring.featured_image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 45vw, 100vw"
            alt="{{ photo_ring.featured_image.alt | default: photo_ring.title | escape }}"
            width="900"
            height="900"
            loading="lazy"
          >
        </a>
      {%- endif -%}
      <{{ path_tag }} class="lmh-split__label">Start with a setting</{{ path_tag }}>
      {%- if total > 0 -%}
        <p class="rbs__links"><a class="lmh-split__link" href="{{ more_url | escape }}">See all {{ total }} setting{% if total != 1 %}s{% endif %} {% render 'lmh-arrow' %}</a></p>
      {%- else -%}
        <p class="rbs__links"><a class="lmh-split__link" href="{{ section.settings.contact_url | default: '/pages/contact' }}">Ask about a custom setting {% render 'lmh-arrow' %}</a></p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .rbs .rbs__eyebrow { text-align: center; margin: 0 0 10px; }
  .rbs .rbs__desc { text-align: center; max-width: 560px; margin: -18px auto 32px; }
  .rbs .lmh-split__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rbs .rbs__grid--solo { grid-template-columns: minmax(0, 1fr); max-width: 560px; margin: 0 auto; }
  .rbs .lmh-split__label { margin: 0; font-weight: 400; }
  .rbs .rbs__links { display: flex; flex-wrap: wrap; gap: 10px 24px; margin: 0; }
  /* lmny-home.css is linked again by later homepage sections, so every rule
     here is scoped under .rbs to outrank its .lmh-split__media defaults. */
  .rbs .rbs__case { display: flex; align-items: center; justify-content: center; gap: 4%; padding: 0 7%; background: var(--lmh-navy); }
  .rbs .rbs__stone { flex: 0 0 27%; display: flex; flex-direction: column; align-items: center; gap: 12px; color: var(--lmh-gold); text-decoration: none; }
  .rbs .rbs__frame { width: 100%; aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .rbs .rbs__frame svg { width: 58%; height: auto; }
  .rbs .rbs__case .rbs__frame img { width: 100%; height: 100%; object-fit: cover; display: block; transform: none; }
  .rbs .rbs__name { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--lmh-gold-light); }
  .rbs .rbs__stone:focus-visible { outline: 2px solid var(--lmh-gold-light); outline-offset: 3px; }
  @media (max-width: 749px) {
    .rbs .lmh-split__grid { grid-template-columns: minmax(0, 1fr); }
    .rbs .rbs__desc { margin: -12px auto 24px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('Rbs-{{ section.id }}');
    var panel = root && root.querySelector('[data-rbs-stones]');
    if (!panel || !window.fetch) return;
    var api = (panel.getAttribute('data-api') || '').replace(/\/+$/, '');
    var key = panel.getAttribute('data-key') || '';
    if (!api) return;

    // One real stone per shape: lab-grown, 1.5 to 2.2 carats, white and clean,
    // cheapest first, so the picture is a stone a shopper could buy today.
    function esc(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function fetchShape(shape) {
      var q = 'kind=lab&shapes=' + encodeURIComponent(shape) + '&min_carat=1.5&max_carat=2.2' +
        '&colors=D,E,F,G&clarities=VVS1,VVS2,VS1,VS2&sort=price_asc&per_page=12';
      return fetch(api + '?' + q, { headers: { Accept: 'application/json', apikey: key, Authorization: 'Bearer ' + key } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          var list = (d && d.stones) || [];
          for (var i = 0; i < list.length; i++) if (list[i].image_urls && /^https:/.test(list[i].image_urls[0] || '')) return list[i];
          return null;
        })
        .catch(function () { return null; });
    }
    function paint(cell, s) {
      if (!s) return;
      var handle = 'lg-' + String(s.stock_ref || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      var label = Number(s.carat).toFixed(2) + ' ct ' + s.shape + ' lab-grown diamond';
      cell.setAttribute('href', '/products/' + handle);
      cell.setAttribute('aria-label', label);
      cell.querySelector('.rbs__frame').innerHTML = '<img src="' + esc(s.image_urls[0]) + '" alt="" width="400" height="300" loading="lazy">';
    }
    function cached() {
      try {
        var c = JSON.parse(sessionStorage.getItem('rbs-stones-3') || 'null');
        if (c && Date.now() - c.t < 10 * 60 * 1000) return Promise.resolve(c.stones);
      } catch (e) {}
      return null;
    }

    var cells = Array.prototype.slice.call(panel.querySelectorAll('[data-shape]'));
    var pending = cached();
    if (!pending) {
      pending = Promise.all(cells.map(function (c) { return fetchShape(c.getAttribute('data-shape')); })).then(function (stones) {
        try { sessionStorage.setItem('rbs-stones-3', JSON.stringify({ t: Date.now(), stones: stones })); } catch (e) {}
        return stones;
      });
    }
    pending.then(function (stones) { cells.forEach(function (c, i) { paint(c, stones[i]); }); });
  })();
</script>

{% schema %}
{
  "name": "Ring builder start",
  "tag": "section",
  "class": "section-ring-builder-start",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ring Builder"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Where would you like to begin?"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "H1 on the ring builder page; H2 on the homepage, where the banner holds the page title.",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "more_url",
      "label": "\"See all settings\" link",
      "info": "Opens the builder's setting list. Defaults to /pages/ring-builder?start=setting."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Shop a certified diamond on its own, or build a ring from a setting and a stone. We only show pairs that fit."
    },
    {
      "type": "text",
      "id": "settings_collection",
      "label": "Settings collection handle",
      "default": "ring-settings"
    },
    {
      "type": "text",
      "id": "ring_photo_shape",
      "label": "Setting photo shape",
      "info": "The setting photo shows the first available setting of this shape, such as Round.",
      "default": "Round"
    },
    {
      "type": "text",
      "id": "builder_view",
      "label": "Setting page template name",
      "info": "Setting cards open this product template, such as ring-builder.",
      "default": "ring-builder"
    },
    {
      "type": "checkbox",
      "id": "show_diamond_path",
      "label": "Show \"Shop a diamond\"",
      "info": "Shop a diamond sits beside Build a ring, so the first choice is explicit.",
      "default": true
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "Stone search address",
      "info": "The three stone photos are read live from here. Blank shows shape icons."
    },
    {
      "type": "text",
      "id": "api_anon_key",
      "label": "Stone search key"
    },
    {
      "type": "text",
      "id": "shapes_anchor",
      "label": "Browse by shape link",
      "info": "Where \"Or browse by shape\" jumps to, such as #start-with-the-stone. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "contact_url",
      "label": "Custom setting link",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "Ring builder start"
    }
  ]
}
{% endschema %}
