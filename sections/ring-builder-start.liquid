{%- comment -%}
  Ring builder — where to begin (homepage).
  Two photo tiles and almost no words: "Shop a diamond" (a 2 x 2 grid of real
  stones read live from the stone search, with Lab-grown, Natural and By shape
  buttons) and "Build a ring" (a 2 x 2 grid of real setting photos, each
  labelled only with its shape, and "See all N"). Until the stones load, each
  stone cell is a shape icon that links to that shape's search, so the tile is
  never empty and never shows a stand-in picture.
  The grid shows one setting per shape from the ring-settings collection; the
  shape comes from snippets/center-stone-shape.liquid, never the title. Shapes
  are picked in the loose-diamond section and in the builder, not repeated here.
  Heading level h2 on the homepage (the banner holds the page's h1).
{%- endcomment -%}

{%- liquid
  assign setting_collection = collections[section.settings.settings_collection]
  assign heading_tag = 'h1'
  assign path_tag = 'h2'
  if section.settings.heading_level == 'h2'
    assign heading_tag = 'h2'
    assign path_tag = 'h3'
  endif
  assign card_limit = section.settings.card_limit | default: 4
  assign more_url = section.settings.more_url | default: '/pages/ring-builder?start=setting'
  assign shown = 0
  assign total = 0
  assign seen = '|'
-%}

{%- capture setting_cards -%}
  {%- if setting_collection != blank -%}
    {%- for ring in setting_collection.products limit: 50 -%}
      {%- unless ring.available and ring.tags contains 'ring-setting' -%}{%- continue -%}{%- endunless -%}
      {%- capture ring_shape -%}{% render 'center-stone-shape', product: ring %}{%- endcapture -%}
      {%- assign ring_shape = ring_shape | strip -%}
      {%- if ring_shape == blank -%}{%- continue -%}{%- endif -%}
      {%- assign total = total | plus: 1 -%}
      {%- assign seen_key = '|' | append: ring_shape | append: '|' -%}
      {%- if shown >= card_limit or seen contains seen_key -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      {%- assign seen = seen | append: ring_shape | append: '|' -%}
      <li class="rbs__card">
        <a class="rbs__card-link" href="/pages/ring-builder?setting={{ ring.handle | url_encode }}&amp;shape={{ ring_shape | url_encode }}">
          {%- if ring.featured_image -%}
            <img
              src="{{ ring.featured_image | image_url: width: 600 }}"
              srcset="{{ ring.featured_image | image_url: width: 300 }} 300w, {{ ring.featured_image | image_url: width: 600 }} 600w"
              sizes="(min-width: 900px) 270px, 50vw"
              alt="{{ ring.featured_image.alt | default: ring.title | escape }}"
              width="600"
              height="600"
              loading="lazy"
            >
          {%- endif -%}
          <span class="rbs__shape">{{ ring_shape }}</span>
        </a>
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<section class="rbs rbs--visual{% if heading_tag == 'h2' %} rbs--embedded{% endif %}" id="Rbs-{{ section.id }}" aria-labelledby="RbsTitle-{{ section.id }}">
  <div class="rbs__container">
    <header class="rbs__header">
      {%- if section.settings.eyebrow != blank -%}<p class="rbs__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <{{ heading_tag }} class="rbs__title" id="RbsTitle-{{ section.id }}">{{ section.settings.title }}</{{ heading_tag }}>
      {%- if section.settings.description != blank -%}<p class="rbs__desc">{{ section.settings.description }}</p>{%- endif -%}
    </header>

    <div class="rbs__paths">
      {%- if section.settings.show_diamond_path -%}
      <article class="rbs__path">
        <ul class="rbs__grid rbs__grid--stones" role="list" data-rbs-stones data-api="{{ section.settings.api_base_url | escape }}" data-key="{{ section.settings.api_anon_key | escape }}">
          {%- assign stone_shapes = 'Round,Oval,Pear,Emerald' | split: ',' -%}
          {%- for stone_shape in stone_shapes -%}
            {%- assign stone_icon = stone_shape | downcase -%}
            <li class="rbs__card rbs__card--shape" data-shape="{{ stone_shape }}">
              <a class="rbs__card-link" href="{{ routes.collections_url }}/lab-grown-diamonds?shape={{ stone_shape | url_encode }}">
                {%- render 'diamond-shape-icon', shape: stone_icon -%}
                <span class="rbs__shape">{{ stone_shape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="rbs__foot">
          <{{ path_tag }} class="rbs__path-title">Shop a diamond</{{ path_tag }}>
          <div class="rbs__pills">
            <a class="rbs__pill" href="{{ routes.collections_url }}/lab-grown-diamonds">Lab-grown</a>
            <a class="rbs__pill" href="{{ routes.collections_url }}/natural-diamonds">Natural</a>
            {%- if section.settings.shapes_anchor != blank -%}
              <a class="rbs__pill rbs__pill--ghost" href="{{ section.settings.shapes_anchor | escape }}">By shape &darr;</a>
            {%- endif -%}
          </div>
        </div>
      </article>
      {%- endif -%}
      <article class="rbs__path">
        {%- if shown > 0 -%}
          <ul class="rbs__grid" role="list">{{ setting_cards }}</ul>
        {%- else -%}
          <p class="rbs__empty">No ready-made settings are listed right now. <a href="{{ section.settings.contact_url | default: '/pages/contact' }}">Ask us about a custom setting</a>.</p>
        {%- endif -%}
        <div class="rbs__foot">
          <{{ path_tag }} class="rbs__path-title">Build a ring</{{ path_tag }}>
          <div class="rbs__pills">
            <a class="rbs__pill rbs__pill--solid" href="{{ more_url | escape }}">See all {{ total }} &rarr;</a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .rbs { background: var(--warm-white, #FDFAF6); padding: 2.5rem 1.25rem 4rem; color: var(--text-dark, #2C1810); font-family: var(--font-body, 'Montserrat', sans-serif); }
  .rbs--embedded { padding-top: clamp(40px, 5vw, 72px); padding-bottom: clamp(40px, 5vw, 72px); }
  .rbs__container { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.75rem; }
  .rbs__header { text-align: center; max-width: 640px; margin: 0 auto; }
  .rbs__eyebrow { margin: 0; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-dark, #A88340); }
  .rbs__title { margin: 0.4rem 0 0; font-family: var(--font-heading, 'Cormorant Garamond', serif); font-size: clamp(2.2rem, 4.5vw, 3.2rem); font-weight: 400; line-height: 1.1; }
  .rbs__desc { margin: 0.8rem 0 0; font-size: 0.95rem; font-weight: 300; line-height: 1.75; color: var(--text-muted-dark, #6B6152); }
  .rbs__paths { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
  .rbs__path { display: flex; flex-direction: column; background: var(--cream, #FAF6F0); border: 1px solid var(--rule-light, #DDD5C5); border-radius: var(--radius-lg, 12px); overflow: hidden; }
  .rbs__grid { display: block; aspect-ratio: 1; background: #1A1410; }
  .rbs__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 2px; }
  .rbs__card, .rbs__card-link { display: block; position: relative; min-width: 0; min-height: 0; height: 100%; }
  .rbs__card-link img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .rbs__card-link:hover img, .rbs__card-link:focus-visible img { transform: scale(1.04); }
  .rbs__card { overflow: hidden; }
  .rbs__grid--stones { background: var(--lmh-navy, #1A1F3A); }
  .rbs__card--shape { background: var(--lmh-navy-tile, #242A4B); }
  .rbs__card--shape .rbs__card-link { display: flex; align-items: center; justify-content: center; color: var(--gold, #C9A050); }
  .rbs__card--shape svg { width: 38%; height: auto; }
  .rbs__card--shape.is-photo { background: #fff; }
  .rbs__shape { position: absolute; left: 10px; bottom: 10px; padding: 4px 10px; border-radius: 999px; background: rgba(20, 14, 10, 0.62); color: #fff; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  .rbs__foot { flex: 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1rem; padding: 1.1rem 1.25rem 1.25rem; }
  .rbs__path-title { margin: 0; font-family: var(--font-heading, 'Cormorant Garamond', serif); font-size: 1.7rem; font-weight: 500; line-height: 1.1; }
  .rbs__pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .rbs__pill { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.1rem; border: 1px solid var(--text-dark, #2C1810); border-radius: 999px; background: transparent; color: var(--text-dark, #2C1810); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
  .rbs__pill:hover, .rbs__pill:focus-visible { background: var(--text-dark, #2C1810); color: #fff; }
  .rbs__pill--solid { background: var(--text-dark, #2C1810); color: #fff; }
  .rbs__pill--solid:hover, .rbs__pill--solid:focus-visible { background: var(--gold-dark, #A88340); border-color: var(--gold-dark, #A88340); }
  .rbs__pill--ghost { border-color: var(--rule-light, #DDD5C5); }
  .rbs__empty { margin: 0; padding: 1.5rem 1.25rem 0; font-size: 0.85rem; line-height: 1.7; color: var(--text-muted-dark, #6B6152); }
  .rbs__empty a { color: var(--text-dark, #2C1810); }
  @media (min-width: 900px) {
    .rbs__paths { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
    .rbs__path:only-child { grid-column: 1 / -1; max-width: 540px; margin: 0 auto; width: 100%; }
  }
  @media (max-width: 480px) {
    .rbs__pills { gap: 0.4rem; }
    .rbs__pill { padding: 0 0.8rem; font-size: 0.66rem; letter-spacing: 0.08em; }
  }
  @media (prefers-reduced-motion: reduce) { .rbs__card-link img { transition: none; } }
</style>


<script>
  (function () {
    var root = document.getElementById('Rbs-{{ section.id }}');
    var grid = root && root.querySelector('[data-rbs-stones]');
    if (!grid || !window.fetch) return;
    var api = (grid.getAttribute('data-api') || '').replace(/\/+$/, '');
    var key = grid.getAttribute('data-key') || '';
    if (!api) return;

    // One real stone per shape: lab-grown, 1.5 to 2.2 carats, white and clean,
    // cheapest first, so the picture is a stone a shopper could buy today.
    function esc(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function fetchShape(shape) {
      var q = 'kind=lab&shapes=' + encodeURIComponent(shape) + '&min_carat=1.5&max_carat=2.2' +
        '&colors=D,E,F,G&clarities=VVS1,VVS2,VS1,VS2&sort=price_asc&per_page=12';
      return fetch(api + '?' + q, { headers: { Accept: 'application/json', apikey: key, Authorization: 'Bearer ' + key } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          var list = (d && d.stones) || [];
          for (var i = 0; i < list.length; i++) if (list[i].image_urls && /^https:/.test(list[i].image_urls[0] || '')) return list[i];
          return null;
        })
        .catch(function () { return null; });
    }
    function paint(cell, s) {
      if (!s) return;
      var handle = 'lg-' + String(s.stock_ref || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      var label = s.shape + ' \u00b7 ' + Number(s.carat).toFixed(2) + ' ct';
      cell.classList.add('is-photo');
      cell.innerHTML = '<a class="rbs__card-link" href="/products/' + esc(handle) + '">' +
        '<img src="' + esc(s.image_urls[0]) + '" alt="' + esc(label + ' lab-grown diamond') + '" width="600" height="600" loading="lazy">' +
        '<span class="rbs__shape">' + esc(label) + '</span></a>';
    }
    function cached() {
      try {
        var c = JSON.parse(sessionStorage.getItem('rbs-stones') || 'null');
        if (c && Date.now() - c.t < 10 * 60 * 1000) return Promise.resolve(c.stones);
      } catch (e) {}
      return null;
    }

    var cells = Array.prototype.slice.call(grid.querySelectorAll('[data-shape]'));
    var pending = cached();
    if (!pending) {
      pending = Promise.all(cells.map(function (c) { return fetchShape(c.getAttribute('data-shape')); })).then(function (stones) {
        try { sessionStorage.setItem('rbs-stones', JSON.stringify({ t: Date.now(), stones: stones })); } catch (e) {}
        return stones;
      });
    }
    pending.then(function (stones) { cells.forEach(function (c, i) { paint(c, stones[i]); }); });
  })();
</script>

{% schema %}
{
  "name": "Ring builder start",
  "tag": "section",
  "class": "section-ring-builder-start",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ring Builder" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Where would you like to begin?" },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "H1 on the ring builder page; H2 on the homepage, where the banner holds the page title.",
      "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "card_limit",
      "label": "Settings shown",
      "info": "One setting per shape, so the choices differ. 4 fills the photo grid.",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "more_url",
      "label": "\"See all\" link",
      "info": "Opens the builder's setting list. Defaults to /pages/ring-builder?start=setting."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Shop a certified diamond on its own, or build a ring from a setting and a stone. We only show pairs that fit."
    },
    {
      "type": "text",
      "id": "settings_collection",
      "label": "Settings collection handle",
      "default": "ring-settings"
    },
    {
      "type": "text",
      "id": "builder_view",
      "label": "Setting page template name",
      "info": "Setting cards open this product template, such as ring-builder.",
      "default": "ring-builder"
    },
    {
      "type": "checkbox",
      "id": "show_diamond_path",
      "label": "Show \"Shop a diamond\"",
      "info": "Shop a diamond sits beside Build a ring, so the first choice is explicit.",
      "default": true
    },
    { "type": "text", "id": "api_base_url", "label": "Stone search address", "info": "The four stone photos are read live from here. Blank shows shape icons." },
    { "type": "text", "id": "api_anon_key", "label": "Stone search key" },
    { "type": "text", "id": "shapes_anchor", "label": "Browse by shape link", "info": "Where \"Or browse by shape\" jumps to, such as #start-with-the-stone. Leave blank to hide." },
    { "type": "text", "id": "contact_url", "label": "Custom setting link", "default": "/pages/contact" }
  ],
  "presets": [{ "name": "Ring builder start" }]
}
{% endschema %}
