{%- comment -%}
  Laura Milman New York — FAQ accordion
  Reuses the theme's .accordion-* classes; toggling is handled in theme.js.
{%- endcomment -%}

<section class="lm-faq" aria-label="Frequently asked questions">
  <div class="lm-faq__container">

    <header class="lm-faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="lm-faq__title">{{ section.settings.title | default: page.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="lm-faq__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="lm-faq__list">
      {%- for block in section.blocks -%}
        <div class="accordion-item" {% if forloop.first %}data-open{% endif %} {{ block.shopify_attributes }}>
          <button type="button" class="accordion-trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            {{ block.settings.question }}
            <span class="accordion-icon" aria-hidden="true">+</span>
          </button>
          <div class="accordion-body">
            <div class="accordion-content">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="lm-faq__footer">
        <p class="lm-faq__footer-text">{{ section.settings.footer_text }}</p>
        <a href="{{ section.settings.cta_url | default: '/pages/private-clients' }}" class="btn btn--outline">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .lm-faq {
    background: var(--warm-white, #FDFAF6);
    padding: 3rem 2rem 5rem;
  }

  .lm-faq__container {
    max-width: 760px;
    margin: 0 auto;
  }

  .lm-faq__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .lm-faq__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    color: var(--text-dark, #2C1810);
    margin: 0.5rem 0 1rem;
  }

  .lm-faq__intro {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--text-muted, #8A8070);
    max-width: 560px;
    margin: 0 auto;
  }

  .lm-faq__list {
    border-top: 1px solid var(--border-light, #E8E2D8);
  }

  .lm-faq .accordion-trigger {
    font-size: 1rem;
    font-weight: 500;
    gap: 1rem;
  }

  .lm-faq__footer {
    text-align: center;
    margin-top: 3rem;
  }

  .lm-faq__footer-text {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.9rem;
    color: var(--text-muted, #8A8070);
    margin-bottom: 1.25rem;
  }

  @media (max-width: 768px) {
    .lm-faq {
      padding: 2rem 1.25rem 3.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help & Answers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Didn't find your answer? We're happy to help in person."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Footer CTA text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Footer CTA link"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I know an estate piece is authentic?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Every pre-owned maison piece is examined and authenticated by our specialists before it is offered for sale, and ships with documentation of its provenance.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
