{%- comment -%}
  Laura Milman New York — Featured Products Section
  Product grid from a selected collection with eyebrow/title/description header
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.product_count | default: 8
  assign featured_collection = section.settings.collection
  assign view_all_url = '/collections/all'
  if featured_collection != blank
    assign view_all_url = featured_collection.url
  endif
  assign has_picked_products = false
  assign has_chips = false
  for block in section.blocks
    if block.type == 'chip' and block.settings.label != blank
      assign has_chips = true
    endif
  endfor
  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank
      assign has_picked_products = true
      break
    endif
  endfor
  # Mixed rails take a few pieces from each source collection in turn, so a
  # rail of lab-grown jewelry shows earrings, bracelets, necklaces and rings
  # rather than whichever category happens to sort first.
  assign has_sources = false
  for block in section.blocks
    if block.type == 'source' and block.settings.collection != blank
      assign has_sources = true
      break
    endif
  endfor
  assign per_source = section.settings.per_source | default: 3
  assign per_source_last = per_source | minus: 1
  assign fp_carousel = false
  if section.settings.layout == 'carousel'
    assign fp_carousel = true
  endif
  # A section tied to a collection that has nothing to show yet can hide
  # itself instead of falling back to the whole catalog.
  assign fp_hidden = false
  if section.settings.hide_when_empty and has_picked_products == false
    if featured_collection == blank or featured_collection.products.size == 0
      assign fp_hidden = true
    endif
  endif
-%}

{%- unless fp_hidden -%}
<section class="lm-featured lm-featured--{{ section.settings.tone | default: 'warm' }}{% if section.settings.header_align == 'left' %} lm-featured--left{% endif %}" aria-label="{{ section.settings.title | default: 'Featured Products' | escape }}">
  <div class="lm-featured__container">

    <div class="lm-featured__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="lm-featured__desc">{{ section.settings.description }}</p>
      {%- endif -%}
      {%- if has_chips -%}
        <nav class="lm-featured__chips" aria-label="{{ section.settings.chips_label | default: 'Popular' | escape }} in {{ section.settings.title | escape }}">
          <span class="lm-featured__chips-label">{{ section.settings.chips_label | default: 'Popular' }}</span>
          {%- for block in section.blocks -%}
            {%- if block.type == 'chip' and block.settings.label != blank -%}
              <a class="lm-featured__chip" href="{{ block.settings.link | default: view_all_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>

    <div class="products-grid{% if fp_carousel %} products-grid--carousel{% endif %}"{% if fp_carousel %} id="FeaturedRail-{{ section.id }}" tabindex="0" aria-label="{{ section.settings.title | escape }}, scroll for more"{% endif %}>
      {%- if has_picked_products -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' and block.settings.product != blank -%}
            {%- render 'product-card', product: block.settings.product -%}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif has_sources -%}
        {%- assign fp_seen = ',' -%}
        {%- for i in (0..per_source_last) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'source' and block.settings.collection != blank -%}
              {%- assign fp_product = block.settings.collection.products[i] -%}
              {%- if fp_product != blank -%}
                {%- assign fp_key = ',' | append: fp_product.id | append: ',' -%}
                {%- unless fp_seen contains fp_key -%}
                  {%- assign fp_seen = fp_seen | append: fp_product.id | append: ',' -%}
                  {%- render 'product-card', product: fp_product -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- elsif featured_collection != blank and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- elsif collections.all.products.size > 0 -%}
        {%- for product in collections.all.products limit: limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        <p class="lm-featured__empty">Add products to your store to see them here.</p>
      {%- endif -%}
    </div>

    {%- if fp_carousel -%}
      <div class="lm-featured__nav" data-fp-nav hidden>
        <button type="button" class="lm-featured__arrow" data-fp-dir="-1" aria-controls="FeaturedRail-{{ section.id }}" aria-label="Previous pieces">&larr;</button>
        <button type="button" class="lm-featured__arrow" data-fp-dir="1" aria-controls="FeaturedRail-{{ section.id }}" aria-label="Next pieces">&rarr;</button>
      </div>
      <script>
        (function () {
          var rail = document.getElementById('FeaturedRail-{{ section.id }}');
          var nav = rail && rail.parentNode.querySelector('[data-fp-nav]');
          if (!nav) return;
          var buttons = nav.querySelectorAll('[data-fp-dir]');
          function update() {
            var overflow = rail.scrollWidth - rail.clientWidth > 2;
            nav.hidden = !overflow;
            buttons[0].disabled = rail.scrollLeft <= 2;
            buttons[1].disabled = rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 2;
          }
          buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
              rail.scrollBy({ left: Number(btn.getAttribute('data-fp-dir')) * rail.clientWidth, behavior: 'smooth' });
            });
          });
          rail.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          window.addEventListener('load', update);
          requestAnimationFrame(update);
        })();
      </script>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="lm-featured__footer">
        <a href="{{ section.settings.cta_url | default: view_all_url }}" class="view-all-link">
          {{ section.settings.cta_text }} →
        </a>
      </div>
    {%- endif -%}

  </div>
</section>
{%- endunless -%}

<style>
  .lm-featured {
    background: var(--warm-white, #FDFBF7);
    padding: 5rem 0;
  }

  .lm-featured__container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .lm-featured__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .lm-featured__desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted, #8B7D6B);
    margin: 1rem 0 0;
  }

  .lm-featured .products-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  /* Carousel: four to a view on desktop, then three, then two with a peek. */
  .lm-featured .products-grid--carousel {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 6rem) / 4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    outline-offset: 4px;
  }

  .lm-featured .products-grid--carousel::-webkit-scrollbar {
    display: none;
  }

  .lm-featured .products-grid--carousel > * {
    scroll-snap-align: start;
    min-width: 0;
  }

  .lm-featured__nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .lm-featured--left .lm-featured__nav {
    justify-content: flex-start;
  }

  .lm-featured__nav[hidden] {
    display: none;
  }

  .lm-featured__arrow {
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule-light, #DDD5C5);
    background: var(--warm-white, #FDFAF6);
    color: var(--text-dark, #2C1810);
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
  }

  .lm-featured__arrow:hover:not(:disabled),
  .lm-featured__arrow:focus-visible {
    background: var(--espresso, #1E1109);
    color: var(--cream, #FAF6F0);
  }

  .lm-featured__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .lm-featured--cream {
    background: var(--off-white, #F5F0E8);
  }

  .lm-featured--left .lm-featured__header {
    text-align: left;
    max-width: none;
    margin: 0 0 2.5rem;
  }

  .lm-featured--left .lm-featured__desc {
    max-width: 560px;
  }

  .lm-featured__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .lm-featured:not(.lm-featured--left) .lm-featured__chips {
    justify-content: center;
  }

  .lm-featured__chips-label {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold, #C9A050);
    margin-right: 0.35rem;
  }

  .lm-featured__chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 1rem;
    border: 1px solid var(--rule-light, #DDD5C5);
    border-radius: 999px;
    background: var(--warm-white, #FDFAF6);
    color: var(--text-dark, #2C1810);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .lm-featured__chip:hover,
  .lm-featured__chip:focus-visible {
    background: var(--espresso, #1E1109);
    border-color: var(--espresso, #1E1109);
    color: var(--cream, #FAF6F0);
  }

  .lm-featured__empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--text-muted, #8B7D6B);
    padding: 3rem 0;
  }

  .lm-featured__footer {
    text-align: center;
    margin-top: 3rem;
  }

  @media (max-width: 1024px) {
    .lm-featured .products-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }    .lm-featured .products-grid--carousel {
      grid-template-columns: none;
      grid-auto-columns: calc((100% - 3rem) / 3);
    }
  }

  @media (max-width: 768px) {
    .lm-featured {
      padding: 3.5rem 0;
    }
    .lm-featured .products-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .lm-featured .products-grid--carousel {
      grid-template-columns: none;
      grid-auto-columns: 44%;
      margin: 0 calc(var(--container-padding, 1rem) * -1);
      padding: 0 var(--container-padding, 1rem);
      scroll-padding-inline: var(--container-padding, 1rem);
    }
    .lm-featured__nav {
      display: none;
    }
    .lm-featured__header {
      margin-bottom: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated Selection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Pieces"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        { "value": "warm", "label": "Warm white" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "warm"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "chips_label",
      "label": "Shortcut buttons label",
      "default": "Popular"
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide when the collection is empty",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "per_source",
      "label": "Pieces from each mixed collection",
      "info": "Used when the section has Mix from collection blocks",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "View All text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "View All link"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Shortcut button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "source",
      "name": "Mix from collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
