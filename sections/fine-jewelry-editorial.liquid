<section class="lm-fine-edit" aria-labelledby="fine-edit-{{ section.id }}">
  <div class="lm-fine-edit__container">
    <header class="lm-fine-edit__header">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="fine-edit-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p class="lm-fine-edit__intro">{{ section.settings.description | escape }}</p>
    </header>
    <div class="lm-fine-edit__spread">
      {%- for block in section.blocks -%}
        {%- assign piece = block.settings.product -%}
        {%- assign photograph = block.settings.image -%}
        {%- if piece != blank and piece.available and photograph != blank -%}
          <article class="lm-fine-edit__feature" {{ block.shopify_attributes }}>
            <a class="lm-fine-edit__photo" href="{{ piece.url }}" aria-label="{{ piece.title | escape }}">
              {{ photograph | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(max-width: 768px) calc(100vw - 40px), 55vw', loading: 'lazy', alt: block.settings.image_alt }}
            </a>
            <p class="eyebrow lm-fine-edit__moment">{{ block.settings.caption | escape }}</p>
            <h3><a href="{{ piece.url }}">{{ piece.title | escape }}</a></h3>
            <p class="lm-fine-edit__price">{{ piece.price | money }}</p>
            <a class="lm-fine-edit__link" href="{{ piece.url }}">Explore this piece <span aria-hidden="true">↗</span></a>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="lm-fine-edit__footer"><a class="btn btn--outline" href="/collections">Explore Fine Jewelry Collections</a></div>
  </div>
</section>

<style>
  .lm-fine-edit { padding: 5rem 0; background: var(--warm-white, #FDFAF6); }
  .lm-fine-edit__container { max-width: var(--container-max, 1280px); margin: 0 auto; padding: 0 var(--container-padding, 32px); }
  .lm-fine-edit__header { max-width: 640px; margin-bottom: 3rem; }
  .lm-fine-edit h2 { font-family: var(--font-heading, 'Cormorant Garamond', serif); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; margin: .75rem 0 1rem; }
  .lm-fine-edit__intro { line-height: 1.8; margin: 0; }
  .lm-fine-edit__spread { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .lm-fine-edit__feature:nth-child(2) { margin-top: 7rem; }
  .lm-fine-edit__photo { display: block; overflow: hidden; border-radius: var(--radius-md, 8px); }
  .lm-fine-edit__photo img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; transition: transform .3s ease; }
  .lm-fine-edit__photo:hover img { transform: scale(1.015); }
  .lm-fine-edit__moment { margin-top: 1.5rem; }
  .lm-fine-edit h3 { font-family: var(--font-heading, 'Cormorant Garamond', serif); font-size: clamp(1.4rem, 2vw, 1.9rem); font-weight: 400; line-height: 1.25; margin: .65rem 0; }
  .lm-fine-edit h3 a { color: inherit; text-decoration: none; }
  .lm-fine-edit__price { margin: .75rem 0; }
  .lm-fine-edit__link { display: inline-block; color: var(--text-dark, #2C1810); text-underline-offset: 5px; padding: .5rem 0; }
  .lm-fine-edit__footer { margin-top: 3rem; }
  @media (max-width: 768px) {
    .lm-fine-edit { padding: 3rem 0; }
    .lm-fine-edit__spread { grid-template-columns: 1fr; gap: 3rem; }
    .lm-fine-edit__feature:nth-child(2) { margin-top: 0; }
    .lm-fine-edit__header { margin-bottom: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .lm-fine-edit__photo img { transition: none; } }
</style>

{% schema %}
{
  "name": "Fine Jewelry Editorial",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Fine Jewelry Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jewelry, brought to life." },
    { "type": "textarea", "id": "description", "label": "Description" }
  ],
  "max_blocks": 2,
  "blocks": [{
    "type": "piece",
    "name": "On-body feature",
    "settings": [
      { "type": "product", "id": "product", "label": "Exact featured product" },
      { "type": "image_picker", "id": "image", "label": "Existing on-body photograph" },
      { "type": "text", "id": "image_alt", "label": "Image description" },
      { "type": "text", "id": "caption", "label": "Editorial caption" }
    ]
  }],
  "presets": [{ "name": "Fine Jewelry Editorial" }]
}
{% endschema %}
