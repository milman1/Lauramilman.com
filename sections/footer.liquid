{%- comment -%}
  Laura Milman New York - Footer Section
{%- endcomment -%}

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}">
          {%- else -%}
            <span class="footer__logo-text">Laura <em>Milman</em></span>
          {%- endif -%}
        </a>
        <p class="footer__description">{{ section.settings.description | default: 'House jewelry is designed in New York and crafted in Italy. Signed estate pieces and watches are authenticated in New York.' }}</p>
        <div class="footer__social">
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_pinterest != blank -%}
            <a href="{{ section.settings.social_pinterest }}" class="footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 12c0 3 2 6 4 6s4-6 4-6-2-6-4-6-4 3-4 6"/>
                <line x1="12" y1="12" x2="12" y2="21"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_instagram == blank and section.settings.social_facebook == blank and section.settings.social_pinterest == blank -%}
            <a href="https://instagram.com/lauramilmannewyork" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="footer__column footer__accordion">
        <h2 class="footer__column-title footer__accordion-toggle">Shop
          <svg class="footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </h2>
        <ul class="footer__links footer__accordion-body">
          <li><a href="/collections/all" class="footer__link">All Jewelry</a></li>
          <li><a href="/collections/lab-grown-diamond-jewelry" class="footer__link">Lab-Grown Jewelry</a></li>
          <li><a href="/collections/natural-diamonds" class="footer__link">Loose Diamonds</a></li>
          <li><a href="/collections/estate-jewelry" class="footer__link">Pre-Owned &amp; Estate</a></li>
          <li><a href="/collections/time-pieces" class="footer__link">Timepieces</a></li>
          <li><a href="/collections/engagement-rings" class="footer__link">Engagement Rings</a></li>
          <li><a href="/collections/necklaces" class="footer__link">Necklaces</a></li>
          <li><a href="/collections/chains" class="footer__link">Chains</a></li>
        </ul>
      </div>

      <div class="footer__column footer__accordion">
        <h2 class="footer__column-title footer__accordion-toggle">The House
          <svg class="footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </h2>
        <ul class="footer__links footer__accordion-body">
          <li><a href="/pages/about" class="footer__link">Our Story</a></li>
          <li><a href="/collections/estate-jewelry" class="footer__link">Pre-Owned &amp; Estate</a></li>
          <li><a href="/collections/david-webb" class="footer__link">David Webb</a></li>
          <li><a href="/pages/authentication" class="footer__link">Estate Authentication</a></li>
          <li><a href="/pages/private-clients" class="footer__link">Private Clients</a></li>
          <li><a href="/blogs/journal" class="footer__link">Journal</a></li>
        </ul>
      </div>

      <div class="footer__column footer__accordion">
        <h2 class="footer__column-title footer__accordion-toggle">Support
          <svg class="footer__accordion-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </h2>
        <ul class="footer__links footer__accordion-body">
          <li><a href="/pages/contact" class="footer__link">Contact Us</a></li>
          <li><a href="/pages/faq" class="footer__link">FAQ</a></li>
          <li><a href="/pages/shipping-returns" class="footer__link">Shipping & Returns</a></li>
          <li><a href="/pages/buying-guide" class="footer__link">Buying Guide</a></li>
          <li><a href="/pages/ring-size-guide" class="footer__link">Ring Size Guide</a></li>
          <li><a href="/pages/care-guide" class="footer__link">Care Guide</a></li>
          <li><a href="/pages/google-reviews" class="footer__link">Google Reviews</a></li>
        </ul>
      </div>
      {%- comment -%}
        Signup sits in the footer, as in the approved homepage preview. Same
        customer form, tags and welcome message as the newsletter section.
      {%- endcomment -%}
      <div class="footer__column footer__signup">
        <h2 class="footer__column-title">{{ section.settings.signup_title | default: '10% off your first piece' }}</h2>
        <p class="footer__signup-text">{{ section.settings.signup_text | default: 'New gold, new diamonds and private appointments in Midtown, sent to your inbox.' }}</p>
        {%- form 'customer', id: 'FooterSignup', class: 'footer__signup-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,welcome10">
          <label for="FooterSignupEmail" class="footer__signup-label">Email address</label>
          <div class="footer__signup-field">
            <input id="FooterSignupEmail" type="email" name="contact[email]" placeholder="you@example.com" required autocomplete="email">
            <button type="submit">Send My Code</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="footer__signup-msg" role="status">{{ section.settings.signup_success | default: 'Welcome. Your code is LMNYWELCOME — jewelry only.' }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="footer__signup-msg" role="alert">{{ form.errors.messages['email'] }}</p>
          {%- endif -%}
        {%- endform -%}
        <span class="footer__signup-note">Jewelry only. Watches excluded.</span>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">Designed in New York &middot; Crafted in Italy &middot; &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="footer__legal">
        <a href="/policies/privacy-policy" class="footer__legal-link">Privacy Policy</a>
        <a href="/policies/terms-of-service" class="footer__legal-link">Terms of Service</a>
        <a href="/policies/refund-policy" class="footer__legal-link">Refund Policy</a>
      </div>
      <div class="footer__payments">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer__accordion-icon {
    display: none;
  }

  @media (max-width: 992px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .footer__brand {
      grid-column: 1 / -1;
      padding-right: 0;
      text-align: center;
    }

    .footer__social {
      justify-content: center;
    }
  }

  @media (max-width: 576px) {
    .footer {
      padding: 2rem 0 1.5rem;
    }

    .footer .container {
      padding-left: 20px;
      padding-right: 20px;
    }

    .footer__grid {
      grid-template-columns: 1fr;
      gap: 0;
      text-align: left;
    }

    .footer__brand {
      margin-bottom: 1rem;
      text-align: center;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(250, 246, 240, 0.08);
    }

    .footer__social {
      justify-content: center;
    }

    .footer__accordion {
      border-bottom: 1px solid rgba(250, 246, 240, 0.08);
    }

    .footer__accordion-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      padding: 0.9rem 0;
      margin-bottom: 0;
      -webkit-tap-highlight-color: transparent;
    }

    .footer__accordion-icon {
      display: block;
      color: rgba(250, 246, 240, 0.4);
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }

    .footer__accordion.open .footer__accordion-icon {
      transform: rotate(180deg);
    }

    .footer__accordion-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s ease;
      padding: 0;
    }

    .footer__accordion.open .footer__accordion-body {
      max-height: 300px;
      padding-bottom: 0.75rem;
    }

    .footer__bottom {
      flex-direction: column;
      text-align: center;
      gap: 0.75rem;
      padding-top: 1.25rem;
    }

    .footer__legal {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.25rem;
    }
  }

</style>

<script>
  (function() {
    if (window.matchMedia('(max-width: 576px)').matches) {
      var toggles = document.querySelectorAll('.footer__accordion-toggle');
      toggles.forEach(function(toggle) {
        toggle.setAttribute('role', 'button');
        toggle.setAttribute('tabindex', '0');
        toggle.setAttribute('aria-expanded', 'false');
        function flip() {
          var col = toggle.closest('.footer__accordion');
          var wasOpen = col.classList.contains('open');
          document.querySelectorAll('.footer__accordion.open').forEach(function(c) {
            c.classList.remove('open');
          });
          toggles.forEach(function(t) { t.setAttribute('aria-expanded', 'false'); });
          if (!wasOpen) {
            col.classList.add('open');
            toggle.setAttribute('aria-expanded', 'true');
          }
        }
        toggle.addEventListener('click', flip);
        toggle.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            flip();
          }
        });
      });
    }
  })();
</script>

<style>
  @media (min-width: 993px) {
    .footer__grid { grid-template-columns: 1.3fr repeat(3, minmax(0, 1fr)) 1.4fr; gap: 40px; }
  }
  .footer__signup { display: flex; flex-direction: column; gap: 12px; }
  .footer__signup .footer__column-title { margin-bottom: 0; }
  .footer__signup-text { margin: 0; font-size: 12.5px; line-height: 1.6; color: rgba(250, 246, 240, 0.6); }
  .footer__signup-form { display: flex; flex-direction: column; gap: 8px; }
  .footer__signup-label { font-size: 11px; font-weight: 500; color: #CFC6B4; }
  .footer__signup-field { display: flex; }
  .footer__signup-field input {
    flex: 1; min-width: 0; height: 46px; padding: 0 14px;
    background: transparent; border: 1px solid rgba(250, 246, 240, 0.45); border-right: 0; border-radius: 0;
    color: #FAF6F0; font-family: inherit; font-size: 13px;
  }
  .footer__signup-field input::placeholder { color: rgba(250, 246, 240, 0.45); }
  .footer__signup-field button {
    height: 46px; padding: 0 18px; background: #C9A050; border: 0; color: #1E1109; cursor: pointer;
    font-family: inherit; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap;
  }
  .footer__signup-field button:hover { background: #E2C27A; }
  .footer__signup-msg { margin: 0; font-size: 12.5px; color: #E2C27A; }
  .footer__signup-note { font-size: 11px; color: rgba(250, 246, 240, 0.55); }
  @media (max-width: 992px) {
    .footer__signup { grid-column: 1 / -1; }
  }
  @media (max-width: 576px) {
    .footer__brand { order: -2; }
    .footer__signup { order: -1; padding: 0.5rem 0 1.25rem; border-bottom: 1px solid rgba(250, 246, 240, 0.08); }
    .footer__signup-field input { font-size: 16px; }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Brand description",
      "default": "House jewelry is designed in New York and crafted in Italy. Signed estate pieces and watches are authenticated in New York."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    { "type": "header", "content": "Signup" },
    { "type": "text", "id": "signup_title", "label": "Signup heading", "default": "10% off your first piece" },
    { "type": "textarea", "id": "signup_text", "label": "Signup text" },
    { "type": "text", "id": "signup_success", "label": "Message after signing up", "default": "Welcome. Your code is LMNYWELCOME — jewelry only." }

  ]
}
{% endschema %}
