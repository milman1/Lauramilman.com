{%- comment -%}
  Laura Milman New York — "You May Also Like"
  4-up related products, same collection first (never a junk fallback across
  the whole catalog). Renders nothing at all when there's nothing related.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.product_count | default: 4
  assign rec_collection = collection | default: product.collections.first

  capture rec_grid
    if rec_collection != blank
      assign shown = 0
      for rec in rec_collection.products
        if rec.id != product.id
          render 'product-card', product: rec
          assign shown = shown | plus: 1
        endif
        if shown >= limit
          break
        endif
      endfor
    endif
  endcapture
-%}

{%- if rec_grid contains 'product-card' -%}
<section class="product-recs" aria-label="{{ section.settings.title | escape }}">
  <div class="product-recs__inner">

    <div class="product-recs__header">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title">{{ section.settings.title | default: 'You May Also Like' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="product-recs__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="product-recs__grid">
      {{ rec_grid }}
    </div>

  </div>
</section>
{%- endif -%}

<style>
  .product-recs {
    background: var(--warm-white, #FDFAF6);
    padding: 5rem 0;
    border-top: 1px solid var(--rule-light, #DDD5C5);
  }

  .product-recs__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .product-recs__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .product-recs .section-title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    color: var(--text-dark, #2C1810);
    margin: 0.5rem 0 0;
    line-height: 1.25;
  }

  .product-recs__subtitle {
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--text-muted, #8A8070);
    margin: 0.75rem 0 0;
  }

  .product-recs__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .product-recs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .product-recs {
      padding: 3.5rem 0;
    }
    .product-recs__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "You May Also Like",
  "tag": "section",
  "class": "section-product-recs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Keep Exploring"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "You May Also Like"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore similar pieces from our collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "templates": ["product"],
  "presets": [
    {
      "name": "You May Also Like"
    }
  ]
}
{% endschema %}
