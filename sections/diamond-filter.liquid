</style>

<script>
  (function () {
    /* Facet-mode helpers only. API mode uses diamond-storefront.js. */
    if (document.getElementById('lm-diamond-api')) return;

    /* Sort has to preserve the active facets, so rebuild the query rather
       than navigating to a bare ?sort_by. */
    var sortSelect = document.getElementById('lm-diamond-sort');
    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        var params = new URLSearchParams(window.location.search);
        params.set('sort_by', sortSelect.value);
        params.delete('page');
        window.location.href = window.location.pathname + '?' + params.toString();
      });
    }

    var form = document.getElementById('DiamondFilterForm');
    if (!form) return;

    /* Grade scales set a floor: picking VS1 means "VS1 and better". The track
       fills from the chosen stop rightwards so the result is visible — the
       earlier tile grid made selecting the lowest grade look like everything
       had been ticked by mistake. */
    form.querySelectorAll('[data-scale]').forEach(function (scale) {
      var stops = Array.prototype.slice.call(scale.querySelectorAll('[data-grade]'));
      if (!stops.length) return;
      var fill = scale.querySelector('[data-scale-fill]');
      var hint = scale.parentNode.querySelector('[data-scale-hint]');
      var noun = hint ? hint.textContent : '';

      function paint() {
        var floor = -1;
        stops.forEach(function (stop, i) {
          var on = stop.querySelector('input').checked;
          stop.classList.toggle('is-in-range', on);
          stop.classList.remove('is-floor');
          if (on && floor === -1) floor = i;
        });

        if (fill) {
          if (floor === -1) {
            fill.style.left = '0%';
            fill.style.right = '100%';
          } else {
            stops[floor].classList.add('is-floor');
            /* Stops are evenly spaced, so the centre of stop i sits at
               (i + 0.5) / n across the track. */
            fill.style.left = ((floor + 0.5) / stops.length) * 100 + '%';
            fill.style.right = (100 / stops.length) * 0.5 + '%';
          }
        }

        if (hint) {
          hint.textContent = floor === -1 ? noun : stops[floor].dataset.grade + ' and better';
        }
      }

      stops.forEach(function (stop, index) {
        stop.addEventListener('click', function (event) {
          event.preventDefault();
          var isFloor = stop.classList.contains('is-floor');
          stops.forEach(function (s, i) {
            /* Clicking the current floor again clears the scale. */
            s.querySelector('input').checked = !isFloor && i >= index;
          });
          paint();
        });
      });

      paint();
    });

    /* Shape tiles are plain checkboxes; keep the active class in step. */
    form.querySelectorAll('.lm-shape input').forEach(function (input) {
      input.addEventListener('change', function () {
        input.closest('.lm-shape').classList.toggle('is-active', input.checked);
      });
    });

    /* A carat band toggles every per-weight checkbox it covers. */
    form.querySelectorAll('[data-band]').forEach(function (band) {
      band.addEventListener('click', function () {
        var on = !band.classList.contains('is-active');
        band.classList.toggle('is-active', on);
        band.querySelectorAll('input[type="checkbox"]').forEach(function (input) {
          input.checked = on;
        });
      });
    });

    /* Paint the range track from the current min/max. */
    form.querySelectorAll('[data-range]').forEach(function (range) {
      var floor = parseFloat(range.dataset.floor) || 0;
      var ceil = parseFloat(range.dataset.ceil) || 0;
      var minInput = range.querySelector('[data-range-min]');
      var maxInput = range.querySelector('[data-range-max]');
      var fill = range.querySelector('[data-range-fill]');
      if (!fill || ceil <= floor) return;

      function paint() {
        var lo = parseFloat(minInput.value);
        var hi = parseFloat(maxInput.value);
        if (isNaN(lo)) lo = floor;
        if (isNaN(hi)) hi = ceil;
        var left = Math.max(0, Math.min(100, ((lo - floor) / (ceil - floor)) * 100));
        var right = Math.max(0, Math.min(100, ((hi - floor) / (ceil - floor)) * 100));
        fill.style.left = Math.min(left, right) + '%';
        fill.style.right = (100 - Math.max(left, right)) + '%';
      }

      minInput.addEventListener('input', paint);
      maxInput.addEventListener('input', paint);
      paint();
    });

    /* An empty or full-range input would otherwise land in the URL as noise. */
    form.addEventListener('submit', function () {
      form.querySelectorAll('input[type="number"]').forEach(function (input) {
        if (input.value === '') input.disabled = true;
      });
    });
  })();
</script>

