{%- comment -%}
  Laura Milman New York — Diamond Filter

  Two data modes:
    1. api   — reads stones from the Supabase Edge Function / App Proxy
               (required for lab-grown: Shopify hides facets above 5,000 products)
    2. facets — original lab-grown-diamond-jewelry port on collection.filters

  API mode is used when `api_base_url` is set. Visual design and navy_mode
  are shared.
{%- endcomment -%}

{%- liquid
  assign navy_mode = section.settings.navy_mode
  assign api_mode = false
  if section.settings.api_base_url != blank
    assign api_mode = true
  endif
  assign search_only = false
  if api_mode and section.settings.search_only
    assign search_only = true
  endif
  assign title_tag = 'h1'
  assign preset_shape = collection.metafields.custom.preset_shape.value
  assign is_landing = false
  if api_mode and preset_shape != blank
    assign is_landing = true
  endif
  assign form_url = collection.url
  if search_only
    assign title_tag = 'h2'
    assign form_url = section.settings.search_url | default: '/collections/lab-grown-diamonds'
  endif

  assign clarity_order = 'SI2,SI1,VS2,VS1,VVS2,VVS1,IF,FL' | split: ','
  assign color_order = 'M,L,K,J,I,H,G,F,E,D' | split: ','
  assign cut_order = 'Poor,Fair,Good,Very Good,Excellent,Ideal' | split: ','
  assign shape_order = 'Round,Princess,Cushion,Emerald,Oval,Radiant,Asscher,Marquise,Heart,Pear' | split: ','
  assign stone_kind = section.settings.stone_kind | default: 'lab'
  if collection.handle == 'lab-grown-diamonds'
    assign stone_kind = 'lab'
  elsif collection.handle == 'natural-diamonds'
    assign stone_kind = 'natural'
  endif
  assign origin_is_lab = false
  if stone_kind == 'lab'
    assign origin_is_lab = true
  endif
  if section.settings.ring_builder_mode
    assign navy_mode = origin_is_lab
  endif
  assign origin_tab = 'natural'
  if origin_is_lab
    assign origin_tab = 'lab'
  endif
  assign carat_floor = 0.3
  assign carat_ceil = 15
  assign price_floor = 0
  assign price_ceil = 50000
  if stone_kind == 'natural'
    assign carat_ceil = 30
    assign price_ceil = 250000
  endif
-%}

{%- unless search_only -%}
  {%- if api_mode -%}
    {% render 'structured-data-collection', collection: collection, include_products: false %}
  {%- else -%}
    {% render 'structured-data-collection', collection: collection, include_products: true %}
  {%- endif -%}
{%- endunless -%}

{%- if api_mode -%}

<section
  class="lm-dfilter{% if navy_mode %} lm-dfilter--navy{% endif %}"
  id="lm-diamond-api"
  aria-label="{{ collection.title | escape }}"
  data-api-base="{{ section.settings.api_base_url | escape }}"
  data-anon-key="{{ section.settings.api_anon_key | escape }}"
  data-kind="{{ stone_kind | escape }}"
  data-per-page="{{ section.settings.products_per_page }}"
  data-currency="USD"
  {% if search_only %}data-search-only="true" data-search-url="{{ form_url | escape }}"{% endif %}
  {%- if section.settings.ring_builder_mode and search_only == false %} data-ring-builder="true" data-builder-view="{{ template.suffix | default: 'ring-builder' | escape }}"{% endif -%}
  {%- if preset_shape != blank %} data-preset-shape="{{ preset_shape | escape }}"{% endif -%}
  {%- if collection.metafields.custom.preset_min_carat.value != blank %} data-preset-min-carat="{{ collection.metafields.custom.preset_min_carat.value }}"{% endif -%}
  {%- if collection.metafields.custom.preset_max_carat.value != blank %} data-preset-max-carat="{{ collection.metafields.custom.preset_max_carat.value }}"{% endif %}
>
  <div class="lm-dfilter__container">
    <header class="lm-dfilter__header">
      {%- if is_landing -%}
        <{{ title_tag }} class="lm-dfilter__title">{{ collection.title | escape }}</{{ title_tag }}>
        {%- if collection.description != blank -%}
          <div class="lm-dfilter__subtitle">{{ collection.description }}</div>
        {%- endif -%}
      {%- else -%}
        <{{ title_tag }} class="lm-dfilter__title">{{ section.settings.heading | default: collection.title }}</{{ title_tag }}>
        {%- if section.settings.subheading != blank -%}
          <p class="lm-dfilter__subtitle">{{ section.settings.subheading }}</p>
        {%- elsif collection.description != blank -%}
          <div class="lm-dfilter__subtitle">{{ collection.description }}</div>
        {%- endif -%}
      {%- endif -%}
      {%- unless search_only -%}
        {%- render 'collection-guide', collection: collection -%}
      {%- endunless -%}
      {%- render 'diamond-origin-tabs', current: origin_tab -%}
    </header>

    {% render 'diamond-api-filter-form', form_url: form_url, carat_floor: carat_floor, carat_ceil: carat_ceil, price_floor: price_floor, price_ceil: price_ceil, shape_order: shape_order, clarity_order: clarity_order, color_order: color_order, cut_order: cut_order %}

  {%- unless search_only -%}
    <div class="lm-dfilter__toolbar">
      <span class="lm-dfilter__count" id="lm-diamond-count" role="status">Loading diamonds…</span>
      <div class="lm-dfilter__sort">
        <label for="lm-diamond-sort">Sort by</label>
        <select id="lm-diamond-sort">
          <option value="price_asc">Price: Low to High</option>
          <option value="price_desc">Price: High to Low</option>
          <option value="carat_asc">Carat: Low to High</option>
          <option value="carat_desc">Carat: High to Low</option>
        </select>
      </div>
    </div>

    <div id="lm-diamond-results" class="lm-dfilter__results-host" aria-live="polite">
      <p>Loading diamonds matching your selection…</p>
      <noscript><p>Enable JavaScript to use diamond search, or browse the collections below.</p></noscript>
    </div>
    <div id="lm-diamond-pager"></div>
    {%- render 'diamond-search-links' -%}
    {%- render 'diamond-reserve-form' -%}
    {%- if collection.handle == 'lab-grown-diamonds' -%}
      {%- render 'lab-landing-links' -%}
    {%- endif -%}
    {%- comment -%}
      Guide + FAQ only on the lab-grown search and its landing pages. Other
      collections that already store a guide stay hidden until approved.
    {%- endcomment -%}
    {%- if collection.handle == 'lab-grown-diamonds' or is_landing -%}
      {%- render 'collection-longform', collection: collection -%}
    {%- endif -%}
  {%- endunless -%}
  </div>
</section>

<script src="{{ 'diamond-storefront.js' | asset_url }}" defer></script>

{%- else -%}

{%- liquid
  assign shape_filter = nil
  assign carat_filter = nil
  assign color_filter = nil
  assign clarity_filter = nil
  assign cut_filter = nil
  assign price_filter = nil
  assign passthrough_filters = ''

  for filter in collection.filters
    assign p = filter.param_name
    if p contains 'custom.diamond_shape'
      assign shape_filter = filter
    elsif p contains 'custom.carat_weight'
      assign carat_filter = filter
    elsif p contains 'custom.clarity'
      assign clarity_filter = filter
    elsif p contains 'custom.color'
      assign color_filter = filter
    elsif p contains 'custom.cut'
      assign cut_filter = filter
    elsif filter.type == 'price_range'
      assign price_filter = filter
    else
      assign passthrough_filters = passthrough_filters | append: filter.param_name | append: '|'
    endif
  endfor

  assign has_any = false
  if shape_filter or carat_filter or clarity_filter or color_filter or cut_filter or price_filter
    assign has_any = true
  endif
-%}

{%- paginate collection.products by section.settings.products_per_page -%}

<section class="lm-dfilter{% if navy_mode %} lm-dfilter--navy{% endif %}" aria-label="{{ collection.title | escape }}">
  <div class="lm-dfilter__container">

    <header class="lm-dfilter__header">
      <h1 class="lm-dfilter__title">{{ section.settings.heading | default: collection.title }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="lm-dfilter__subtitle">{{ section.settings.subheading }}</p>
      {%- elsif collection.description != blank -%}
        <div class="lm-dfilter__subtitle">{{ collection.description }}</div>
      {%- endif -%}
      {%- render 'collection-guide', collection: collection -%}
      {%- render 'diamond-origin-tabs', current: origin_tab -%}
    </header>

{%- if has_any -%}

    <form class="lm-dfilter__form" id="DiamondFilterForm" action="{{ collection.url }}" method="get">
      {%- comment -%} Keep sort and any filter this panel doesn't own. {%- endcomment -%}
      {%- if collection.sort_by != blank -%}
        <input type="hidden" name="sort_by" value="{{ collection.sort_by | escape }}">
      {%- endif -%}
      {%- for filter in collection.filters -%}
        {%- if passthrough_filters contains filter.param_name -%}
          {%- for value in filter.active_values -%}
            <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="lm-dfilter__grid">

        {%- if shape_filter -%}
          <div class="lm-dfilter__group lm-dfilter__group--wide">
            <span class="lm-dfilter__label">
              Shape
              <button type="button" class="lm-dfilter__info" aria-label="About shape" data-tip="A diamond's shape sets its facet pattern and how it carries light. Round is the most brilliant; step cuts like emerald and asscher read clearer and more architectural.">i</button>
            </span>
            <div class="lm-dfilter__shapes">
              {%- comment -%} Canonical order first, then anything else the feed brought in. {%- endcomment -%}
              {%- for name in shape_order -%}
                {%- for value in shape_filter.values -%}
                  {%- if value.label == name -%}
                    {%- assign icon_key = value.label | downcase -%}
                    <label class="lm-shape{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      {%- render 'diamond-shape-icon', shape: icon_key -%}
                      <span class="lm-shape__name">{{ value.label }}</span>
                      <span class="lm-shape__count">{{ value.count }}</span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}
              {%- for value in shape_filter.values -%}
                {%- unless shape_order contains value.label -%}
                  {%- assign icon_key = value.label | downcase -%}
                  <label class="lm-shape{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                    {%- render 'diamond-shape-icon', shape: icon_key -%}
                    <span class="lm-shape__name">{{ value.label }}</span>
                    <span class="lm-shape__count">{{ value.count }}</span>
                  </label>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}


        {%- if carat_filter -%}
          <div class="lm-dfilter__group">
            <span class="lm-dfilter__label">
              Carat
              <button type="button" class="lm-dfilter__info" aria-label="About carat" data-tip="Carat is weight, not size: one carat is 200 milligrams. Two stones of equal weight can look different sizes depending on cut.">i</button>
            </span>
            {%- if carat_filter.min_value -%}
              {%- liquid
                assign carat_min = carat_filter.min_value.value | default: carat_filter.range_min
                assign carat_max = carat_filter.max_value.value | default: carat_filter.range_max
              -%}
              <div class="lm-range" data-range data-floor="{{ carat_filter.range_min | default: 0 }}" data-ceil="{{ carat_filter.range_max | default: 30 }}" data-step="0.01">
                <div class="lm-range__inputs">
                  <label class="lm-range__field">
                    <span>Min</span>
                    <input type="number" inputmode="decimal" step="0.01" min="{{ carat_filter.range_min | default: 0 }}" max="{{ carat_filter.range_max | default: 30 }}"
                           name="{{ carat_filter.min_value.param_name }}" value="{{ carat_min }}" data-range-min>
                  </label>
                  <span class="lm-range__dash" aria-hidden="true">&ndash;</span>
                  <label class="lm-range__field">
                    <span>Max</span>
                    <input type="number" inputmode="decimal" step="0.01" min="{{ carat_filter.range_min | default: 0 }}" max="{{ carat_filter.range_max | default: 30 }}"
                           name="{{ carat_filter.max_value.param_name }}" value="{{ carat_max }}" data-range-max>
                  </label>
                </div>
                <div class="lm-range__track" aria-hidden="true"><div class="lm-range__fill" data-range-fill></div></div>
              </div>
            {%- else -%}
              {%- comment -%}
                Carat published as a list rather than a range. Every distinct
                weight in the catalogue becomes its own value — 0.9, 0.91,
                0.92 … — which is hundreds of chips and useless to shop from.
                Group them into half-carat bands; each band ticks the real
                per-value checkboxes underneath it, so the submitted filter is
                still exactly what Shopify published.
              {%- endcomment -%}
              <div class="lm-bands" data-bands>
                {%- assign band_edges = '0,0.5,1,1.5,2,3,4,5,100' | split: ',' -%}
                {%- for edge in band_edges -%}
                  {%- unless forloop.last -%}
                    {%- assign lo = edge | times: 1.0 -%}
                    {%- assign hi = band_edges[forloop.index] | times: 1.0 -%}
                    {%- assign band_count = 0 -%}
                    {%- assign band_active = false -%}
                    {%- capture band_inputs -%}
                      {%- for value in carat_filter.values -%}
                        {%- assign w = value.label | times: 1.0 -%}
                        {%- if w >= lo and w < hi -%}
                          {%- assign band_count = band_count | plus: value.count -%}
                          {%- if value.active -%}{%- assign band_active = true -%}{%- endif -%}
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endcapture -%}
                    {%- if band_count > 0 -%}
                      {%- if hi >= 100 -%}
                        {%- assign band_label = lo | round: 1 | append: 'ct+' -%}
                      {%- else -%}
                        {%- assign band_label = lo | round: 1 | append: '–' | append: hi | round: 1 | append: 'ct' -%}
                      {%- endif -%}
                      <button type="button" class="lm-band{% if band_active %} is-active{% endif %}" data-band>
                        <span class="lm-band__label">{{ band_label }}</span>
                        <span class="lm-band__count">{{ band_count }}</span>
                        <span class="lm-band__inputs" hidden>{{ band_inputs }}</span>
                      </button>
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              </div>
              {%- if request.design_mode -%}
                <p class="lm-scale__hint">
                  Carat is published as a list. Switch it to a <strong>range</strong> in
                  Search &amp; Discovery for a true slider; these bands are the fallback.
                </p>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if price_filter -%}
          <div class="lm-dfilter__group">
            <span class="lm-dfilter__label">
              Price
              <button type="button" class="lm-dfilter__info" aria-label="About price" data-tip="Every stone is priced individually against the current market. Set the range you're working to.">i</button>
            </span>
            {%- liquid
              assign price_min = 0
              assign price_max = price_filter.range_max | money_without_currency | replace: ',', ''
              if price_filter.min_value.value
                assign price_min = price_filter.min_value.value | money_without_currency | replace: ',', ''
              endif
              if price_filter.max_value.value
                assign price_max = price_filter.max_value.value | money_without_currency | replace: ',', ''
              endif
              assign price_ceil = price_filter.range_max | money_without_currency | replace: ',', ''
            -%}
            <div class="lm-range" data-range data-floor="0" data-ceil="{{ price_ceil }}" data-step="1">
              <div class="lm-range__inputs">
                <label class="lm-range__field">
                  <span>Min {{ cart.currency.symbol }}</span>
                  <input type="number" inputmode="numeric" step="1" min="0" max="{{ price_ceil }}"
                         name="{{ price_filter.min_value.param_name }}" value="{{ price_min }}" data-range-min>
                </label>
                <span class="lm-range__dash" aria-hidden="true">&ndash;</span>
                <label class="lm-range__field">
                  <span>Max {{ cart.currency.symbol }}</span>
                  <input type="number" inputmode="numeric" step="1" min="0" max="{{ price_ceil }}"
                         name="{{ price_filter.max_value.param_name }}" value="{{ price_max }}" data-range-max>
                </label>
              </div>
              <div class="lm-range__track" aria-hidden="true"><div class="lm-range__fill" data-range-fill></div></div>
            </div>
          </div>
        {%- endif -%}

        {%- if clarity_filter -%}
          {%- render 'diamond-grade-scale',
              filter: clarity_filter,
              order: clarity_order,
              title: 'Clarity',
              tip: 'Clarity grades the inclusions inside the stone. From SI2 up, most are invisible without magnification; FL is flawless under 10x.' -%}
        {%- endif -%}

        {%- if color_filter -%}
          {%- render 'diamond-grade-scale',
              filter: color_filter,
              order: color_order,
              title: 'Colour',
              tip: 'Colour runs D (completely colourless) down through the alphabet. Warmth becomes noticeable around J and below, and reads differently in white versus yellow gold.' -%}
        {%- endif -%}

        {%- if cut_filter -%}
          {%- render 'diamond-grade-scale',
              filter: cut_filter,
              order: cut_order,
              title: 'Cut',
              tip: 'Cut is the one grade that is craftsmanship rather than nature — it governs how much light the stone returns. It is the grade worth paying up for.' -%}
        {%- endif -%}

      </div>

      <div class="lm-dfilter__actions">
        <button type="submit" class="lm-dfilter__apply">
          View Diamonds
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
        <a href="{{ collection.url }}" class="lm-dfilter__reset">Reset all</a>
      </div>
    </form>

{%- elsif request.design_mode -%}
    <div class="lm-dfilter__setup">
      <p><strong>Diamond filter — not yet configured.</strong></p>
      <p>
        This collection has no published filters to drive the controls. In the Shopify admin open
        <em>Search &amp; Discovery → Filters</em> and add product-metafield filters for
        <code>custom.diamond_shape</code>, <code>custom.carat_weight</code> (as a range),
        <code>custom.color</code>, <code>custom.clarity</code> and <code>custom.cut</code>,
        plus the built-in <em>Price</em> filter. The panel appears once they're live.
      </p>
      <p>This notice is only visible in the theme editor. The diamonds below are unaffected.</p>
    </div>
{%- endif -%}

    <!-- Results -->
    <div class="lm-dfilter__toolbar">
      <span class="lm-dfilter__count" role="status">
        {%- if paginate.pages > 1 -%}
          Showing {{ paginate.current_offset | plus: 1 }}&ndash;{{ paginate.current_offset | plus: collection.products.size }} of {{ collection.products_count }} diamonds
        {%- else -%}
          Showing {{ collection.products_count }} {{ collection.products_count | pluralize: 'diamond', 'diamonds' }}
        {%- endif -%}
      </span>

      <div class="lm-dfilter__sort">
        <label for="lm-diamond-sort">Sort by</label>
        <select id="lm-diamond-sort">
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          {%- assign sort_pairs = 'manual::Featured||price-ascending::Price: Low to High||price-descending::Price: High to Low||created-descending::Newest First||title-ascending::Alphabetically, A–Z' | split: '||' -%}
          {%- for pair in sort_pairs -%}
            {%- assign sort_parts = pair | split: '::' -%}
            <option value="{{ sort_parts[0] }}" {% if current_sort == sort_parts[0] %}selected{% endif %}>{{ sort_parts[1] }}</option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="products-grid lm-dfilter__results">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product, show_reserve: true -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="lm-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="lm-pagination__arrow" aria-label="Previous page">&larr;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="lm-pagination__page">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="lm-pagination__page lm-pagination__page--current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="lm-pagination__ellipsis">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="lm-pagination__arrow" aria-label="Next page">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- else -%}
      <div class="lm-dfilter__empty">
        <p class="lm-dfilter__empty-title">No diamonds match these criteria</p>
        <p class="lm-dfilter__empty-text">
          Try widening the carat or price range, or relaxing a grade by one step. If you have
          something specific in mind, we can source it.
        </p>
        <a href="{{ collection.url }}" class="lm-dfilter__apply">Reset Filters</a>
      </div>
    {%- endif -%}

    {%- render 'diamond-reserve-form' -%}
  </div>
</section>

{%- endpaginate -%}

{%- endif -%}

{{ 'diamond-filter.css' | asset_url | stylesheet_tag }}

<script>
  (function () {
    /* Facet-mode helpers only. API mode uses diamond-storefront.js. */
    if (document.getElementById('lm-diamond-api')) return;

    /* Sort has to preserve the active facets, so rebuild the query rather
       than navigating to a bare ?sort_by. */
    var sortSelect = document.getElementById('lm-diamond-sort');
    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        var params = new URLSearchParams(window.location.search);
        params.set('sort_by', sortSelect.value);
        params.delete('page');
        window.location.href = window.location.pathname + '?' + params.toString();
      });
    }

    var form = document.getElementById('DiamondFilterForm');
    if (!form) return;

    /* Grade scales: each grade toggles on its own, so a shopper can pick just
       G, or G and H, without the grades around it being ticked for them. */
    form.querySelectorAll('[data-scale]').forEach(function (scale) {
      var stops = Array.prototype.slice.call(scale.querySelectorAll('[data-grade]'));
      if (!stops.length) return;
      var fill = scale.querySelector('[data-scale-fill]');
      var hint = scale.parentNode.querySelector('[data-scale-hint]');
      var noun = hint ? hint.textContent : '';

      function paint() {
        var picked = [];
        stops.forEach(function (stop) {
          var on = stop.querySelector('input').checked;
          stop.classList.toggle('is-in-range', on);
          stop.classList.toggle('is-floor', on);
          if (on) picked.push(stop.dataset.grade);
        });
        if (fill) {
          fill.style.left = '0%';
          fill.style.right = '100%';
        }
        if (hint) {
          hint.textContent = picked.length ? picked.join(', ') : noun;
        }
      }

      stops.forEach(function (stop) {
        stop.addEventListener('click', function (event) {
          event.preventDefault();
          var input = stop.querySelector('input');
          input.checked = !input.checked;
          paint();
        });
      });

      paint();
    });

    /* Shape tiles are plain checkboxes; keep the active class in step. */
    form.querySelectorAll('.lm-shape input').forEach(function (input) {
      input.addEventListener('change', function () {
        input.closest('.lm-shape').classList.toggle('is-active', input.checked);
      });
    });

    /* A carat band toggles every per-weight checkbox it covers. */
    form.querySelectorAll('[data-band]').forEach(function (band) {
      band.addEventListener('click', function () {
        var on = !band.classList.contains('is-active');
        band.classList.toggle('is-active', on);
        band.querySelectorAll('input[type="checkbox"]').forEach(function (input) {
          input.checked = on;
        });
      });
    });

    /* Paint the range track from the current min/max. */
    form.querySelectorAll('[data-range]').forEach(function (range) {
      var floor = parseFloat(range.dataset.floor) || 0;
      var ceil = parseFloat(range.dataset.ceil) || 0;
      var minInput = range.querySelector('[data-range-min]');
      var maxInput = range.querySelector('[data-range-max]');
      var fill = range.querySelector('[data-range-fill]');
      if (!fill || ceil <= floor) return;

      function paint() {
        var lo = parseFloat(minInput.value);
        var hi = parseFloat(maxInput.value);
        if (isNaN(lo)) lo = floor;
        if (isNaN(hi)) hi = ceil;
        var left = Math.max(0, Math.min(100, ((lo - floor) / (ceil - floor)) * 100));
        var right = Math.max(0, Math.min(100, ((hi - floor) / (ceil - floor)) * 100));
        fill.style.left = Math.min(left, right) + '%';
        fill.style.right = (100 - Math.max(left, right)) + '%';
      }

      minInput.addEventListener('input', paint);
      maxInput.addEventListener('input', paint);
      paint();
    });

    /* An empty or full-range input would otherwise land in the URL as noise. */
    form.addEventListener('submit', function () {
      form.querySelectorAll('input[type="number"]').forEach(function (input) {
        if (input.value === '') input.disabled = true;
      });
    });
  })();
</script>

