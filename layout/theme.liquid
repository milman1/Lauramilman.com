<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1E1109">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if request.page_type == 'collection' and collection.products_count == 0 -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- liquid
      assign seo_page_title = page_title | replace: 'Jacob & Company', 'Jacob & Co.' | replace: 'Jacob and Company', 'Jacob & Co.'
      assign seo_meta_description = page_description
      assign seo_social_title = page_title
      if request.page_type == 'index'
        assign seo_page_title = 'Lab-Grown & Estate Jewelry | Laura Milman New York'
        assign seo_social_title = seo_page_title
        assign seo_meta_description = 'Lab-grown jewelry for work and dinner, plus authenticated David Webb, Cartier, Van Cleef, and Tiffany. Free insured shipping. 7-day jewelry returns.'
      elsif request.page_type == 'collection' and seo_meta_description == blank
        capture seo_meta_description
          echo 'Explore '
          echo collection.title
          echo ' from Laura Milman New York, selected with over 30 years of Diamond District expertise. Authenticity guaranteed and insured shipping.'
        endcapture
      elsif request.page_type == 'article' and seo_meta_description.size > 180
        assign seo_meta_description = article.excerpt_or_content | strip_html | strip | truncatewords: 24, ''
      elsif request.page_type == 'blog' and seo_meta_description == blank
        assign seo_meta_description = 'Read expert jewelry, diamond, watch, styling, and estate-buying guidance from Laura Milman New York.'
      elsif page.handle == 'google-reviews'
        assign seo_meta_description = 'Client reviews of Laura Milman New York, published on Google and shown here unedited.'
      elsif page.handle == 'about' and seo_meta_description == blank
        assign seo_meta_description = 'Laura Milman on thirty years in the New York Diamond District, house jewelry, and authenticated pre-owned pieces.'
      elsif page.handle == 'shop' and seo_meta_description == blank
        assign seo_meta_description = 'Shop lab-grown jewelry for work and dinner, plus authenticated David Webb, Cartier, Van Cleef, and Tiffany.'
      elsif page.handle == 'authentication'
        assign seo_meta_description = 'Every pre-owned David Webb, Cartier, Van Cleef & Arpels, Bvlgari, and Tiffany & Co. piece is examined, verified, and documented before listing.'
      elsif request.page_type == 'page' and seo_meta_description == blank
        capture seo_meta_description
          echo 'Learn about '
          echo page_title
          echo ' at Laura Milman New York, backed by over 30 years of New York Diamond District expertise.'
        endcapture
      endif
      if request.page_type == 'collection'
        case collection.handle
          when 'peaceful-diamonds-by-laura-milman-new-york'
            assign seo_page_title = 'Lab-Grown Jewelry | Laura Milman'
            assign seo_social_title = seo_page_title
            assign seo_meta_description = 'Lab-grown diamond jewelry by Laura Milman New York. Certified studs, tennis bracelets, and pendants for the week you work.'
          when 'david-webb'
            assign seo_page_title = 'Pre-Owned David Webb Jewelry | Laura Milman'
            assign seo_social_title = seo_page_title
          when 'cartier'
            assign seo_page_title = 'Pre-Owned Cartier Jewelry | Laura Milman'
            assign seo_social_title = seo_page_title
          when 'van-cleef-arpels'
            assign seo_page_title = 'Pre-Owned Van Cleef & Arpels | Laura Milman'
            assign seo_social_title = seo_page_title
          when 'tiffany'
            assign seo_page_title = 'Pre-Owned Tiffany Jewelry | Laura Milman'
            assign seo_social_title = seo_page_title
          when 'rolex-watches'
            assign seo_page_title = 'Pre-Owned Rolex Watches | Laura Milman'
            assign seo_social_title = seo_page_title
          when 'lab-grown-bracelets'
            assign seo_page_title = 'Lab-Grown Diamond Bracelets | Laura Milman'
            assign seo_social_title = seo_page_title
            assign seo_meta_description = 'Lab-grown diamond tennis, station, and bangle bracelets in 14K and 18K gold by Laura Milman New York.'
          when 'natural-diamonds'
            assign seo_meta_description = 'Laboratory-graded natural diamonds, filtered by shape, carat, color, clarity, and cut.'
          when 'lab-grown-diamonds'
            assign seo_meta_description = 'Lab-grown diamonds filtered by shape, carat, color, clarity, and cut, priced per stone.'
          when 'vintage-jewelry'
            assign seo_meta_description = 'Signed pre-owned jewelry from David Webb, Cartier, Van Cleef & Arpels, Bvlgari, and Tiffany, authenticated by Laura Milman New York.'
          when 'rings'
            assign seo_meta_description = 'Rings in natural diamonds, lab-grown diamonds, and signed estate pieces from Laura Milman New York.'
          when 'hermes'
            assign seo_meta_description = 'Pre-owned Hermès jewelry authenticated and hand-inspected by Laura Milman New York.'
          when 'engagement-rings'
            assign seo_meta_description = 'Engagement rings in natural and lab-grown diamonds. Compare shape and metal, or use the ring builder.'
          when 'jacob-co'
            assign seo_meta_description = 'Jacob & Co. watches listed with the reference. Unworn pieces are marked when the source confirms it.'
        endcase
      endif
      assign suppress_shop_suffix = false
      if seo_page_title contains shop.name or seo_page_title contains 'Laura Milman' or seo_page_title contains '|'
        assign suppress_shop_suffix = true
      endif
    -%}

    <title>
      {{ seo_page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless suppress_shop_suffix %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if seo_meta_description %}
      <meta name="description" content="{{ seo_meta_description | escape }}">
    {% endif %}

    {% render 'meta-tags', meta_title: seo_social_title, meta_description: seo_meta_description %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet"></noscript>

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
    <script>
      /* Inbox "featured products" with an empty picker falls back to popular
         catalog cards (Jacob watches on a wedding-band PDP). Force it off. */
      (function () {
        var el = document.getElementById('shopify-chat-app-embed-data');
        if (!el) return;
        try {
          var data = JSON.parse(el.textContent);
          if (!data || !data.settings) return;
          data.settings.showFeaturedProducts = false;
          data.settings.featuredProducts = [];
          el.textContent = JSON.stringify(data);
        } catch (err) {}
      })();
    </script>

    {% style %}
      :root {
        --espresso: {{ settings.color_espresso | default: '#1E1109' }};
        --wine: {{ settings.color_wine | default: '#4A1428' }};
        --off-white: {{ settings.color_off_white | default: '#F5F0E8' }};
        --warm-white: {{ settings.color_warm_white | default: '#FDFAF6' }};
        --cream: {{ settings.color_cream | default: '#FAF6F0' }};
        --gold: {{ settings.color_gold | default: '#C9A050' }};
        --gold-light: {{ settings.color_gold_light | default: '#E2C27A' }};
        --gold-pale: {{ settings.color_gold_pale | default: '#F0DFB0' }};
        --text-dark: {{ settings.color_text_dark | default: '#2C1810' }};
        --text-wine: {{ settings.color_text_wine | default: '#4A2018' }};
        --text-muted: {{ settings.color_text_muted | default: '#8A8070' }};
        --rule-light: {{ settings.color_rule | default: '#DDD5C5' }};
        --navy: {{ settings.color_navy | default: '#1A1F3A' }};
        --navy-deep: {{ settings.color_navy_deep | default: '#12162B' }};
        --pd-blue: {{ settings.color_pd_blue | default: '#5B7FBD' }};
        --pd-ice: {{ settings.color_pd_ice | default: '#A9BEE3' }};
      }
    {% endstyle %}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": "Laura Milman New York",
      "url": "{{ shop.url }}",
      {%- if settings.favicon != blank -%}
      "logo": {{ settings.favicon | image_url: width: 512 | prepend: 'https:' | json }},
      {%- endif -%}
      "description": "Lab-grown diamond jewelry to wear from the office through dinner, and authenticated pre-owned jewelry and watches from the great houses.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "New York",
        "addressRegion": "NY",
        "addressCountry": "US"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "hello@lauramilman.com"
      },
      "sameAs": [
        {%- assign social_urls = settings.social_instagram | append: '|' | append: settings.social_facebook | append: '|' | append: settings.social_pinterest | split: '|' -%}
        {%- assign social_written = false -%}
        {%- for social_url in social_urls -%}
          {%- if social_url != blank -%}
            {%- if social_written -%},{%- endif -%}
            {{ social_url | json }}
            {%- assign social_written = true -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "publisher": {
        "@id": "{{ shop.url }}/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    {% section 'header' %}
    {% section 'popular-searches' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {%- unless request.page_type == 'index' or request.page_type == 'product' -%}
        {% render 'breadcrumbs' %}
      {%- endunless -%}
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {%- render 'welcome-popup' -%}

    <div id="cart-notification" class="cart-notification" aria-live="polite" aria-atomic="true" hidden>
      <p class="cart-notification__text">Added to cart</p>
      <a class="cart-notification__checkout" href="{{ routes.cart_url }}">View cart</a>
      <a class="cart-notification__checkout cart-notification__checkout--primary" href="/checkout">Checkout</a>
    </div>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      }

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
      }
    </script>

    {{ 'theme.js' | asset_url | script_tag }}
    <script>
      /* The Google reviews widget injects its own business schema, including a
         wrong name and an aggregate rating the store does not author. Drop
         only that markup. Visible reviews stay. */
      (function () {
        function unwanted(node) {
          if (!node || node.nodeType !== 1 || node.tagName !== 'SCRIPT') return false;
          if ((node.getAttribute('type') || '') !== 'application/ld+json') return false;
          var text = node.textContent || '';
          return text.indexOf('AggregateRating') !== -1 || text.indexOf("Laura's Gems") !== -1 || text.indexOf('Laura’s Gems') !== -1;
        }
        function sweep(root) {
          var scope = root && root.querySelectorAll ? root : document;
          var nodes = scope.querySelectorAll('script[type="application/ld+json"]');
          for (var i = 0; i < nodes.length; i++) {
            if (unwanted(nodes[i])) nodes[i].remove();
          }
        }
        sweep(document);
        if (!window.MutationObserver) return;
        new MutationObserver(function (records) {
          records.forEach(function (record) {
            Array.prototype.forEach.call(record.addedNodes || [], function (node) {
              if (unwanted(node)) node.remove();
              else sweep(node);
            });
          });
        }).observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
